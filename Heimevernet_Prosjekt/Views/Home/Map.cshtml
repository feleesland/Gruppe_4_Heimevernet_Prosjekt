		// "Lever tilbake": lent out to a need that is closed. Kept out of the boxes, so they are never hidden (help with AI)
		var returnLayer = L.layerGroup().addTo(map);
		function layerFor(marker) { return marker.resource && marker.resource.status === 'Lever tilbake' ? returnLayer : markerLayer; }
