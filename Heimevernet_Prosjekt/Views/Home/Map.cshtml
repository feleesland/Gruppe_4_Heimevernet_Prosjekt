		// The pins on the map (help with AI): the type's own icon (the same as in "Ny ressurs") in a pin.
		// Green = ledig now, grey = everything else (I bruk, Ledig senere ...). The status is in the tooltip too, so it isn't colour alone.
		// "Lever tilbake" also gets a purple ring, a ↩ badge and a name tag - Docs: Leaflet DivIcon - https://leafletjs.com/reference.html#divicon
		function resourcePin(resource) {
			var free = (resource.status || 'Ledig') === 'Ledig';
			var returning = resource.status === 'Lever tilbake';
			var icon = (resource.icon || 'map-pin').replace(/^ti-/, '').replace(/[^a-z0-9-]/g, '');
			return L.divIcon({
				className: 'resource-pin' + (free ? '' : ' resource-pin-busy') + (returning ? ' resource-pin-return' : ''),
				html: '<svg viewBox="0 0 36 46" width="36" height="46" aria-hidden="true"><path d="M18 45 C6 30 2 24 2 17 A16 16 0 0 1 34 17 C34 24 30 30 18 45Z"/></svg><i class="ti ti-' + icon + '" aria-hidden="true"></i>'
					+ (returning ? '<span class="return-badge" aria-hidden="true">↩</span><span class="return-tag">Lever tilbake</span>' : ''),
				iconSize: [36, 46],
				iconAnchor: [18, 45],
				popupAnchor: [0, -40]
			});
		}
		// Initialize the map and set its view to a specific location and zoom level
		var map = L.map('map').setView([58.14671, 7.9956], 13); // Coordinates for Kristiansand. 13 stands for zoom level.

		// The map pictures come from wwwroot/js/map-style.js (Kartverket or OpenStreetMap, chosen in the account menu)
		addMapPictures(map);

		// Exact height: the window minus the menu, also when the window changes size (help with AI)
		// Docs: Leaflet invalidateSize - https://leafletjs.com/reference.html#map-invalidatesize
		function fitMapToScreen() {
			var headerHeight = document.querySelector('header').offsetHeight;
			document.getElementById('map').style.height = (window.innerHeight - headerHeight) + 'px';
