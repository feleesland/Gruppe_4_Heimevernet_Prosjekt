		//     popupAnchor: [1, -34]
		// });

		function getPermanentIcon(iconType) {
			return L.icon({
				iconUrl: `/images/permanent-map-icons/${iconType}.png`,
				iconSize: [40, 40],
				iconAnchor: [20, 40],
				popupAnchor: [0, -40]
			});
		}


		// 		function getDefaultMarker(status) {

		// 			switch (status) {

		//         case "Opptatt":
		//             return greyIcon;

		// 				case "Ugyldig":
		// 					return redIcon;

		// 				default:
		// 					return greenIcon;
		// 			}
		// 		}

		// 		function getResourceIcon(type, status) {

		// 			//bilder legges inn i wwwroot/images/resource-icons/ med navn som "tools-ledig.png", "vehicle-opptatt.png" osv. altså (type-status.png)
		// 			var typeMap = {
		// 				"Verktøy og utstyr": "tools",
		// 				"Motoriserte kjøretøy": "vehicle",
		// 				"Husly og bygg": "shelter",
		// 				// "Materialer og forsyninger": "supplies",		//Har ikke ikon enda så bruker default for nå
		// 				"Sikkerhet og medisinsk": "medical"
		// 			};
		// 			// "Ikke tilgjengelig" (e.g. at the workshop): always a grey marker, whatever the type
		// 			if (status === "Ikke tilgjengelig") {
		// 				return greyIcon;
		// 			}

		// 			var iconType = typeMap[type];

		// 			if (!iconType) {
		// 				return getDefaultMarker(status);
		// 			}

		// 			var iconStatus = (status || "Ledig")
		// 				.toLowerCase()
		// 				.replace("ø", "o");

		// 			return L.icon({
		// 				iconUrl: `/images/resource-icons/${iconType}-${iconStatus}.png`,
		// 				iconSize: [36, 36],
		// 				iconAnchor: [18, 36],
		// 				popupAnchor: [0, -36]
		// 			});
		// 		}

		// The pins on the map (help with AI): the type's own icon (the same as in "Ny ressurs") in a pin.
		// Green = ledig now, grey = everything else (I bruk, Ledig senere ...). The status is in the tooltip too, so it isn't colour alone.
		// "Lever tilbake" also gets a purple ring, a ↩︎ badge and a name tag - Docs: Leaflet DivIcon - https://leafletjs.com/reference.html#divicon
		function resourcePin(resource) {
			var free = (resource.status || 'Ledig') === 'Ledig';
			var returning = resource.status === 'Lever tilbake';
			var icon = (resource.icon || 'map-pin').replace(/^ti-/, '').replace(/[^a-z0-9-]/g, '');
			return L.divIcon({
				className: 'resource-pin' + (free ? '' : ' resource-pin-busy') + (returning ? ' resource-pin-return' : ''),
				html: '<svg viewBox="0 0 36 46" width="36" height="46" aria-hidden="true"><path d="M18 45 C6 30 2 24 2 17 A16 16 0 0 1 34 17 C34 24 30 30 18 45Z"/></svg><i class="ti ti-' + icon + '" aria-hidden="true"></i>'
					+ (returning ? '<span class="return-badge" aria-hidden="true">↩︎</span><span class="return-tag">Lever tilbake</span>' : ''),
				iconSize: [36, 46],
				iconAnchor: [18, 45],
				popupAnchor: [0, -40]
			});
		}
		// Initialize the map and set its view to a specific location and zoom level
		var map = L.map('map').setView([58.14671, 7.9956], 13); // Coordinates for Kristiansand. 13 stands for zoom level.

		// The map pictures come from wwwroot/js/map-style.js (Kartverket or OpenStreetMap, chosen in the account menu)
		addMapPictures(map);

		// Exact height: the window minus the menu, also when the window changes size (help with AI)
		// Docs: Leaflet invalidateSize - https://leafletjs.com/reference.html#map-invalidatesize
		function fitMapToScreen() {
			var headerHeight = document.querySelector('header').offsetHeight;
			document.getElementById('map').style.height = (window.innerHeight - headerHeight) + 'px';
			map.invalidateSize();
		}
		window.addEventListener('resize', fitMapToScreen);
		fitMapToScreen();

		// Markers are kept in one layer so they can be removed before a new search; the circle shows the radius - Docs: Leaflet API reference (LayerGroup, Circle)
		// https://leafletjs.com/reference.html
		// Markers close together become a box with the number. Click the box: a list of what is in it (help with AI)
		var markerLayer = L.markerClusterGroup({
			zoomToBoundsOnClick: false,
			showCoverageOnHover: false,
			disableClusteringAtZoom: 16,
			iconCreateFunction: function (cluster) {
				var n = cluster.getChildCount();
				return L.divIcon({
					html: `<div class="resource-cluster" aria-label="${n} ressurser">${n}</div>`,
					className: '',
					iconSize: [44, 44]
				});
			}
		}).addTo(map);
		var permanentMarkerLayer = L.layerGroup().addTo(map);


		var markersById = {};
		// "Lever tilbake": lent out to a need that is closed. Kept out of the boxes, so they are never hidden (help with AI)
		var returnLayer = L.layerGroup().addTo(map);
		function layerFor(marker) { return marker.resource && marker.resource.status === 'Lever tilbake' ? returnLayer : markerLayer; }
		var radiusCircle = null;
		var detailUrl = '@Url.Content("~/Resource/Index/")';

		

		// Text from users is escaped before it goes into the popup, so HTML in a name can't run as code (XSS)
		function escapeHtml(text) {
			var div = document.createElement('div');
			div.textContent = text || '';
			return div.innerHTML;
		}

		function loadPermanentMarkers() {

			fetch('@Url.Action("PermanentMapMarker", "Home")')
				.then(response => {
					if (!response.ok) {
						throw new Error("Kunne ikke hente installasjoner");
					}

					return response.json();
				})
				.then(locations => {

					permanentMarkerLayer.clearLayers();

					locations.forEach(function (location) {

						var lat = Number(location.latitude);
						var lng = Number(location.longitude);

						if (!Number.isFinite(lat) ||
							!Number.isFinite(lng) ||
							lat < -90 || lat > 90 ||
							lng < -180 || lng > 180) {
							return;
						}

						var marker = L.marker([lat, lng], {
							icon: blueIcon
						});

						marker.bindPopup(`
									<strong>${escapeHtml(location.name)}</strong><br>
									Type: ${escapeHtml(location.type)}<br>
									${escapeHtml(location.description || '')}
								`);

						permanentMarkerLayer.addLayer(marker);
					});
				})
				.catch(error => {
					console.error(
						"Feil ved henting av faste installasjoner:",
						error
					);
				});
		}


		//Ressurser hentes fra databasen og legges til på kartet som markører.
		// params can contain search, type, lat, lng and radius (sent to MapResources in ResourceController)
		function loadResources(params) {
			return fetch('@Url.Action("MapResources", "Resource")' + '?' + new URLSearchParams(params))
				.then(response => response.json())
				.then(resources => {

					console.log("Ressurser hentet:", resources);
					markerLayer.clearLayers();
					returnLayer.clearLayers();
					markersById = {};
					var markers = [];
					// The filter: type and status are chosen here; search and distance are done by the server
					if (window.ResourceFilter) ResourceFilter.render(resources, params);
					resources = resources.filter(function (r) { return !window.ResourceFilter || ResourceFilter.matches(r, params); });
					lastHits = resources; // for "Liste" in the side panel
					renderHits(params);

					for (const resource of resources) {

						var lat = parseFloat(resource.latitude);
						var lng = parseFloat(resource.longitude);

						// Kontroller at koordinatene er gyldige
						if (isNaN(lat) || isNaN(lng)) {
							console.warn("Ugyldige koordinater:", resource);
							continue;
						}

						// var icon = getResourceIcon(
						// 	resource.type,
						// 	resource.status
						// );
						var icon = resourcePin(resource);

						var marker = L.marker([lat, lng], { icon: icon }).addTo(resource.status === 'Lever tilbake' ? returnLayer : markerLayer);

						// Hover: the name and the status ("Ledig fra 16:00", "I bruk: Flom Vennesla"). Click: the resource in the panel on the left
						var statusText = resource.freeFrom || (resource.usedByNeedName ? resource.status + ': ' + resource.usedByNeedName : resource.status || 'Ledig');
						marker.bindTooltip('<strong>' + escapeHtml(resource.name) + '</strong><br>' + escapeHtml(statusText), { direction: 'top', offset: [0, -40] });
						marker.on('click', function () { openResource(resource.id); });
						markers.push(marker);
						markersById[resource.id] = marker;
						marker.resource = resource;
					}
					updateReturnChip();
					if (needMode) showNeedMode();
					return markers;
				})
				.catch(error => {
					console.error("Feil ved henting av ressurser:", error);
					return [];
				});
		}

		var canNeeds = @(canNeeds ? "true" : "false");
		var needLayer = L.layerGroup();
		var needDetailUrl = '@Url.Content("~/ResourceNeed/Index/")';
		var needCreateUrl = '@Url.Action("Create", "ResourceNeedHandler")';

		function shortDate(utc) {
			if (!utc) return '';
			var date = new Date(utc.endsWith('Z') ? utc : utc + 'Z');
			return date.toLocaleDateString('nb-NO', { day: '2-digit', month: '2-digit', timeZone: 'Europe/Oslo' });
		}

		function loadNeeds() {
			if (!canNeeds) return Promise.resolve();
			return fetch('@Url.Action("MapResourceNeeds", "ResourceNeed")')
				.then(response => response.ok ? response.json() : [])
				.then(needs => {
					needLayer.clearLayers();
					if (document.getElementById('rfNeedsCount')) document.getElementById('rfNeedsCount').textContent = needs.length;
					needs.forEach(need => {
						var lat = parseFloat(need.latitude);
						var lng = parseFloat(need.longitude);
						if (isNaN(lat) || isNaN(lng)) return;

						var planned = need.urgency === 'Planlagt';
						var colour = planned ? '#E69500' : '#E24B4A';
						var label = planned ? 'Planlagt ' + shortDate(need.neededFrom) : 'AKUTT';

						// The circle; bubblingMouseEvents: false so a click on it doesn't open the click menu as well
						L.circle([lat, lng], {
							radius: need.radiusKm * 1000,
							color: colour,
							weight: planned ? 3.5 : 3,
							dashArray: planned ? '4 6' : '8 6',
							fillOpacity: planned ? 0.12 : 0.08,
							bubblingMouseEvents: false
						}).addTo(needLayer);

						// Name and AKUTT/Planlagt as text above the square - Docs: Leaflet DivIcon
						L.marker([lat, lng], {
							icon: L.divIcon({
								className: 'need-label ' + (planned ? 'planlagt' : 'akutt'),
								html: '<span style="display:inline-block;transform:translateX(-50%);background:rgba(255,255,255,.85);padding:0 4px;border-radius:4px;">'
									+ escapeHtml(need.name) + ' · ' + escapeHtml(label) + '</span>',
								iconSize: null,
								iconAnchor: [0, 38]
							}),
							interactive: false
						}).addTo(needLayer);

						// Hover: the name and what is needed. Click: the need opens in the side panel, like a resource
						var items = need.items.map(i => `${i.quantity} × ${escapeHtml(i.type)}`).join('<br>');
						L.marker([lat, lng], {
							icon: L.divIcon({
								className: '',
								html: `<div class="need-marker ${planned ? 'need-planlagt' : 'need-akutt'}" aria-label="${escapeHtml(need.name)}: ${need.count} trengs">${need.count}</div>`,
								iconSize: [26, 26],
								iconAnchor: [13, 13]
							}),
							keyboard: true
						})
							.bindTooltip(`<strong>${escapeHtml(need.name)}</strong> · ${escapeHtml(label)}<br>${items}`, { direction: 'top', offset: [0, -14] })
							.on('click', function () { openNeedPanel(needDetailUrl + need.id, [lat, lng]); })
							.addTo(needLayer);
					});
				})
				.catch(error => console.error("Feil ved henting av behov:", error));
		}

		// Kriser for guests and users who don't see the needs: only needs with "Info til innbyggere",
		// with the same info as on the front page. A click opens a small card (help with AI)
		// Docs: Leaflet Popup - https://leafletjs.com/reference.html#popup
		function osloTime(utc) {
			var date = new Date(utc.endsWith('Z') ? utc : utc + 'Z');
			var day = date.toLocaleDateString('nb-NO', { timeZone: 'Europe/Oslo' });
			var time = date.toLocaleTimeString('nb-NO', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Oslo' });
			return day === new Date().toLocaleDateString('nb-NO', { timeZone: 'Europe/Oslo' }) ? time : shortDate(utc) + ' ' + time;
		}

		function loadPublicCrises() {
			return fetch('@Url.Action("PublicCrises", "Home")')
				.then(response => response.ok ? response.json() : [])
				.then(crises => {
					needLayer.clearLayers();
					needLayer.addTo(map);
					crises.forEach(crisis => {
						var lat = parseFloat(crisis.latitude);
						var lng = parseFloat(crisis.longitude);
						if (isNaN(lat) || isNaN(lng)) return;
						var planned = crisis.urgency === 'Planlagt';
						var icon = planned ? 'ti-calendar' : 'ti-alarm';
						var when = planned ? 'Planlagt ' + shortDate(crisis.neededFrom) : 'Akutt · siden ' + osloTime(crisis.createdAt);
						var place = (crisis.place || '').toLowerCase().replace(/(^|[\s-])\p{L}/gu, function (c) { return c.toUpperCase(); });

						var card = '<div class="crisis-pop">'
							+ '<div class="crisis-pop-head ' + (planned ? 'is-planned' : 'is-acute') + '"><i class="ti ' + icon + '" aria-hidden="true"></i> ' + escapeHtml(when) + '</div>'
							+ '<strong class="crisis-pop-name">' + escapeHtml(crisis.name) + '</strong>'
							+ '<div class="crisis-pop-meta">' + (place ? '<i class="ti ti-map-pin" aria-hidden="true"></i> ' + escapeHtml(place) + ' · ' : '')
							+ 'Oppdatert ' + escapeHtml(osloTime(crisis.latestAt)) + '</div>'
							+ '<div><i class="ti ti-info-circle" aria-hidden="true"></i> ' + escapeHtml(crisis.latestText) + '</div>'
							+ '</div>';

						// Bigger and clearer than the operators' markers, with the name always shown under it (no circle for guests)
						L.marker([lat, lng], {
							icon: L.divIcon({
								className: '',
								html: `<div class="crisis-marker ${planned ? 'is-planned' : 'is-acute'}" aria-label="${escapeHtml(crisis.name)}"><i class="ti ${icon}" aria-hidden="true"></i></div>`,
								iconSize: [40, 40],
								iconAnchor: [20, 20]
							}),
							keyboard: true
						})
							.bindTooltip(escapeHtml(crisis.name), { permanent: true, direction: 'bottom', offset: [0, 18], className: 'crisis-name-tag' })
							.bindPopup(card, { maxWidth: 280 })
							.addTo(needLayer);
					});
				})
				.catch(error => console.error("Feil ved henting av kriser:", error));
		}

		// Offentlige aktører (police, fire station, hospital) from the group's PermanentMapMarkers - shown to everyone, also guests.
		// Blue in the case = public actor; the group's own icons are used (getPermanentIcon) (help with AI)
		var actorLayer = L.layerGroup().addTo(map);
		function loadActors() {
			return fetch('@Url.Action("PermanentMapMarkers", "Home")')
				.then(response => response.ok ? response.json() : [])
				.then(actors => {
					actorLayer.clearLayers();
					document.getElementById('rfActorsCount').textContent = actors.length;
					actors.forEach(actor => {
						L.marker([actor.latitude, actor.longitude], { icon: getPermanentIcon(actor.iconType) })
							.bindTooltip('<strong>' + escapeHtml(actor.name) + '</strong><br>' + escapeHtml(actor.type), { direction: 'top', offset: [0, -38] })
							.bindPopup('<strong>' + escapeHtml(actor.name) + '</strong><br>' + escapeHtml(actor.description || actor.type))
							.addTo(actorLayer);
					});
				})
				.catch(error => console.error("Feil ved henting av offentlige aktører:", error));
		}
		loadActors();

		if (canNeeds) {
			loadNeeds();
		} else {
			loadPublicCrises(); // guests and users: only crises with "Info til innbyggere"
		}

		

		window.onResourceSearch = async function (params) {
			var statusText = document.getElementById('globalSearchStatus');
			applyLayerChoices(params);

			// The circle: the chosen place in the middle, with the radius in km
			if (radiusCircle) {
				map.removeLayer(radiusCircle);
				radiusCircle = null;
			}
			if (params.lat && params.lng && params.radius) {
				radiusCircle = L.circle([parseFloat(params.lat), parseFloat(params.lng)], { radius: params.radius * 1000 }).addTo(map);
			}

			var markers = await loadResources(params);
			document.getElementById('rfResourcesCount').textContent = markers.length;
			updateRadiusBar(params, markers.length);

			// Only type/status chosen (no search or place): the map stays where it is, so it doesn't jump on every tick
			if (!params.search && !params.lat) {
				if (statusText) statusText.textContent = '';
				return;
			}

			if (statusText) {
				var found = markers.length === 1 ? '1 ressurs' : markers.length + ' ressurser';
				var radiusText = parseFloat(params.radius) < 1 ? (params.radius * 1000) + ' m' : params.radius + ' km';
				statusText.textContent = params.lat ? found + ' innen ' + radiusText : found + ' funnet';
			}

			// Move the map: to the circle, so all results fit, or to the only result
			if (radiusCircle) {
				map.fitBounds(radiusCircle.getBounds(), mapPadding());
			} else if (markers.length > 1) {
				map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [40, 40] });
			} else if (markers.length === 1) {
				map.setView(markers[0].getLatLng(), 16);
			}
			if (params.search && markers.length === 1) openResource(markers[0].resource.id); // not while you tick in the filter
		};

		window.onResourceSelected = async function (resource) {
			if (resource.latitude == null || resource.longitude == null) {
				window.location.href = detailUrl + resource.id;
				return;
			}
			if (radiusCircle) {
				map.removeLayer(radiusCircle);
				radiusCircle = null;
			}
			updateRadiusBar({}, 0);
			await loadResources({});
			map.setView([resource.latitude, resource.longitude], 16);
			openResource(resource.id);
		};

		// 		function loadPermanentMarkers()
