		// "Velg punkt på kartet" i filter
		var pickingCenter = false;
		window.startPickCenter = function (callback) {
			pickingCenter = true;
			map.getContainer().style.cursor = 'crosshair';
			map.once('click', function (e) {
				map.getContainer().style.cursor = '';
				callback(e.latlng.lat, e.latlng.lng);
				pickingCenter = false;
			});
		};

		// "Ressurser i området" (help with AI): change the distance right on the map - the slider, the number,
		// the quick buttons or the white dot on the edge of the circle. It uses the same radius in the URL as the filter
		// Docs: Leaflet Marker (draggable) - https://leafletjs.com/reference.html#marker
		var radiusQuick = [1, 2, 5, 10]; // 50 km was removed to make room for "Vis liste"; other distances can be typed in
		var radiusHandle = null;
		var radiusBarSmall = false; // true after "Ferdig", until a new point is chosen
		var radiusPointKey = '';

		// The slider goes from 0.1 to 500 km, with most of it for short distances (middle = about 7 km)
		function sliderToKm(value) { return roundKm(0.1 * Math.pow(5000, value / 1000)); }
		function kmToSlider(km) { return Math.round(1000 * Math.log(km / 0.1) / Math.log(5000)); }
		function roundKm(km) { return km < 10 ? Math.round(km * 10) / 10 : Math.round(km); }
		function kmText(km) { return km < 1 ? Math.round(km * 1000) + ' m' : String(km).replace('.', ',') + ' km'; }

		// Use a new radius: the filter, the chips and the circle are updated, and the resources counted again
		function applyRadius(km) {
			var params = window.getResourceParams();
			if (!params.lat) return;
			params.radius = String(Math.min(Math.max(roundKm(km), 0.1), 500));
			window.applyResourceParams(params);
		}

		// While dragging: only the circle and the numbers change; the resources are counted when you let go
		function previewRadius(km, dragging) {
			if (!radiusCircle) return;
			radiusCircle.setRadius(km * 1000);
			showRadiusNumbers(km, dragging);
		}

		function showRadiusNumbers(km, dragging) {
			var slider = document.getElementById('radiusSlider');
			slider.value = kmToSlider(km);
			slider.setAttribute('aria-valuetext', kmText(km));
			document.getElementById('radiusNumber').value = km;
			if (radiusHandle) {
				if (!dragging) radiusHandle.setLatLng(edgePoint(km));
				radiusHandle.setTooltipContent(kmText(km));
			}
			document.querySelectorAll('.radius-chip').forEach(function (chip) {
				var on = parseFloat(chip.dataset.km) === km;
				chip.classList.toggle('active', on);
				chip.setAttribute('aria-pressed', on);
				chip.textContent = (on ? '✓ ' : '') + chip.dataset.km + ' km';
			});
		}

		// The point on the right edge of the circle (1 degree of latitude is about 111.32 km)
		function edgePoint(km) {
			var center = radiusCircle.getLatLng();
			return L.latLng(center.lat, center.lng + km / (111.32 * Math.cos(center.lat * Math.PI / 180)));
		}

		// Called after every search or filter change: show, update or hide the bar, the small button and the dot
		function updateRadiusBar(params, count) {
			var bar = document.getElementById('radiusBar');
			var small = document.getElementById('radiusBarSmall');
			if (radiusHandle) { map.removeLayer(radiusHandle); radiusHandle = null; }
			if (!radiusCircle) {
				bar.hidden = true;
				small.hidden = true;
				radiusPointKey = '';
				return;
			}
			var key = params.lat + ',' + params.lng;
			if (key !== radiusPointKey) radiusBarSmall = false; // a new point: show the whole bar again
			radiusPointKey = key;
			var km = roundKm(parseFloat(params.radius));
			var hits = count === 1 ? '1 treff' : count + ' treff';

			radiusHandle = L.marker(edgePoint(km), {
				draggable: true,
				keyboard: false, // the slider and the number field are the keyboard way
				icon: L.divIcon({ className: '', html: '<div class="radius-handle"></div>', iconSize: [22, 22], iconAnchor: [11, 11] })
			}).bindTooltip(kmText(km), { permanent: true, direction: 'top', offset: [0, -12] }).addTo(map);
			radiusHandle.on('drag', function (e) {
				previewRadius(roundKm(Math.max(map.distance(radiusCircle.getLatLng(), e.target.getLatLng()) / 1000, 0.1)), true);
			});
			radiusHandle.on('dragend', function (e) {
				applyRadius(map.distance(radiusCircle.getLatLng(), e.target.getLatLng()) / 1000);
			});

			document.getElementById('radiusBarCount').textContent = hits;
			small.textContent = '⟷ Innen ' + kmText(km) + ' · ' + hits + ' · Endre';
			bar.hidden = radiusBarSmall;
			small.hidden = !radiusBarSmall;
			showRadiusNumbers(km);
		}

		// The quick buttons and the other controls in the bar (set up once)
		radiusQuick.forEach(function (km) {
			var chip = document.createElement('button');
			chip.type = 'button';
			chip.className = 'radius-chip';
			chip.dataset.km = km;
			chip.textContent = km + ' km';
			chip.addEventListener('click', function () { applyRadius(km); });
			document.getElementById('radiusChips').appendChild(chip);
		});
		document.getElementById('radiusSlider').addEventListener('input', function () { previewRadius(sliderToKm(this.value)); });
		document.getElementById('radiusSlider').addEventListener('change', function () { applyRadius(sliderToKm(this.value)); });
		document.getElementById('radiusNumber').addEventListener('change', function () {
			var km = parseFloat(this.value);
			if (!isNaN(km)) applyRadius(km);
		});
		document.getElementById('radiusRemove').addEventListener('click', function () {
			var params = window.getResourceParams();
			delete params.lat; delete params.lng; delete params.where; delete params.radius;
			window.applyResourceParams(params);
		});
		document.getElementById('radiusDone').addEventListener('click', function () {
			radiusBarSmall = true;
			document.getElementById('radiusBar').hidden = true;
			document.getElementById('radiusBarSmall').hidden = false;
		});
		document.getElementById('radiusBarSmall').addEventListener('click', function () {
			radiusBarSmall = false;
			document.getElementById('radiusBarSmall').hidden = true;
			document.getElementById('radiusBar').hidden = false;
			document.getElementById('radiusSlider').focus();
		});

		var resourceCreateUrl = '@Url.Action("Create", "ResourceHandler")';
		var mapUrl = '@Url.Action("Map", "Home")';
		var signedIn = @(signedIn ? "true" : "false");

		// Click on the map (help with AI): like Google Maps and Apple Kart - the address, three round buttons with text under,
		// and what is near. On PC a popup at the point, on phones a sheet from the bottom. A pin shows the point
		// Docs: Leaflet Popup - https://leafletjs.com/reference.html#popup
		// Docs: Kartverket Adresse-API, punktsok - https://ws.geonorge.no/adresser/v1/#/default/get_punktsok
		var pointPin = null;
		var mapSheet = document.getElementById('mapSheet');

		function roundButton(href, icon, text, css, onclick) {
			return `<a class="point-btn ${css}" href="${href}"${onclick ? ` onclick="${onclick}"` : ''}>`
				+ `<span class="point-icon"><i class="ti ti-${icon}" aria-hidden="true"></i></span>${text}</a>`;
		}

		function closePointMenu() {
			if (pointPin) { map.removeLayer(pointPin); pointPin = null; }
			mapSheet.hidden = true;
		}

		function pointMenu(latlng) {
			var lat = latlng.lat.toFixed(6);
			var lng = latlng.lng.toFixed(6);
			var radius = radiusCircle ? (radiusCircle.getRadius() / 1000) : 2;

			var buttons = '';
			if (canNeeds) {
				buttons += roundButton(`${needCreateUrl}?lat=${lat}&lng=${lng}&radius=${radius}`, 'alert-triangle', 'Meld behov', 'is-need', 'closePointMenu(); return openNeedPanel(this.href);');
			}
			buttons += roundButton(`${resourceCreateUrl}?lat=${lat}&lng=${lng}`, 'plus', 'Ny ressurs', 'is-resource');
			buttons += roundButton(`${mapUrl}?lat=${lat}&lng=${lng}&radius=${radius}`, 'radar', 'I området', 'is-area');

			// What is near: resources on the map within the radius, and active needs whose circle covers the point
			var resources = Object.values(markersById).filter(m => map.distance(m.getLatLng(), latlng) <= radius * 1000).length;
			var needs = 0;
			needLayer.eachLayer(l => { if (l instanceof L.Circle && map.distance(l.getLatLng(), latlng) <= l.getRadius()) needs++; });
			var near = [(resources === 1 ? '1 ressurs' : resources + ' ressurser') + ' innen ' + kmText(radius)];
			if (canNeeds && needs > 0) near.push(needs === 1 ? 'inne i 1 aktivt behov' : `inne i ${needs} aktive behov`);

			var box = document.createElement('div');
			box.className = 'point-menu';
			box.innerHTML = '<div class="point-addr">Henter adresse …</div><div class="point-sub"></div>'
				+ `<div class="point-buttons">${buttons}</div><div class="point-near">${near.join(' · ')}</div>`;

			// The nearest address within 1 km. More than 150 m away: «Nær …», like Google Maps (help with AI)
			fetch(`https://ws.geonorge.no/adresser/v1/punktsok?lat=${lat}&lon=${lng}&radius=1000&treffPerSide=1&utkoordsys=4258`)
				.then(response => response.json())
				.then(result => {
					var a = result.adresser && result.adresser[0];
					var far = a && a.meterDistanseTilPunkt > 150;
					box.querySelector('.point-addr').textContent = a ? (far ? 'Nær ' : '') + a.adressetekst : 'Valgt punkt';
					box.querySelector('.point-sub').textContent = a ? a.postnummer + ' ' + a.poststed + (far ? ' · ' + Math.round(a.meterDistanseTilPunkt) + ' m unna' : '')
						: lat.replace('.', ',') + ', ' + lng.replace('.', ',');
				})
				.catch(() => { box.querySelector('.point-addr').textContent = 'Valgt punkt'; });
			return box;
		}

		map.on('click', function (e) {
			// Not while "Velg punkt på kartet" is choosing the centre of the filter
			if (pickingCenter || placeMode || needPlaceOn || !signedIn) return;

			closePointMenu();
			var pin = L.marker(e.latlng, { interactive: false, keyboard: false }).addTo(map);
			pointPin = pin;
			var menu = pointMenu(e.latlng);

			if (window.innerWidth < 768) {
				document.getElementById('mapSheetBody').replaceChildren(menu);
				mapSheet.hidden = false;
			} else {
				// The pin goes away with its own popup (not a newer one)
				L.popup({ offset: [0, -30], maxWidth: 300 })
					.setLatLng(e.latlng)
					.setContent(menu)
					.on('remove', function () {
						map.removeLayer(pin);
						if (pointPin === pin) pointPin = null;
					})
					.openOn(map);
			}
		});
		document.getElementById('mapSheetClose').addEventListener('click', closePointMenu);

		// ?focus=12 / ?resource=12 (from "Vis på hovedkartet" and Oversikt): zoom to that resource and open it in the panel.
		// ?need=5 (the map button on Oversikt): the need opens in the panel, with its whole circle next to the panel (help with AI)
		// Docs: Leaflet LatLng toBounds - https://leafletjs.com/reference.html#latlng-tobounds
		var startParams = Object.fromEntries(new URLSearchParams(window.location.search));
		var focusId = startParams.focus || startParams.resource;
		var startNeedId = startParams.need;
		delete startParams.focus; delete startParams.resource; delete startParams.need;

		loadPermanentMarkers();

		window.onResourceSearch(startParams).then(function () {
			// "I området" on a phone: the Filter tab opens at Liten, with the whole circle above it
			if (isPhone() && radiusCircle && !focusId && !startNeedId) {
				showView('filter');
				setSheet('small');
				map.fitBounds(radiusCircle.getBounds(), mapPadding());
			}
			if (!focusId) return;
			if (markersById[focusId]) zoomToResource(focusId); else openResource(focusId);
		});

		if (startNeedId && canNeeds) {
			fetch('@Url.Action("MapResourceNeeds", "ResourceNeed")')
				.then(r => r.ok ? r.json() : [])
				.then(function (needs) {
					var need = needs.find(n => String(n.id) === String(startNeedId));
					if (!need) { openNeedPanel(needDetailUrl + startNeedId); return; }
					var center = [parseFloat(need.latitude), parseFloat(need.longitude)];
					openNeedPanel(needDetailUrl + need.id, center);
					map.fitBounds(L.latLng(center).toBounds(need.radiusKm * 2000), mapPadding());
				})
				.catch(function () { openNeedPanel(needDetailUrl + startNeedId); });
		}

		
		// Open a need ("Meld behov" or an existing need) in the side panel (help with AI) - Docs: Window.postMessage (MDN)
		// https://developer.mozilla.org/docs/Web/API/Window/postMessage
		function openNeedPanel(url, latlng) {
			needLatLng = latlng || null; // where the need is, for the lines to the chosen resources
			exitNeedMode();
			needUrl = url;
			needTitle = '';
			hitsOnly = null;
			openResourceId = null;
			document.getElementById('needPanelFrame').src = url + (url.includes('?') ? '&' : '?') + 'embed=1';
			document.getElementById('sidePanelFull').href = url;
			showView('need');
			map.closePopup();
			return false; // don't follow the link, the panel shows the form instead
		}

		// The form in the panel tells us when it is saved or cancelled. Only messages from our own site are trusted
		window.addEventListener('message', function (e) {
			if (e.origin !== window.location.origin || !e.data) return;
			if (e.data.type === 'need-open') {
				needMode = { name: e.data.name, suggestions: e.data.suggestions || [], picked: e.data.picked || [], meeting: e.data.meeting || null };
				needTitle = 'Du jobber med: ' + e.data.name;
				if (panelView === 'need') document.getElementById('sidePanelTitle').textContent = needTitle;
				showNeedMode();
				renderPick();
			}
			if (e.data.type === 'need-close') {
				closeSidePanel();
			}
			if (e.data.type === 'need-created') {
				// The new need opens in the panel, so you can start finding resources right away (help with AI)
				var where = (e.data.lat != null && e.data.lng != null) ? L.latLng(e.data.lat, e.data.lng) : null;
				openNeedPanel(e.data.url, where);
				loadNeeds(); // the new circle shows up right away
			}
		});

		// "Behovsmodus": while a need is open in the panel, the resources it can use get a ring,
		// the others are hidden, and the resource panel can choose them for the need (help with AI)
		// Docs: Leaflet CircleMarker - https://leafletjs.com/reference.html
		var needMode = null;
		var needModeLayer = L.layerGroup().addTo(map);

		function showNeedMode() {
			needModeLayer.clearLayers();
			Object.keys(markersById).forEach(function (id) {
				var marker = markersById[id];
				var rid = parseInt(id, 10);
				// Not in need mode: every resource is shown, as normal
				if (!needMode) { layerFor(marker).addLayer(marker); return; }
				var suggested = needMode.suggestions.includes(rid);
				var picked = needMode.picked.includes(rid);
				// In need mode: only the resources this need can use are shown, like a filter
				if (suggested) layerFor(marker).addLayer(marker); else layerFor(marker).removeLayer(marker);
				if (suggested) {
					// Green ring = can be chosen, blue filled = chosen (the side panel says it in text too)
					L.circleMarker(marker.getLatLng(), {
						radius: 20, weight: 3, interactive: false,
						color: picked ? '#378ADD' : '#639922',
						fillColor: '#378ADD', fillOpacity: picked ? 0.35 : 0
					}).addTo(needModeLayer);
					// Chosen: a ✓ on the resource too, so it doesn't rely on colour alone
					if (picked) {
						L.marker(marker.getLatLng(), {
							icon: L.divIcon({ className: '', html: '<div class="picked-check" aria-hidden="true">✓</div>', iconSize: [20, 20], iconAnchor: [-6, 46] }),
							interactive: false
						}).addTo(needModeLayer);
						if (needLatLng) L.polyline([marker.getLatLng(), needLatLng], { color: '#378ADD', weight: 2, dashArray: '6 6', interactive: false }).addTo(needModeLayer);
					}
				}
			});

			// The kontaktpunkt: the purple flag with a dashed line to the need (help with AI)
			if (needMode && needMode.meeting) {
				var m = needMode.meeting;
				L.marker([m.lat, m.lng], {
					icon: L.divIcon({ className: '', html: '<div class="meeting-flag"><i class="ti ti-flag" aria-hidden="true"></i></div>', iconSize: [26, 26], iconAnchor: [13, 13] }),
					keyboard: false
				}).bindTooltip('⚑ Kontaktpunkt: ' + escapeHtml(m.name), { direction: 'top', offset: [0, -14] }).addTo(needModeLayer);
				if (needLatLng) {
					L.polyline([needLatLng, [m.lat, m.lng]], { color: '#7A5AF8', weight: 2, dashArray: '6 6', interactive: false }).addTo(needModeLayer);
				}
			}

			// Need mode is easy to see: the yellow top of the panel, and the info box with what the rings mean
			var info = document.getElementById('needModeInfo');
			info.hidden = !needMode;
			if (needMode) document.getElementById('needModeName').textContent = needMode.name;
			document.getElementById('sidePanel').classList.toggle('need-mode', !!needMode);
		}

		function exitNeedMode() {
			needMode = null;
			showNeedMode();
		}

		// Click on a box: a list of the resources in it, and "Zoom inn"
		var lastCluster = null;
		markerLayer.on('clusterclick', function (e) {
			lastCluster = e.layer;
			var count = e.layer.getChildCount();
			// Short and simple: the number and what you can do. The list comes in the side panel
			L.popup()
				.setLatLng(e.latlng)
				.setContent(`<strong>${count} ressurser her</strong>`
					+ `<div class="d-flex gap-2 mt-2">`
					+ `<button type="button" class="btn btn-sm btn-success" onclick="zoomToCluster();">🔍 Zoom inn</button>`
					+ `<button type="button" class="btn btn-sm btn-outline-secondary" onclick="showClusterList();">☰ Vis i lista</button>`
					+ `</div>`)
				.openOn(map);
		});

		// Zoom to the box: stop the popup's small pan first, then jump straight there.
		// Two animations at the same time made Leaflet skip loading map pictures (grey squares) (help with AI)
		// Docs: Leaflet Map stop / fitBounds - https://leafletjs.com/reference.html#map-stop
		function zoomToCluster() {
			if (!lastCluster) return;
			map.closePopup();
			map.stop();
			map.fitBounds(lastCluster.getBounds(), { padding: [40, 40], animate: false });
		}

		// Go to one resource, even if it is inside a box
		function zoomToResource(id) {
			var marker = markersById[id];
			if (!marker) return;
			map.closePopup();
			if (returnLayer.hasLayer(marker)) { map.setView(marker.getLatLng(), 16); openResource(id); return; }
			markerLayer.zoomToShowLayer(marker, function () { openResource(id); });
		}

		// The side panel on the left (help with AI): shows one view at a time - 'hits' (Liste), 'filter', 'resource' or 'need'.
		// The resource is its own page with ?embed=1, so it looks the same everywhere.
		// The need stays loaded in the background while you look at a resource, so "✓ Velg til …" still works
		var hitsOnly = null;        // the resources in a box on the map ("Vis i lista"); null = all in "Liste"
		var openResourceId = null;
		var panelView = null;       // what the panel shows now (null = closed)
		var needUrl = null;         // the need that is open (null = none)
		var needLatLng = null;      // where the open need is on the map
		var needTitle = '';         // "Du jobber med: …"

		// The same limit as Bootstrap's md: under 768 px the panel is a sheet at the bottom
		function isPhone() { return window.innerWidth < 768; }

		function showView(view) {
			panelView = view;
			var panel = document.getElementById('sidePanel');
			var headerHeight = document.querySelector('header').offsetHeight;
			panel.style.top = headerHeight + 'px';
			panel.style.setProperty('--map-top', headerHeight + 'px'); // the full height of the sheet on phones
			if (panel.hidden) setSheet('half'); // phones: a new sheet starts at Halv
			panel.hidden = false;
			document.body.classList.add('map-panel-open');
			document.getElementById('resourcePanelFrame').hidden = view !== 'resource';
			document.getElementById('needPanelFrame').hidden = view !== 'need';
			document.getElementById('sidePanelFull').hidden = view !== 'need' && view !== 'resource';
			document.getElementById('filterPanelBody').hidden = view !== 'filter';
			document.getElementById('hitsPanelBody').hidden = view !== 'hits';
			// Liste | Filter: the tabs instead of a title
			document.getElementById('panelTabs').hidden = view !== 'filter' && view !== 'hits';
			document.querySelector('.side-panel-head').classList.toggle('tabbed', view === 'filter' || view === 'hits');
			document.getElementById('tabHits').classList.toggle('active', view === 'hits');
			document.getElementById('tabFilter').classList.toggle('active', view === 'filter');
			document.getElementById('tabHits').setAttribute('aria-selected', view === 'hits');
			document.getElementById('tabFilter').setAttribute('aria-selected', view === 'filter');
			if (view === 'filter' || view === 'hits') document.getElementById('sidePanelTitle').textContent = '';
			if (view === 'hits') renderHits(window.getResourceParams());
			if (view === 'need') document.getElementById('sidePanelTitle').textContent = needTitle;
			placeRadiusBar(view);

			// ‹ back: from a resource to the list, or to the need you are working on
			var backTo = null;
			if (view === 'resource' && fromHits) backTo = 'lista';
			else if (view !== 'need' && needUrl) backTo = 'behovet';
			var back = document.getElementById('sidePanelBack');
			back.hidden = !backTo;
			back.textContent = backTo ? '‹ Tilbake til ' + backTo : '';
			moveMapControls();
			renderPick();
		}

		function sidePanelBack() {
			if (panelView === 'resource' && fromHits) showView('hits');
			else showView('need');
		}

		// Phones: "Ressurser i området" is at the top of the Filter tab while the sheet shows Filter,
		// and floats over the map when the sheet is closed. On PC it always floats over the map (help with AI)
		function placeRadiusBar(view) {
			var bar = document.getElementById('radiusBar');
			var inPanel = isPhone() && view === 'filter';
			bar.classList.toggle('in-panel', inPanel);
			if (inPanel && bar.parentElement.id !== 'filterPanelBody') document.getElementById('filterPanelBody').prepend(bar);
			if (!inPanel && bar.parentElement.id === 'filterPanelBody') document.getElementById('radiusBarSmall').before(bar);
			if (inPanel && radiusCircle) {
				radiusBarSmall = false;
				bar.hidden = false;
				document.getElementById('radiusBarSmall').hidden = true;
			}
		}

		// Phones (help with AI): the sheet has three heights, like Google Maps: Liten, Halv and Full.
		// It follows the finger while you drag the grip, and stops at the next height when you let go.
		// Dragging never closes it; only ✕ (or Esc) does. A tap on the grip goes one height up (from Full: back to Halv)
		// Docs: Pointer events (MDN) - https://developer.mozilla.org/docs/Web/API/Pointer_events
		var sheetSizes = ['small', 'half', 'full'];
		var sheetSize = 'half';

		// Liten: the head, "Ressurser i området" (in Filter) and about 90 px of what is under it
		function smallSheetHeight() {
			var panel = document.getElementById('sidePanel');
			var height = document.getElementById('sidePanelGrip').offsetHeight + panel.querySelector('.side-panel-head').offsetHeight + 8;
			var info = document.getElementById('needModeInfo');
			if (!info.hidden) height += info.offsetHeight;
			var bar = document.getElementById('radiusBar');
			if (bar.classList.contains('in-panel') && !bar.hidden) height += bar.offsetHeight + 12;
			return Math.min(height + 90, window.innerHeight * 0.5);
		}

		function setSheet(size) {
			var panel = document.getElementById('sidePanel');
			var grip = document.getElementById('sidePanelGrip');
			sheetSize = size;
			if (size === 'small') panel.style.setProperty('--sheet-small', smallSheetHeight() + 'px');
			panel.classList.toggle('is-small', size === 'small');
			panel.classList.toggle('is-full', size === 'full');
			grip.setAttribute('aria-expanded', size === 'full');
			grip.setAttribute('aria-label', size === 'full' ? 'Gjør panelet mindre' : 'Gjør panelet større');
		}

		(function () {
			var panel = document.getElementById('sidePanel');
			var grip = document.getElementById('sidePanelGrip');
			var startY = null, startHeight = 0, dragged = false;
			grip.addEventListener('pointerdown', function (e) {
				startY = e.clientY;
				startHeight = panel.offsetHeight;
				dragged = false;
				grip.setPointerCapture(e.pointerId);
				panel.classList.add('dragging');
			});
			grip.addEventListener('pointermove', function (e) {
				if (startY === null) return;
				if (Math.abs(e.clientY - startY) > 6) dragged = true;
				if (dragged) panel.style.height = Math.max(80, startHeight - (e.clientY - startY)) + 'px';
			});
			function dragEnd(e) {
				if (startY === null) return;
				var moved = e.clientY - startY;
				startY = null;
				panel.classList.remove('dragging');
				panel.style.height = '';
				if (!dragged) return; // a tap: the click below does it
				var i = sheetSizes.indexOf(sheetSize);
				if (moved < -40) i = Math.min(i + 1, 2);
				if (moved > 40) i = Math.max(i - 1, 0);
				setSheet(sheetSizes[i]);
			}
			grip.addEventListener('pointerup', dragEnd);
			grip.addEventListener('pointercancel', dragEnd);
			// A tap (or Enter with the keyboard): one height up, and from Full back to Halv
			grip.addEventListener('click', function () {
				if (dragged) { dragged = false; return; }
				setSheet(sheetSize === 'full' ? 'half' : sheetSizes[sheetSizes.indexOf(sheetSize) + 1]);
			});
		})();

		// How much of the map the panel covers: on PC the left side, on phones the bottom.
		// Used by fitBounds, so a circle is placed where you can see it (help with AI)
		// Docs: Leaflet fitBounds options - https://leafletjs.com/reference.html#fitbounds-options
		function mapPadding() {
			var panel = document.getElementById('sidePanel');
			var open = !panel.hidden;
			if (isPhone()) return { paddingTopLeft: [20, 60], paddingBottomRight: [20, (open ? panel.offsetHeight : 0) + 20] };
			return { paddingTopLeft: [(open ? panel.offsetWidth : 0) + 20, 20], paddingBottomRight: [20, 20] };
		}

		// Phones: move the map so the point is in the middle of the part you can see, above the sheet
		function showAbovePanel(latlng) {
			var panel = document.getElementById('sidePanel');
			if (!isPhone() || panel.hidden) return;
			var visible = map.getSize().y - panel.offsetHeight;
			var point = map.latLngToContainerPoint(latlng);
			map.panBy([0, point.y - visible / 2], { animate: false });
		}

		function openResource(id, fromList) {
			openResourceId = id;
			fromHits = !!fromList; // ‹ goes back to "Liste"
			if (!fromList) hitsOnly = null;
			document.getElementById('resourcePanelFrame').src = detailUrl + id + '?embed=1';
			document.getElementById('sidePanelTitle').textContent = '';
			showView('resource');
			if (markersById[id]) showAbovePanel(markersById[id].getLatLng());
		}

		// "Åpne på egen side ↗" in the panel head follows the page in the panel (the resource, or "Endre ressurs"), without ?embed=1
		document.getElementById('resourcePanelFrame').addEventListener('load', function () {
			try {
				var url = new URL(this.contentWindow.location.href);
				url.searchParams.delete('embed');
				document.getElementById('sidePanelFull').href = url.pathname + url.search;
				// Saved after moving it: draw the resources again, so the green pin stands in the new place
				if (placeMoved && url.pathname.toLowerCase().startsWith('/resource/index')) { placeMoved = false; loadResources(window.getResourceParams()); }
			} catch (e) { }
		});

		// Moving from the panel to the big form: what is typed and the step you are on come along (sessionStorage, help with AI)
		document.getElementById('sidePanelFull').addEventListener('click', function () {
			try {
				var doc = document.getElementById('resourcePanelFrame').contentDocument;
				var form = doc && doc.getElementById('resourceWizard');
				if (panelView !== 'resource' || !form) return;
				var fields = [];
				new FormData(form).forEach(function (value, name) { if (typeof value === 'string' && name !== '__RequestVerificationToken') fields.push([name, value]); });
				var step = Array.from(form.querySelectorAll('.wizard-step')).findIndex(function (s) { return !s.hidden; });
				sessionStorage.setItem('wizardHandover', JSON.stringify({ path: new URL(this.href, location.href).pathname, fields: fields, step: step }));
			} catch (e) { }
		});

		// "Endre ressurs" in the side panel, step 3: the resource is moved on the big map instead of the small one.
		// Tap the map or drag the blue pin; ↶ Angre in the message at the bottom. Nothing is saved before "Lagre" (help with AI)
		// Docs: Window.postMessage (MDN) - https://developer.mozilla.org/docs/Web/API/Window/postMessage
		var placeMode = false, placePin = null, placeStart = null, placeLine = null, placeBar = null, placeHidden = null, placeMoved = false;

		function sendPlace(latlng) {
			document.getElementById('resourcePanelFrame').contentWindow.postMessage(
				{ type: 'place-picked', lat: latlng.lat, lng: latlng.lng }, window.location.origin);
		}

		// Move the pin (and the dotted line from where it stood). send: tell the form in the panel, and offer ↶ Angre
		function movePlace(latlng, send, before) {
			before = before || placePin.getLatLng();
			placePin.setLatLng(latlng);
			placeLine.setLatLngs([placeStart, latlng]);
			if (!send) return;
			placeMoved = true;
			sendPlace(placePin.getLatLng());
			var toast = document.getElementById('mapToast');
			var undo = document.createElement('button');
			undo.type = 'button';
			undo.className = 'btn btn-link btn-sm p-0 ms-2 text-info';
			undo.textContent = '↶ Angre';
			undo.addEventListener('click', function () { movePlace(before, false); sendPlace(before); toast.hidden = true; });
			toast.replaceChildren(document.createTextNode('Ressursen er flyttet.'), undo);
			toast.hidden = false;
			clearTimeout(toastTimer);
			toastTimer = setTimeout(function () { toast.hidden = true; }, 6000);
		}

		function placeOn(lat, lng) {
			placeOff();
			placeMode = true;
			placeStart = lat && lng ? L.latLng(lat, lng) : map.getCenter();
			map.getContainer().classList.add('place-mode');
			placeHidden = markersById[openResourceId] || null; // the resource's own green pin is hidden; the blue one takes its place
			if (placeHidden) layerFor(placeHidden).removeLayer(placeHidden);
			placeLine = L.polyline([placeStart, placeStart], { color: '#378ADD', weight: 2, dashArray: '6 6', interactive: false }).addTo(map);
			placePin = L.marker(placeStart, { draggable: true, zIndexOffset: 1000, icon: new L.Icon.Default({ className: 'place-pin' }) }).addTo(map);
			var dragFrom = null;
			placePin.on('dragstart', function () { dragFrom = placePin.getLatLng(); });
			placePin.on('drag', function () { placeLine.setLatLngs([placeStart, placePin.getLatLng()]); });
			placePin.on('dragend', function () { movePlace(placePin.getLatLng(), true, dragFrom); });
			placeBar = L.DomUtil.create('div', 'place-bar', map.getContainer());
			placeBar.innerHTML = '<i class="ti ti-map-pin" aria-hidden="true"></i> Trykk på kartet eller dra den blå nålen for å flytte ressursen';
			map.setView(placeStart, Math.max(map.getZoom(), 15));
		}

		function placeOff() {
			placeMode = false;
			map.getContainer().classList.remove('place-mode');
			[placePin, placeLine, placeBar].forEach(function (item) { if (item) item.remove(); });
			placePin = placeLine = placeBar = null;
			if (placeHidden) layerFor(placeHidden).addLayer(placeHidden);
			placeHidden = null;
		}

		// A tap on the map moves the resource while step 3 is open (the normal click menu is off then)
		map.on('click', function (e) { if (placeMode) movePlace(e.latlng, true); });

		window.addEventListener('message', function (e) {
			if (e.origin !== window.location.origin || !e.data) return;
			if (e.data.type === 'place-mode') { if (e.data.on) placeOn(e.data.lat, e.data.lng); else placeOff(); }
			if (e.data.type === 'place-pin' && placeMode) { movePlace(L.latLng(e.data.lat, e.data.lng), false); map.panTo([e.data.lat, e.data.lng]); }
		});

		// "Meld behov" in the side panel (help with AI): the need is placed on the big map. The form sends where it is,
		// the radius and the kontaktpunkt; a click on the map, or dragging the pin or the flag, sends the place back
		var needPlaceLayer = L.layerGroup().addTo(map), needPlaceOn = false, needPlaceBar = null;

		function sendToNeedForm(type, latlng) {
			document.getElementById('needPanelFrame').contentWindow.postMessage(
				{ type: type, lat: latlng.lat, lng: latlng.lng }, window.location.origin);
		}

		function drawNeedPlace(d) {
			needPlaceLayer.clearLayers();
			if (needPlaceBar) { needPlaceBar.remove(); needPlaceBar = null; }
			needPlaceOn = !d.off;
			map.getContainer().classList.toggle('place-mode', needPlaceOn);
			if (!needPlaceOn) return;

			// The stripe at the top says what a click does: purple while the kontaktpunkt is chosen
			needPlaceBar = L.DomUtil.create('div', 'place-bar' + (d.pickingMeeting ? ' is-meeting' : ''), map.getContainer());
			needPlaceBar.innerHTML = d.pickingMeeting
				? '<i class="ti ti-flag" aria-hidden="true"></i> Klikk der kontaktpunktet er'
				: '<i class="ti ti-map-pin" aria-hidden="true"></i> Klikk på kartet eller dra nålen for å velge hvor behovet er';
			if (d.lat == null || d.lng == null) return;

			var pos = L.latLng(d.lat, d.lng);
			var km = Math.min(d.radiusKm || 0, 50); // the same limit as the form (0,1–50 km)
			if (km > 0) {
				L.circle(pos, { radius: km * 1000, color: d.planned ? '#E69500' : '#E24B4A', dashArray: '8 6', fillOpacity: 0.08, interactive: false }).addTo(needPlaceLayer);
			}
			var pin = L.marker(pos, { draggable: true, zIndexOffset: 1000, icon: new L.Icon.Default({ className: 'place-pin' }) }).addTo(needPlaceLayer);
			pin.on('dragend', function () { sendToNeedForm('need-place-picked', pin.getLatLng()); });

			if (d.meeting) {
				var flag = L.marker([d.meeting.lat, d.meeting.lng], {
					draggable: true, zIndexOffset: 1000,
					icon: L.divIcon({ className: 'place-pin', html: '<div class="meeting-flag"><i class="ti ti-flag" aria-hidden="true"></i></div>', iconSize: [26, 26], iconAnchor: [13, 13] })
				}).bindTooltip('⚑ ' + escapeHtml(d.meeting.name || 'Kontaktpunkt')).addTo(needPlaceLayer);
				flag.on('dragend', function () { sendToNeedForm('need-meeting-moved', flag.getLatLng()); });
				L.polyline([pos, [d.meeting.lat, d.meeting.lng]], { color: '#7A5AF8', weight: 2, dashArray: '6 6', interactive: false }).addTo(needPlaceLayer);
			}
			fitNeedPlace(km > 0 ? pos.toBounds(km * 2000) : L.latLngBounds(pos, pos));
		}

		// The whole circle where you can see it, next to the panel (or above the sheet on phones). The map only moves when
		// the circle doesn't fit, and waits 300 ms, so typing 7,5 in «Annen …» is one move. Small: fly out; one point: pan to it
		// Docs: Leaflet flyToBounds - https://leafletjs.com/reference.html#map-flytobounds
		var needFitTimer = null;
		function visibleBounds() {
			var pad = mapPadding();
			var size = map.getSize();
			return L.latLngBounds(map.containerPointToLatLng(pad.paddingTopLeft),
				map.containerPointToLatLng([size.x - pad.paddingBottomRight[0], size.y - pad.paddingBottomRight[1]]));
		}

		function fitNeedPlace(bounds) {
			clearTimeout(needFitTimer);
			needFitTimer = setTimeout(function () {
				if (visibleBounds().contains(bounds)) return;
				var options = Object.assign(mapPadding(), { duration: 0.5 });
				if (bounds.getNorthEast().equals(bounds.getSouthWest())) map.panInside(bounds.getCenter(), mapPadding());
				else map.flyToBounds(bounds, options);
			}, 300);
		}

		// A click on the map while "Meld behov" is open: the form decides if it is the need or the kontaktpunkt
		map.on('click', function (e) { if (needPlaceOn) sendToNeedForm('need-map-click', e.latlng); });

		window.addEventListener('message', function (e) {
			if (e.origin !== window.location.origin || !e.data || e.data.type !== 'need-place') return;
			drawNeedPlace(e.data);
		});

		// "Vis i lista" on a box: "Liste" shows only the resources in the box, with a chip «8 på samme sted ✕» (help with AI)
		function showClusterList() {
			if (!lastCluster) return;
			hitsOnly = lastCluster.getAllChildMarkers().map(function (m) { return m.resource.id; });
			map.closePopup();
			showView('hits');
		}

		// "Liste" in the side panel (help with AI): the resources that match the filter, in boxes by status like Ressursoversikt,
		// the nearest first when a point is chosen. A click shows it on the map and opens it in the panel (‹ goes back to the list).
		// Over the list: chips for the box or the distance, so you see what the list is limited to and can remove it with ✕
		var lastHits = [];     // the resources on the map now (after the filter)
		var fromHits = false;  // the open resource was chosen in "Liste"
		var hitGroups = [['Ledig', 'Ledig nå', 'ti-circle-check', 'status-ok'], ['Ledig senere', 'Ledig senere', 'ti-clock', 'status-grey'],
		['I bruk', 'I bruk', 'ti-hourglass', 'status-grey'], ['Lever tilbake', 'Lever tilbake', 'ti-arrow-back-up', 'status-return'],
		['Ikke tilgjengelig', 'Ikke tilgjengelig', 'ti-ban', 'status-grey'], ['Ugyldig', 'Ugyldig', 'ti-alert-triangle', 'status-bad']];

		function hitDistance(r, params) {
			return params.lat && params.lng ? ResourceFilter.distanceKm(+params.lat, +params.lng, +r.latitude, +r.longitude) : null;
		}

		function renderHits(params) {
			var shown = hitsOnly ? lastHits.filter(function (r) { return hitsOnly.includes(r.id); }) : lastHits;
			document.getElementById('tabHitsCount').textContent = shown.length;
			document.getElementById('hitsOpenList').href = document.getElementById('hitsOpenList').dataset.url + '?' + new URLSearchParams(params);
			if (panelView !== 'hits') return;
			var hits = shown.slice().sort(function (a, b) {
				return params.lat ? hitDistance(a, params) - hitDistance(b, params) : (a.name || '').localeCompare(b.name || '', 'nb');
			});
			document.getElementById('hitsSummary').innerHTML = '<i class="ti ti-filter" aria-hidden="true"></i> ' + hits.length + (hits.length === 1 ? ' ressurs' : ' ressurser')
				+ (params.lat ? ' <span class="fw-normal text-body-secondary">· nærmest først</span>' : '');

			var chips = '';
			if (hitsOnly) chips += `<button type="button" class="hits-chip" data-clear="box"><i class="ti ti-stack-2" aria-hidden="true"></i> ${hitsOnly.length} på samme sted <i class="ti ti-x" aria-hidden="true"></i><span class="visually-hidden">Fjern</span></button>`;
			if (params.lat && params.radius) chips += `<button type="button" class="hits-chip" data-clear="radius"><i class="ti ti-map-pin" aria-hidden="true"></i> Innen ${kmText(roundKm(parseFloat(params.radius)))} <i class="ti ti-x" aria-hidden="true"></i><span class="visually-hidden">Fjern</span></button>`;

			var html = chips ? `<div class="hits-chips">${chips}</div>` : '';
			hitGroups.forEach(function (g) {
				var inGroup = hits.filter(function (r) { return (r.status || 'Ledig') === g[0]; });
				if (inGroup.length === 0) return;
				html += `<div class="hit-group"><i class="ti ${g[2]}" aria-hidden="true"></i> ${g[1]} · ${inGroup.length}</div>`;
				inGroup.forEach(function (r) {
					var km = hitDistance(r, params);
					var icon = (r.icon || 'map-pin').replace(/^ti-/, '').replace(/[^a-z0-9-]/gi, ''); // only letters, numbers and - in the class
					var iconCss = g[0] === 'Ledig' ? '' : g[0] === 'Lever tilbake' ? 'list-icon-return' : 'list-icon-busy';
					html += `<button type="button" class="hit-row" data-id="${r.id}">`
						+ `<span class="list-icon ${iconCss}"><i class="ti ti-${icon}" aria-hidden="true"></i></span>`
						+ `<span class="hit-text"><span class="hit-name">${escapeHtml(r.name)}${r.reports > 0 ? ' <span class="res-flag">⚑ ' + r.reports + '</span>' : ''}</span>`
						+ `<span class="hit-sub">${escapeHtml(r.type)}${km == null ? '' : ' · ' + km.toFixed(1).replace('.', ',') + ' km'}</span></span>`
						+ `<span class="status-badge ${g[3]}"><i class="ti ${g[2]}" aria-hidden="true"></i> ${escapeHtml(r.freeFrom || g[0])}</span></button>`;
				});
			});
			if (hits.length === 0) html += '<p class="small text-body-secondary mt-3">Ingen ressurser passer filteret.</p>';
			var box = document.getElementById('hitsList');
			box.innerHTML = html;
			box.querySelectorAll('.hits-chip').forEach(function (chip) {
				chip.addEventListener('click', function () {
					if (chip.dataset.clear === 'box') { hitsOnly = null; renderHits(window.getResourceParams()); }
					else document.getElementById('radiusRemove').click(); // the same as "Fjern" in "Ressurser i området"
				});
			});
			box.querySelectorAll('.hit-row').forEach(function (row) {
				row.addEventListener('click', function () {
					var id = parseInt(row.dataset.id, 10);
					if (markersById[id]) map.setView(markersById[id].getLatLng(), Math.max(map.getZoom(), 15), { animate: false });
					openResource(id, true);
				});
			});
		}

		// Eksporter in "Liste": the same resources as CSV or JSON (resource-export.js)
		document.querySelectorAll('[data-map-export]').forEach(function (button) {
			button.addEventListener('click', function () {
				var params = window.getResourceParams();
				var rows = lastHits.map(function (r) {
					var km = hitDistance(r, params);
					return {
						Navn: r.name, Type: r.type, Status: r.freeFrom || r.status || 'Ledig',
						Kommune: (r.municipality || '').toLowerCase().replace(/(^|[\s-])\p{L}/gu, function (c) { return c.toUpperCase(); }),
						Breddegrad: r.latitude, Lengdegrad: r.longitude, 'Avstand (km)': km == null ? '' : Math.round(km * 10) / 10
					};
				});
				ResourceExport.download(rows, 'ressurser-kart', button.dataset.mapExport);
			});
		});

		// ✕ or Esc: close the panel, and the need if one is open
		function closeSidePanel() {
			exitNeedMode();
			panelView = null;
			needUrl = null;
			needLatLng = null;
			hitsOnly = null;
			fromHits = false;
			openResourceId = null;
			document.getElementById('sidePanel').hidden = true;
			document.body.classList.remove('map-panel-open');
			placeRadiusBar(null); // phones: "Ressurser i området" floats over the map again
			moveMapControls();
			document.getElementById('resourcePanelFrame').src = 'about:blank';
			document.getElementById('needPanelFrame').src = 'about:blank';
		}

		// Need mode: the open resource can be chosen for the need that is open
		function renderPick() {
			var box = document.getElementById('resourcePanelPick');
			if (panelView !== 'resource' || !needMode || openResourceId == null || !needMode.suggestions.includes(openResourceId)) { box.hidden = true; return; }
			var picked = needMode.picked.includes(openResourceId);
			box.hidden = false;
			box.innerHTML = '';
			var button = document.createElement('button');
			button.type = 'button';
			button.className = 'btn w-100 ' + (picked ? 'btn-outline-secondary' : 'btn-success');
			button.textContent = (picked ? '✕ Fjern fra ' : '✓ Velg til ') + needMode.name;
			button.addEventListener('click', function () {
				document.getElementById('needPanelFrame').contentWindow.postMessage(
					{ type: 'need-pick', resourceId: openResourceId }, window.location.origin);
				var name = markersById[openResourceId] ? markersById[openResourceId].resource.name : 'Ressursen';
				showToast((picked ? '✕ ' + name + ' er fjernet fra ' : '✓ ' + name + ' er valgt til ') + needMode.name);
				showView('need'); // back to the need, so you see it ticked
			});
			box.appendChild(button);
		}

		// A short message at the bottom for 3 seconds (help with AI)
		var toastTimer = null;
		function showToast(text) {
			var toast = document.getElementById('mapToast');
			toast.textContent = text;
			toast.hidden = false;
			clearTimeout(toastTimer);
			toastTimer = setTimeout(function () { toast.hidden = true; }, 3000);
		}

		// Esc closes the side panel
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape' && panelView) closeSidePanel();
		});

		// The side panel's width: drag the right edge (or ← → on the keyboard).
		// The width is remembered (help with AI) - Docs: Pointer events (MDN) - https://developer.mozilla.org/docs/Web/API/Pointer_events
		function setPanelWidth(px) {
			var max = Math.max(320, window.innerWidth * 0.8);
			px = Math.min(Math.max(px, 320), max);
			document.getElementById('sidePanel').style.width = px + 'px';
			moveMapControls();
			try { localStorage.setItem('panelWidth', px); } catch (e) { }
		}

		function makeResizable(panel, handle) {
			handle.addEventListener('pointerdown', function (e) {
				e.preventDefault();
				panel.classList.add('resizing');
				function move(ev) { setPanelWidth(ev.clientX); }
				function up() {
					panel.classList.remove('resizing');
					window.removeEventListener('pointermove', move);
					window.removeEventListener('pointerup', up);
				}
				window.addEventListener('pointermove', move);
				window.addEventListener('pointerup', up);
			});
			// Keyboard: → makes it wider, ← narrower
			handle.addEventListener('keydown', function (e) {
				if (e.key === 'ArrowRight') { setPanelWidth(panel.offsetWidth + 40); e.preventDefault(); }
				if (e.key === 'ArrowLeft') { setPanelWidth(panel.offsetWidth - 40); e.preventDefault(); }
			});
		}

		makeResizable(document.getElementById('sidePanel'), document.getElementById('sidePanelResize'));
		try { var savedWidth = parseInt(localStorage.getItem('panelWidth'), 10); if (savedWidth) setPanelWidth(savedWidth); } catch (e) { }

		// The Filter button on the map, under + and −. It opens the filter in the side panel (help with AI)
		// Docs: Leaflet Control - https://leafletjs.com/reference.html#control
		var FilterControl = L.Control.extend({
			options: { position: 'topleft' },
			onAdd: function () {
				var button = L.DomUtil.create('button', 'btn btn-success shadow-sm d-flex align-items-center gap-2');
				button.type = 'button';
				button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5z" /></svg>'
					+ '<span>Filter</span><span id="rfCount" class="badge text-bg-light" hidden></span>';
				L.DomEvent.disableClickPropagation(button);
				L.DomEvent.on(button, 'click', function () {
					if (panelView === 'filter' || panelView === 'hits') closeSidePanel(); else showView('filter');
				});
				return button;
			}
		});
		new FilterControl().addTo(map);

		// The chips with what is chosen, under the Filter button (filled by resource-filter.js)
		var ChipsControl = L.Control.extend({
			options: { position: 'topleft' },
			onAdd: function () {
				var box = L.DomUtil.create('div', 'rf-chips');
				box.id = 'rfChips';
				box.hidden = true;
				L.DomEvent.disableClickPropagation(box);
				return box;
			}
		});
		new ChipsControl().addTo(map);

		// "↩︎ 2 skal leveres tilbake" at the top, next to Filter: a click zooms to them (help with AI)
		var ReturnControl = L.Control.extend({
			options: { position: 'topleft' },
			onAdd: function () {
				var button = L.DomUtil.create('button', 'return-chip');
				button.type = 'button';
				button.id = 'returnChip';
				button.hidden = true;
				L.DomEvent.disableClickPropagation(button);
				L.DomEvent.on(button, 'click', function () {
					var markers = returnLayer.getLayers();
					if (markers.length === 1) zoomToResource(markers[0].resource.id);
					else if (markers.length > 1) map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [60, 60] });
				});
				return button;
			}
		});
		new ReturnControl().addTo(map);

		function updateReturnChip() {
			var chip = document.getElementById('returnChip');
			var count = returnLayer.getLayers().length;
			chip.hidden = count === 0;
			chip.innerHTML = '<i class="ti ti-arrow-back-up" aria-hidden="true"></i> ' + count + ' skal leveres tilbake';
		}

		// + − and Filter move to the right of the side panel while it is open, so they are never hidden under it.
		// Phones: the sheet is at the bottom, so nothing moves sideways
		function moveMapControls() {
			var panel = document.getElementById('sidePanel');
			var side = !panel.hidden && !isPhone();
			document.querySelector('.leaflet-left').style.left = side ? panel.offsetWidth + 'px' : '';
			// "Ressurser i området" stays in the middle of the part of the map you can see
			var left = side ? panel.offsetWidth : 0;
			['radiusBar', 'radiusBarSmall'].forEach(function (id) { document.getElementById(id).style.left = 'calc(' + left + 'px + (100% - ' + left + 'px) / 2)'; });
		}

		// "Vis på kartet" in the filter (only on Kart): turn resources and needs on and off.
		// Kept in the URL as hide=resources / hide=needs, like the rest of the filter (help with AI)
		function applyLayerChoices(params) {
			var hide = (params.hide || '').split(',');
			if (hide.includes('resources')) map.removeLayer(markerLayer); else map.addLayer(markerLayer);
			if (hide.includes('resources')) map.removeLayer(returnLayer); else map.addLayer(returnLayer);
			if (hide.includes('actors')) map.removeLayer(actorLayer); else map.addLayer(actorLayer);
			document.getElementById('rfShowActors').checked = !hide.includes('actors');
			if (canNeeds) {
				if (hide.includes('needs')) map.removeLayer(needLayer); else map.addLayer(needLayer);
			}
			document.getElementById('rfShowResources').checked = !hide.includes('resources');
			var needsBox = document.getElementById('rfShowNeeds');
			if (needsBox) needsBox.checked = !hide.includes('needs');
			// Type and status only matter for resources: greyed out while resources are hidden
			document.getElementById('rfPanel').classList.toggle('rf-resources-off', hide.includes('resources'));
		}

		function changeLayerChoice() {
			var hide = [];
			if (!document.getElementById('rfShowResources').checked) hide.push('resources');
			var needsBox = document.getElementById('rfShowNeeds');
			if (needsBox && !needsBox.checked) hide.push('needs');
			if (!document.getElementById('rfShowActors').checked) hide.push('actors');
			var params = window.getResourceParams();
			params.hide = hide.join(',');
			window.applyResourceParams(params);
		}

		document.getElementById('rfShowResources').addEventListener('change', changeLayerChoice);
		document.getElementById('rfShowActors').addEventListener('change', changeLayerChoice);
		if (document.getElementById('rfShowNeeds')) document.getElementById('rfShowNeeds').addEventListener('change', changeLayerChoice);

		// Tegnforklaring nede til høyre: what the colours and signs on the map mean. Open/closed is remembered (help with AI)
		// Docs: <details> (MDN) - https://developer.mozilla.org/docs/Web/HTML/Element/details
		var LegendControl = L.Control.extend({
			options: { position: 'bottomright' },
			onAdd: function () {
				var box = L.DomUtil.create('details', 'map-legend');
				// The pins and colours on the map (help with AI): icon + text in every row, so nothing relies on colour alone
				var pin = function (colour) { return '<svg class="legend-pin" viewBox="0 0 36 46" width="14" height="18" aria-hidden="true"><path fill="' + colour + '" d="M18 45 C6 30 2 24 2 17 A16 16 0 0 1 34 17 C34 24 30 30 18 45Z"/></svg>'; };
				// What each group sees (help with AI): admin/operator = resources, actors and needs.
				// Guests and users = Kriser first (the most important for them), then actors; resources only when signed in
				var resources = '<div class="map-legend-title">Ressurser</div>'
					+ '<div>' + pin('#2f8a3a') + 'Ledig nå (ikonet viser typen)</div>'
					+ '<div>' + pin('#888780') + 'I bruk, ledig senere eller ikke tilgjengelig</div>'
					+ '<div><span class="legend-return">↩︎</span>Skal leveres tilbake</div>'
					+ '<div><span class="legend-cluster">2</span>Flere ressurser på samme sted</div>';
				var actors = '<div class="map-legend-title">Offentlige aktører</div>'
					+ '<div><img src="/images/permanent-map-icons/police.png" width="16" height="16" alt="" class="legend-img" />Politi, brann og sykehus</div>';
				var needs = '<div class="map-legend-title">Behov</div>'
					+ '<div><span class="legend-square need-akutt"></span>Akutt</div>'
					+ '<div><span class="legend-square need-planlagt"></span>Planlagt</div>'
					+ '<div><span class="legend-circle"></span>Området behovet gjelder</div>'
					+ '<div class="map-legend-title">Når du jobber med et behov</div>'
					+ '<div><span class="ring-dot"></span>Kan velges</div>'
					+ '<div><span class="ring-dot ring-picked">✓</span>Valgt</div>'
					+ '<div><span class="legend-line"></span>Valgt til behovet</div>'
					+ '<div><span class="meeting-flag meeting-flag-xs"><i class="ti ti-flag" aria-hidden="true"></i></span>Kontaktpunkt</div>';
				var crises = '<div class="map-legend-title">Kriser</div>'
					+ '<div><span class="legend-crisis is-acute"><i class="ti ti-alarm" aria-hidden="true"></i></span>Akutt – skjer nå</div>'
					+ '<div><span class="legend-crisis is-planned"><i class="ti ti-calendar" aria-hidden="true"></i></span>Planlagt – f.eks. en øvelse</div>'
					+ '<div class="legend-note">Klikk for mer info</div>';
				box.innerHTML = '<summary>ⓘ Tegnforklaring</summary>'
					+ (canNeeds
						? resources + actors + needs
						: crises + actors + (signedIn ? resources : '<div class="map-legend-title legend-note">Ressurser (bare innlogget)</div>'));

				try { box.open = localStorage.getItem('legendOpen') !== '0'; } catch (e) { } // open the first time, closed only if the user closed it
				box.addEventListener('toggle', function () {
					try { localStorage.setItem('legendOpen', box.open ? '1' : '0'); } catch (e) { }
				});
				L.DomEvent.disableClickPropagation(box);
				L.DomEvent.disableScrollPropagation(box);
				return box;
			}
		});
		new LegendControl().addTo(map);
	</script>
}