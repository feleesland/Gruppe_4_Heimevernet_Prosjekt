		// "Velg punkt på kartet" i filter
		var pickingCenter = false;
		window.startPickCenter = function (callback) {
			pickingCenter = true;
			map.getContainer().style.cursor = 'crosshair';
			map.once('click', function (e) {
				map.getContainer().style.cursor = '';
				callback(e.latlng.lat, e.latlng.lng);
				pickingCenter = false;
			});
		};

			// "Ressurser i området" (help with AI): change the distance right on the map - the slider, the number,
			// the quick buttons or the white dot on the edge of the circle. It uses the same radius in the URL as the filter
			// Docs: Leaflet Marker (draggable) - https://leafletjs.com/reference.html#marker
			var radiusQuick = [1, 2, 5, 10, 50];
			var radiusHandle = null;
			var radiusBarSmall = false; // true after "Ferdig", until a new point is chosen
			var radiusPointKey = '';

			// The slider goes from 0.1 to 500 km, with most of it for short distances (middle = about 7 km)
			function sliderToKm(value) { return roundKm(0.1 * Math.pow(5000, value / 1000)); }
			function kmToSlider(km) { return Math.round(1000 * Math.log(km / 0.1) / Math.log(5000)); }
			function roundKm(km) { return km < 10 ? Math.round(km * 10) / 10 : Math.round(km); }
			function kmText(km) { return km < 1 ? Math.round(km * 1000) + ' m' : String(km).replace('.', ',') + ' km'; }

			// Use a new radius: the filter, the chips and the circle are updated, and the resources counted again
			function applyRadius(km) {
				var params = window.getResourceParams();
				if (!params.lat) return;
				params.radius = String(Math.min(Math.max(roundKm(km), 0.1), 500));
				window.applyResourceParams(params);
			}

			// While dragging: only the circle and the numbers change; the resources are counted when you let go
			function previewRadius(km, dragging) {
				if (!radiusCircle) return;
				radiusCircle.setRadius(km * 1000);
				showRadiusNumbers(km, dragging);
			}

			function showRadiusNumbers(km, dragging) {
				var slider = document.getElementById('radiusSlider');
				slider.value = kmToSlider(km);
				slider.setAttribute('aria-valuetext', kmText(km));
				document.getElementById('radiusNumber').value = km;
				if (radiusHandle) {
					if (!dragging) radiusHandle.setLatLng(edgePoint(km));
					radiusHandle.setTooltipContent(kmText(km));
				}
				document.querySelectorAll('.radius-chip').forEach(function (chip) {
					var on = parseFloat(chip.dataset.km) === km;
					chip.classList.toggle('active', on);
					chip.setAttribute('aria-pressed', on);
					chip.textContent = (on ? '✓ ' : '') + chip.dataset.km + ' km';
				});
			}

			// The point on the right edge of the circle (1 degree of latitude is about 111.32 km)
			function edgePoint(km) {
				var center = radiusCircle.getLatLng();
				return L.latLng(center.lat, center.lng + km / (111.32 * Math.cos(center.lat * Math.PI / 180)));
			}

			// Called after every search or filter change: show, update or hide the bar, the small button and the dot
			function updateRadiusBar(params, count) {
				var bar = document.getElementById('radiusBar');
				var small = document.getElementById('radiusBarSmall');
				if (radiusHandle) { map.removeLayer(radiusHandle); radiusHandle = null; }
				if (!radiusCircle) {
					bar.hidden = true;
					small.hidden = true;
					radiusPointKey = '';
					return;
				}
				var key = params.lat + ',' + params.lng;
				if (key !== radiusPointKey) radiusBarSmall = false; // a new point: show the whole bar again
				radiusPointKey = key;
				var km = roundKm(parseFloat(params.radius));
				var hits = count === 1 ? '1 treff' : count + ' treff';

				radiusHandle = L.marker(edgePoint(km), {
					draggable: true,
					keyboard: false, // the slider and the number field are the keyboard way
					icon: L.divIcon({ className: '', html: '<div class="radius-handle"></div>', iconSize: [22, 22], iconAnchor: [11, 11] })
				}).bindTooltip(kmText(km), { permanent: true, direction: 'top', offset: [0, -12] }).addTo(map);
				radiusHandle.on('drag', function (e) {
					previewRadius(roundKm(Math.max(map.distance(radiusCircle.getLatLng(), e.target.getLatLng()) / 1000, 0.1)), true);
				});
				radiusHandle.on('dragend', function (e) {
					applyRadius(map.distance(radiusCircle.getLatLng(), e.target.getLatLng()) / 1000);
				});

				document.getElementById('radiusBarCount').textContent = hits;
				small.textContent = '⟷ Innen ' + kmText(km) + ' · ' + hits + ' · Endre';
				bar.hidden = radiusBarSmall;
				small.hidden = !radiusBarSmall;
				showRadiusNumbers(km);
			}

			// The quick buttons and the other controls in the bar (set up once)
			radiusQuick.forEach(function (km) {
				var chip = document.createElement('button');
				chip.type = 'button';
				chip.className = 'radius-chip';
				chip.dataset.km = km;
				chip.textContent = km + ' km';
				chip.addEventListener('click', function () { applyRadius(km); });
				document.getElementById('radiusChips').appendChild(chip);
			});
			document.getElementById('radiusSlider').addEventListener('input', function () { previewRadius(sliderToKm(this.value)); });
			document.getElementById('radiusSlider').addEventListener('change', function () { applyRadius(sliderToKm(this.value)); });
			document.getElementById('radiusNumber').addEventListener('change', function () {
				var km = parseFloat(this.value);
				if (!isNaN(km)) applyRadius(km);
			});
			document.getElementById('radiusRemove').addEventListener('click', function () {
				var params = window.getResourceParams();
				delete params.lat; delete params.lng; delete params.where; delete params.radius;
				window.applyResourceParams(params);
			});
			document.getElementById('radiusDone').addEventListener('click', function () {
				radiusBarSmall = true;
				document.getElementById('radiusBar').hidden = true;
				document.getElementById('radiusBarSmall').hidden = false;
			});
			document.getElementById('radiusBarSmall').addEventListener('click', function () {
				radiusBarSmall = false;
				document.getElementById('radiusBarSmall').hidden = true;
				document.getElementById('radiusBar').hidden = false;
				document.getElementById('radiusSlider').focus();
			});

		var resourceCreateUrl = '@Url.Action("Create", "ResourceHandler")';
		var mapUrl = '@Url.Action("Map", "Home")';
		var signedIn = @(signedIn ? "true" : "false");

		map.on('click', function (e) {
			// Not while "Velg punkt på kartet" is choosing the centre of the filter
			if (pickingCenter || placeMode || !signedIn) return;

			var lat = e.latlng.lat.toFixed(6);
			var lng = e.latlng.lng.toFixed(6);
			var radius = radiusCircle ? (radiusCircle.getRadius() / 1000) : 2;

			var links = '';
			if (canNeeds) {
				links += `<a href="${needCreateUrl}?lat=${lat}&lng=${lng}&radius=${radius}" onclick="return openNeedPanel(this.href);">+ Meld behov her</a>`;
			}
			links += `<a href="${resourceCreateUrl}?lat=${lat}&lng=${lng}">+ Registrer ressurs her</a>`;
			links += `<a href="${mapUrl}?lat=${lat}&lng=${lng}&radius=${radius}">Vis ressurser i området</a>`;

			L.popup()
				.setLatLng(e.latlng)
				.setContent(`<div class="map-menu">${links}</div>`)
				.openOn(map);
		});

		// ?focus=12 (from "Vis på hovedkartet"): zoom to that resource and open its popup
		var startParams = Object.fromEntries(new URLSearchParams(window.location.search));
		var focusId = startParams.focus;
		delete startParams.focus;

		loadPermanentMarkers();

		window.onResourceSearch(startParams).then(function () {
			if (focusId && markersById[focusId]) {
				zoomToResource(focusId);
			}
		});

		
		// Open a need ("Meld behov" or an existing need) in the side panel (help with AI) - Docs: Window.postMessage (MDN)
		// https://developer.mozilla.org/docs/Web/API/Window/postMessage
		function openNeedPanel(url, latlng) {
			needLatLng = latlng || null; // where the need is, for the lines to the chosen resources
			exitNeedMode();
			needUrl = url;
			needTitle = '';
			resourceList = [];
			openResourceId = null;
			document.getElementById('needPanelFrame').src = url + (url.includes('?') ? '&' : '?') + 'embed=1';
			document.getElementById('sidePanelFull').href = url;
			showView('need');
			map.closePopup();
			return false; // don't follow the link, the panel shows the form instead
		}

		// The form in the panel tells us when it is saved or cancelled. Only messages from our own site are trusted
		window.addEventListener('message', function (e) {
			if (e.origin !== window.location.origin || !e.data) return;
			if (e.data.type === 'need-open') {
				needMode = { name: e.data.name, suggestions: e.data.suggestions || [], picked: e.data.picked || [] };
				needTitle = 'Du jobber med: ' + e.data.name;
				if (panelView === 'need') document.getElementById('sidePanelTitle').textContent = needTitle;
				showNeedMode();
				renderPick();
			}
			if (e.data.type === 'need-close') {
				closeSidePanel();
			}
			if (e.data.type === 'need-created') {
				closeSidePanel();
				loadNeeds(); // the new circle shows up right away
			}
		});

		// "Behovsmodus": while a need is open in the panel, the resources it can use get a ring,
		// the others are hidden, and the resource panel can choose them for the need (help with AI)
		// Docs: Leaflet CircleMarker - https://leafletjs.com/reference.html
		var needMode = null;
		var needModeLayer = L.layerGroup().addTo(map);

		function showNeedMode() {
			needModeLayer.clearLayers();
			Object.keys(markersById).forEach(function (id) {
				var marker = markersById[id];
				var rid = parseInt(id, 10);
				// Not in need mode: every resource is shown, as normal
				if (!needMode) { layerFor(marker).addLayer(marker); return; }
				var suggested = needMode.suggestions.includes(rid);
				var picked = needMode.picked.includes(rid);
				// In need mode: only the resources this need can use are shown, like a filter
				if (suggested) layerFor(marker).addLayer(marker); else layerFor(marker).removeLayer(marker);
				if (suggested) {
					// Green ring = can be chosen, blue filled = chosen (the side panel says it in text too)
					L.circleMarker(marker.getLatLng(), {
						radius: 20, weight: 3, interactive: false,
						color: picked ? '#378ADD' : '#639922',
						fillColor: '#378ADD', fillOpacity: picked ? 0.35 : 0
					}).addTo(needModeLayer);
					// Chosen: a ✓ on the resource too, so it doesn't rely on colour alone
					if (picked) {
						L.marker(marker.getLatLng(), {
							icon: L.divIcon({ className: '', html: '<div class="picked-check" aria-hidden="true">✓</div>', iconSize: [20, 20], iconAnchor: [-6, 46] }),
							interactive: false
						}).addTo(needModeLayer);
						if (needLatLng) L.polyline([marker.getLatLng(), needLatLng], { color: '#378ADD', weight: 2, dashArray: '6 6', interactive: false }).addTo(needModeLayer);
					}
				}
			});

			// Need mode is easy to see: the yellow top of the panel, and the info box with what the rings mean
			var info = document.getElementById('needModeInfo');
			info.hidden = !needMode;
			if (needMode) document.getElementById('needModeName').textContent = needMode.name;
			document.getElementById('sidePanel').classList.toggle('need-mode', !!needMode);
		}

		function exitNeedMode() {
			needMode = null;
			showNeedMode();
		}

		// Click on a box: a list of the resources in it, and "Zoom inn"
		var lastCluster = null;
		markerLayer.on('clusterclick', function (e) {
			lastCluster = e.layer;
			var count = e.layer.getChildCount();
			// Short and simple: the number and what you can do. The list comes in the side panel
			L.popup()
				.setLatLng(e.latlng)
				.setContent(`<strong>${count} ressurser her</strong>`
					+ `<div class="d-flex gap-2 mt-2">`
					+ `<button type="button" class="btn btn-sm btn-success" onclick="zoomToCluster();">🔍 Zoom inn</button>`
					+ `<button type="button" class="btn btn-sm btn-outline-secondary" onclick="showClusterList();">☰ Vis i lista</button>`
					+ `</div>`)
				.openOn(map);
		});

		// Zoom to the box: stop the popup's small pan first, then jump straight there.
		// Two animations at the same time made Leaflet skip loading map pictures (grey squares) (help with AI)
		// Docs: Leaflet Map stop / fitBounds - https://leafletjs.com/reference.html#map-stop
		function zoomToCluster() {
			if (!lastCluster) return;
			map.closePopup();
			map.stop();
			map.fitBounds(lastCluster.getBounds(), { padding: [40, 40], animate: false });
		}

		// Go to one resource, even if it is inside a box
		function zoomToResource(id) {
			var marker = markersById[id];
			if (!marker) return;
			map.closePopup();
			if (returnLayer.hasLayer(marker)) { map.setView(marker.getLatLng(), 16); openResource(id); return; }
			markerLayer.zoomToShowLayer(marker, function () { openResource(id); });
		}

		// The side panel on the left (help with AI): shows one view at a time - 'list' (from a box), 'resource' or 'need'.
		// The resource is its own page with ?embed=1, so it looks the same everywhere.
		// The need stays loaded in the background while you look at a resource, so "✓ Velg til …" still works
		var resourceList = [];      // the resources in the list (from a box)
		var resourceListType = '';  // the chosen type chip ('' = all)
		var openResourceId = null;
		var panelView = null;       // what the panel shows now (null = closed)
		var needUrl = null;         // the need that is open (null = none)
		var needLatLng = null;      // where the open need is on the map
		var needTitle = '';         // "Du jobber med: …"

		function showView(view) {
			panelView = view;
			var panel = document.getElementById('sidePanel');
			panel.style.top = document.querySelector('header').offsetHeight + 'px';
			panel.hidden = false;
			document.getElementById('resourcePanelList').hidden = view !== 'list';
			document.getElementById('resourcePanelFrame').hidden = view !== 'resource';
			document.getElementById('needPanelFrame').hidden = view !== 'need';
			document.getElementById('sidePanelFull').hidden = view !== 'need' && view !== 'resource';
			document.getElementById('filterPanelBody').hidden = view !== 'filter';
			if (view === 'filter') document.getElementById('sidePanelTitle').textContent = 'Filter';
			if (view === 'need') document.getElementById('sidePanelTitle').textContent = needTitle;

			// ‹ back: from a resource to the list, or to the need you are working on
			var backTo = null;
			if (view === 'resource' && resourceList.length > 0) backTo = 'lista';
			else if (view !== 'need' && needUrl) backTo = 'behovet';
			var back = document.getElementById('sidePanelBack');
			back.hidden = !backTo;
			back.textContent = backTo ? '‹ Tilbake til ' + backTo : '';
			moveMapControls();
			renderPick();
		}

		function sidePanelBack() {
			if (panelView === 'resource' && resourceList.length > 0) showResourceList();
			else showView('need');
		}

		function openResource(id) {
			openResourceId = id;
			document.getElementById('resourcePanelFrame').src = detailUrl + id + '?embed=1';
			document.getElementById('sidePanelTitle').textContent = '';
			showView('resource');
		}

		// "Åpne på egen side ↗" in the panel head follows the page in the panel (the resource, or "Endre ressurs"), without ?embed=1
		document.getElementById('resourcePanelFrame').addEventListener('load', function () {
			try {
				var url = new URL(this.contentWindow.location.href);
				url.searchParams.delete('embed');
				document.getElementById('sidePanelFull').href = url.pathname + url.search;
				// Saved after moving it: draw the resources again, so the green pin stands in the new place
				if (placeMoved && url.pathname.toLowerCase().startsWith('/resource/index')) { placeMoved = false; loadResources(window.getResourceParams()); }
			} catch (e) { }
		});
		
		// Moving from the panel to the big form: what is typed and the step you are on come along (sessionStorage, help with AI)
		document.getElementById('sidePanelFull').addEventListener('click', function () {
			try {
				var doc = document.getElementById('resourcePanelFrame').contentDocument;
				var form = doc && doc.getElementById('resourceWizard');
				if (panelView !== 'resource' || !form) return;
				var fields = [];
				new FormData(form).forEach(function (value, name) { if (typeof value === 'string' && name !== '__RequestVerificationToken') fields.push([name, value]); });
				var step = Array.from(form.querySelectorAll('.wizard-step')).findIndex(function (s) { return !s.hidden; });
				sessionStorage.setItem('wizardHandover', JSON.stringify({ path: new URL(this.href, location.href).pathname, fields: fields, step: step }));
			} catch (e) { }
		});

		// "Endre ressurs" in the side panel, step 3: the resource is moved on the big map instead of the small one.
		// Tap the map or drag the blue pin; ↶ Angre in the message at the bottom. Nothing is saved before "Lagre" (help with AI)
		// Docs: Window.postMessage (MDN) - https://developer.mozilla.org/docs/Web/API/Window/postMessage
		var placeMode = false, placePin = null, placeStart = null, placeLine = null, placeBar = null, placeHidden = null, placeMoved = false;

		function sendPlace(latlng) {
			document.getElementById('resourcePanelFrame').contentWindow.postMessage(
				{ type: 'place-picked', lat: latlng.lat, lng: latlng.lng }, window.location.origin);
		}

		// Move the pin (and the dotted line from where it stood). send: tell the form in the panel, and offer ↶ Angre
		function movePlace(latlng, send, before) {
			before = before || placePin.getLatLng();
			placePin.setLatLng(latlng);
			placeLine.setLatLngs([placeStart, latlng]);
			if (!send) return;
			placeMoved = true;
			sendPlace(placePin.getLatLng());
			var toast = document.getElementById('mapToast');
			var undo = document.createElement('button');
			undo.type = 'button';
			undo.className = 'btn btn-link btn-sm p-0 ms-2 text-info';
			undo.textContent = '↶ Angre';
			undo.addEventListener('click', function () { movePlace(before, false); sendPlace(before); toast.hidden = true; });
			toast.replaceChildren(document.createTextNode('Ressursen er flyttet.'), undo);
			toast.hidden = false;
			clearTimeout(toastTimer);
			toastTimer = setTimeout(function () { toast.hidden = true; }, 6000);
		}

		function placeOn(lat, lng) {
			placeOff();
			placeMode = true;
			placeStart = lat && lng ? L.latLng(lat, lng) : map.getCenter();
			map.getContainer().classList.add('place-mode');
			placeHidden = markersById[openResourceId] || null; // the resource's own green pin is hidden; the blue one takes its place
			if (placeHidden) layerFor(placeHidden).removeLayer(placeHidden);
			placeLine = L.polyline([placeStart, placeStart], { color: '#378ADD', weight: 2, dashArray: '6 6', interactive: false }).addTo(map);
			placePin = L.marker(placeStart, { draggable: true, zIndexOffset: 1000, icon: new L.Icon.Default({ className: 'place-pin' }) }).addTo(map);
			var dragFrom = null;
			placePin.on('dragstart', function () { dragFrom = placePin.getLatLng(); });
			placePin.on('drag', function () { placeLine.setLatLngs([placeStart, placePin.getLatLng()]); });
			placePin.on('dragend', function () { movePlace(placePin.getLatLng(), true, dragFrom); });
			placeBar = L.DomUtil.create('div', 'place-bar', map.getContainer());
			placeBar.innerHTML = '<i class="ti ti-map-pin" aria-hidden="true"></i> Trykk på kartet eller dra den blå nålen for å flytte ressursen';
			map.setView(placeStart, Math.max(map.getZoom(), 15));
		}

		function placeOff() {
			placeMode = false;
			map.getContainer().classList.remove('place-mode');
			[placePin, placeLine, placeBar].forEach(function (item) { if (item) item.remove(); });
			placePin = placeLine = placeBar = null;
			if (placeHidden) layerFor(placeHidden).addLayer(placeHidden);
			placeHidden = null;
		}

		// A tap on the map moves the resource while step 3 is open (the normal click menu is off then)
		map.on('click', function (e) { if (placeMode) movePlace(e.latlng, true); });

		window.addEventListener('message', function (e) {
			if (e.origin !== window.location.origin || !e.data) return;
			if (e.data.type === 'place-mode') { if (e.data.on) placeOn(e.data.lat, e.data.lng); else placeOff(); }
			if (e.data.type === 'place-pin' && placeMode) { movePlace(L.latLng(e.data.lat, e.data.lng), false); map.panTo([e.data.lat, e.data.lng]); }
		});

		function showClusterList() {
			if (!lastCluster) return;
			resourceList = lastCluster.getAllChildMarkers().map(function (m) { return m.resource; });
			resourceListType = '';
			map.closePopup();
			showResourceList();
		}

		function showResourceList() {
			openResourceId = null;
			document.getElementById('resourcePanelFrame').src = 'about:blank';
			showView('list');
			document.getElementById('sidePanelTitle').textContent = resourceList.length + ' ressurser her';
			var list = document.getElementById('resourcePanelList');

			// Type chips with the number: a filter for the list
			var counts = {};
			resourceList.forEach(function (r) { var t = r.type || 'Ukjent'; counts[t] = (counts[t] || 0) + 1; });
			var types = Object.keys(counts).sort();
			var chips = `<div class="d-flex flex-wrap gap-1 mb-2">`
				+ `<button type="button" class="type-chip ${resourceListType === '' ? 'active' : ''}" data-index="-1">Alle ${resourceList.length}</button>`
				+ types.map(function (t, i) {
					return `<button type="button" class="type-chip ${resourceListType === t ? 'active' : ''}" data-index="${i}">${escapeHtml(t)} ${counts[t]}</button>`;
				}).join('') + `</div>`;

			var rows = resourceList
				.filter(function (r) { return resourceListType === '' || (r.type || 'Ukjent') === resourceListType; })
				.map(function (r) {
					return `<button type="button" class="resource-row" data-id="${r.id}">`
						+ `<span class="flex-grow-1"><span class="fw-semibold d-block">${escapeHtml(r.name)}</span>`
						+ `<span class="small text-body-secondary">${escapeHtml(r.type)} · ${escapeHtml(r.status || 'Ledig')}</span></span>`
						+ `<span aria-hidden="true">›</span></button>`;
				}).join('');

			list.innerHTML = chips + rows;
			list.querySelectorAll('.type-chip').forEach(function (chip) {
				chip.addEventListener('click', function () {
					var i = parseInt(chip.dataset.index, 10);
					resourceListType = i < 0 ? '' : types[i];
					showResourceList();
				});
			});
			list.querySelectorAll('.resource-row').forEach(function (row) {
				row.addEventListener('click', function () { openResource(parseInt(row.dataset.id, 10)); });
			});
		}

		// ✕ or Esc: close the panel, and the need if one is open
		function closeSidePanel() {
			exitNeedMode();
			panelView = null;
			needUrl = null;
			needLatLng = null;
			resourceList = [];
			openResourceId = null;
			document.getElementById('sidePanel').hidden = true;
			moveMapControls();
			document.getElementById('resourcePanelFrame').src = 'about:blank';
			document.getElementById('needPanelFrame').src = 'about:blank';
		}

		// Need mode: the open resource can be chosen for the need that is open
		function renderPick() {
			var box = document.getElementById('resourcePanelPick');
			if (panelView !== 'resource' || !needMode || openResourceId == null || !needMode.suggestions.includes(openResourceId)) { box.hidden = true; return; }
			var picked = needMode.picked.includes(openResourceId);
			box.hidden = false;
			box.innerHTML = '';
			var button = document.createElement('button');
			button.type = 'button';
			button.className = 'btn w-100 ' + (picked ? 'btn-outline-secondary' : 'btn-success');
			button.textContent = (picked ? '✕ Fjern fra ' : '✓ Velg til ') + needMode.name;
			button.addEventListener('click', function () {
				document.getElementById('needPanelFrame').contentWindow.postMessage(
				{ type: 'need-pick', resourceId: openResourceId }, window.location.origin);
				var name = markersById[openResourceId] ? markersById[openResourceId].resource.name : 'Ressursen';
				showToast((picked ? '✕ ' + name + ' er fjernet fra ' : '✓ ' + name + ' er valgt til ') + needMode.name);
				showView('need'); // back to the need, so you see it ticked
			});
			box.appendChild(button);
		}

		// A short message at the bottom for 3 seconds (help with AI)
		var toastTimer = null;
		function showToast(text) {
			var toast = document.getElementById('mapToast');
			toast.textContent = text;
			toast.hidden = false;
			clearTimeout(toastTimer);
			toastTimer = setTimeout(function () { toast.hidden = true; }, 3000);
		}

		// Esc closes the side panel
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape' && panelView) closeSidePanel();
		});

		// The side panel's width: drag the right edge (or ← → on the keyboard).
		// The width is remembered (help with AI) - Docs: Pointer events (MDN) - https://developer.mozilla.org/docs/Web/API/Pointer_events
		function setPanelWidth(px) {
			var max = Math.max(320, window.innerWidth * 0.8);
			px = Math.min(Math.max(px, 320), max);
			document.getElementById('sidePanel').style.width = px + 'px';
			moveMapControls();
			try { localStorage.setItem('panelWidth', px); } catch (e) { }
		}

		function makeResizable(panel, handle) {
			handle.addEventListener('pointerdown', function (e) {
				e.preventDefault();
				panel.classList.add('resizing');
				function move(ev) { setPanelWidth(ev.clientX); }
				function up() {
					panel.classList.remove('resizing');
					window.removeEventListener('pointermove', move);
					window.removeEventListener('pointerup', up);
				}
				window.addEventListener('pointermove', move);
				window.addEventListener('pointerup', up);
			});
			// Keyboard: → makes it wider, ← narrower
			handle.addEventListener('keydown', function (e) {
				if (e.key === 'ArrowRight') { setPanelWidth(panel.offsetWidth + 40); e.preventDefault(); }
				if (e.key === 'ArrowLeft') { setPanelWidth(panel.offsetWidth - 40); e.preventDefault(); }
			});
		}

		makeResizable(document.getElementById('sidePanel'), document.getElementById('sidePanelResize'));
		try { var savedWidth = parseInt(localStorage.getItem('panelWidth'), 10); if (savedWidth) setPanelWidth(savedWidth); } catch (e) { }

		// The Filter button on the map, under + and −. It opens the filter in the side panel (help with AI)
		// Docs: Leaflet Control - https://leafletjs.com/reference.html#control
		var FilterControl = L.Control.extend({
			options: { position: 'topleft' },
			onAdd: function () {
				var button = L.DomUtil.create('button', 'btn btn-success shadow-sm d-flex align-items-center gap-2');
				button.type = 'button';
				button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5z" /></svg>'
					+ '<span>Filter</span><span id="rfCount" class="badge text-bg-light" hidden></span>';
				L.DomEvent.disableClickPropagation(button);
				L.DomEvent.on(button, 'click', function () {
					if (panelView === 'filter') closeSidePanel(); else showView('filter');
				});
				return button;
			}
		});
		new FilterControl().addTo(map);

		// The chips with what is chosen, under the Filter button (filled by resource-filter.js)
		var ChipsControl = L.Control.extend({
			options: { position: 'topleft' },
			onAdd: function () {
				var box = L.DomUtil.create('div', 'rf-chips');
				box.id = 'rfChips';
				box.hidden = true;
				L.DomEvent.disableClickPropagation(box);
				return box;
			}
		});
		new ChipsControl().addTo(map);

		// "↩ 2 skal leveres tilbake" at the top, next to Filter: a click zooms to them (help with AI)
		var ReturnControl = L.Control.extend({
			options: { position: 'topleft' },
			onAdd: function () {
				var button = L.DomUtil.create('button', 'return-chip');
				button.type = 'button';
				button.id = 'returnChip';
				button.hidden = true;
				L.DomEvent.disableClickPropagation(button);
				L.DomEvent.on(button, 'click', function () {
					var markers = returnLayer.getLayers();
					if (markers.length === 1) zoomToResource(markers[0].resource.id);
					else if (markers.length > 1) map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [60, 60] });
				});
				return button;
			}
		});
		new ReturnControl().addTo(map);

		function updateReturnChip() {
			var chip = document.getElementById('returnChip');
			var count = returnLayer.getLayers().length;
			chip.hidden = count === 0;
			chip.innerHTML = '<i class="ti ti-arrow-back-up" aria-hidden="true"></i> ' + count + ' skal leveres tilbake';
		}

		// + − and Filter move to the right of the side panel while it is open, so they are never hidden under it
		function moveMapControls() {
			var panel = document.getElementById('sidePanel');
			document.querySelector('.leaflet-left').style.left = panel.hidden ? '' : panel.offsetWidth + 'px';
			// "Ressurser i området" stays in the middle of the part of the map you can see
			var left = panel.hidden ? 0 : panel.offsetWidth;
			['radiusBar', 'radiusBarSmall'].forEach(function (id) { document.getElementById(id).style.left = 'calc(' + left + 'px + (100% - ' + left + 'px) / 2)'; });
		}

		// "Vis på kartet" in the filter (only on Kart): turn resources and needs on and off.
		// Kept in the URL as hide=resources / hide=needs, like the rest of the filter (help with AI)
		function applyLayerChoices(params) {
			var hide = (params.hide || '').split(',');
			if (hide.includes('resources')) map.removeLayer(markerLayer); else map.addLayer(markerLayer);
			if (hide.includes('resources')) map.removeLayer(returnLayer); else map.addLayer(returnLayer);
			if (hide.includes('actors')) map.removeLayer(actorLayer); else map.addLayer(actorLayer);
			document.getElementById('rfShowActors').checked = !hide.includes('actors');
			if (canNeeds) {
				if (hide.includes('needs')) map.removeLayer(needLayer); else map.addLayer(needLayer);
			}
			document.getElementById('rfShowResources').checked = !hide.includes('resources');
			var needsBox = document.getElementById('rfShowNeeds');
			if (needsBox) needsBox.checked = !hide.includes('needs');
			// Type and status only matter for resources: greyed out while resources are hidden
			document.getElementById('rfPanel').classList.toggle('rf-resources-off', hide.includes('resources'));
		}

		function changeLayerChoice() {
			var hide = [];
			if (!document.getElementById('rfShowResources').checked) hide.push('resources');
			var needsBox = document.getElementById('rfShowNeeds');
			if (needsBox && !needsBox.checked) hide.push('needs');
			if (!document.getElementById('rfShowActors').checked) hide.push('actors');
			var params = window.getResourceParams();
			params.hide = hide.join(',');
			window.applyResourceParams(params);
		}

		document.getElementById('rfShowResources').addEventListener('change', changeLayerChoice);
		document.getElementById('rfShowActors').addEventListener('change', changeLayerChoice);
		if (document.getElementById('rfShowNeeds')) document.getElementById('rfShowNeeds').addEventListener('change', changeLayerChoice);

		// Tegnforklaring nede til høyre: what the colours and signs on the map mean. Open/closed is remembered (help with AI)
		// Docs: <details> (MDN) - https://developer.mozilla.org/docs/Web/HTML/Element/details
		var LegendControl = L.Control.extend({
			options: { position: 'bottomright' },
			onAdd: function () {
				var box = L.DomUtil.create('details', 'map-legend');
				box.innerHTML = '<summary>ⓘ Tegnforklaring</summary>'
					+ '<div class="map-legend-title">Ressurser</div>'
					+ '<div><span class="legend-dot" style="background:#2AAD27"></span>Ledig</div>'
					+ '<div><span class="legend-dot" style="background:#CAC428"></span>Opptatt</div>'
					+ '<div><span class="legend-dot" style="background:#7B7B7B"></span>Ikke tilgjengelig</div>'
					+ '<div><span class="legend-dot" style="background:#CB2B3E"></span>Ugyldig</div>'
					+ '<div><span class="legend-cluster">2</span>Flere ressurser på samme sted</div>'
					+ (canNeeds
						? '<div class="map-legend-title">Behov</div>'
						+ '<div><span class="legend-square need-akutt"></span>Akutt</div>'
						+ '<div><span class="legend-square need-planlagt"></span>Planlagt</div>'
						+ '<div><span class="legend-circle"></span>Området behovet gjelder</div>'
						+ '<div class="map-legend-title">Når du jobber med et behov</div>'
						+ '<div><span class="ring-dot"></span>Kan velges</div>'
						+ '<div><span class="ring-dot ring-picked">✓</span>Valgt</div>'
						+ '<div><span class="legend-line"></span>Valgt til behovet</div>'
						: '');
				try { box.open = localStorage.getItem('legendOpen') !== '0'; } catch (e) { } // open the first time, closed only if the user closed it
				box.addEventListener('toggle', function () {
					try { localStorage.setItem('legendOpen', box.open ? '1' : '0'); } catch (e) { }
				});
				L.DomEvent.disableClickPropagation(box);
				L.DomEvent.disableScrollPropagation(box);
				return box;
			}
		});
		new LegendControl().addTo(map);
	</script>
}