		// Text from users is escaped before it goes into the popup, so HTML in a name can't run as code (XSS)
		function escapeHtml(text) {
			var div = document.createElement('div');
			div.textContent = text || '';
			return div.innerHTML;
		}

function loadPermanentMarkers() {

		fetch('@Url.Action("PermanentMapMarker", "Home")')
        .then(response => {
            if (!response.ok) {
                throw new Error("Kunne ikke hente installasjoner");
            }

            return response.json();
        })
        .then(locations => {

            permanentMarkerLayer.clearLayers();

            locations.forEach(function (location) {

                var lat = Number(location.latitude);
                var lng = Number(location.longitude);

                if (!Number.isFinite(lat) ||
                    !Number.isFinite(lng) ||
                    lat < -90 || lat > 90 ||
                    lng < -180 || lng > 180) {
                    return;
                }

                var marker = L.marker([lat, lng], {
                    icon: blueIcon
                });

                marker.bindPopup(`
                    <strong>${escapeHtml(location.name)}</strong><br>
                    Type: ${escapeHtml(location.type)}<br>
                    ${escapeHtml(location.description || '')}
                `);

                permanentMarkerLayer.addLayer(marker);
            });
        })
        .catch(error => {
            console.error(
                "Feil ved henting av faste installasjoner:",
                error
            );
        });
}


		//Ressurser hentes fra databasen og legges til på kartet som markører.
		// params can contain search, type, lat, lng and radius (sent to MapResources in ResourceController)
		function loadResources(params) {
			return fetch('@Url.Action("MapResources", "Resource")' + '?' + new URLSearchParams(params))
				.then(response => response.json())
				.then(resources => {

					console.log("Ressurser hentet:", resources);
					markerLayer.clearLayers();
					returnLayer.clearLayers();
					markersById = {};
					var markers = [];
					// The filter: type and status are chosen here; search and distance are done by the server
					if (window.ResourceFilter) ResourceFilter.render(resources, params);
					resources = resources.filter(function (r) { return !window.ResourceFilter || ResourceFilter.matches(r, params); });

					for (const resource of resources) {

						var lat = parseFloat(resource.latitude);
						var lng = parseFloat(resource.longitude);

						// Kontroller at koordinatene er gyldige
						if (isNaN(lat) || isNaN(lng)) {
							console.warn("Ugyldige koordinater:", resource);
							return;
						}

						// var icon = getResourceIcon(
						// 	resource.type,
						// 	resource.status
						// );
						var icon = resourcePin(resource);

						var marker = L.marker([lat, lng], { icon: icon }).addTo(resource.status === 'Lever tilbake' ? returnLayer : markerLayer);

						// Hover: the name and the status ("Ledig fra 16:00", "I bruk: Flom Vennesla"). Click: the resource in the panel on the left
						var statusText = resource.freeFrom || (resource.usedByNeedName ? resource.status + ': ' + resource.usedByNeedName : resource.status || 'Ledig');
						marker.bindTooltip('<strong>' + escapeHtml(resource.name) + '</strong><br>' + escapeHtml(statusText), { direction: 'top', offset: [0, -40] });
						marker.on('click', function () { openResource(resource.id); });
						markers.push(marker);
						markersById[resource.id] = marker;
						marker.resource = resource;
					}
					updateReturnChip();
					if (needMode) showNeedMode();
					return markers;
				})
				.catch(error => {
					console.error("Feil ved henting av ressurser:", error);
					return [];
				});
		}

		var canNeeds = @(canNeeds ? "true" : "false");
		var needLayer = L.layerGroup();
		var needDetailUrl = '@Url.Content("~/ResourceNeed/Index/")';
		var needCreateUrl = '@Url.Action("Create", "ResourceNeedHandler")';

		function shortDate(utc) {
			if (!utc) return '';
			var date = new Date(utc.endsWith('Z') ? utc : utc + 'Z');
			return date.toLocaleDateString('nb-NO', { day: '2-digit', month: '2-digit', timeZone: 'Europe/Oslo' });
		}

		function loadNeeds() {
			if (!canNeeds) return Promise.resolve();
			return fetch('@Url.Action("MapResourceNeeds", "ResourceNeed")')
				.then(response => response.ok ? response.json() : [])
				.then(needs => {
					needLayer.clearLayers();
					if (document.getElementById('rfNeedsCount')) document.getElementById('rfNeedsCount').textContent = needs.length;
					needs.forEach(need => {
						var lat = parseFloat(need.latitude);
						var lng = parseFloat(need.longitude);
						if (isNaN(lat) || isNaN(lng)) return;

						var planned = need.urgency === 'Planlagt';
						var colour = planned ? '#E69500' : '#E24B4A';
						var label = planned ? 'Planlagt ' + shortDate(need.neededFrom) : 'AKUTT';

						// The circle; bubblingMouseEvents: false so a click on it doesn't open the click menu as well
						L.circle([lat, lng], {
							radius: need.radiusKm * 1000,
							color: colour,
							weight: planned ? 3.5 : 3,
							dashArray: planned ? '4 6' : '8 6',
							fillOpacity: planned ? 0.12 : 0.08,
							bubblingMouseEvents: false
						}).addTo(needLayer);

						// Name and AKUTT/Planlagt as text above the square - Docs: Leaflet DivIcon
						L.marker([lat, lng], {
							icon: L.divIcon({
								className: 'need-label ' + (planned ? 'planlagt' : 'akutt'),
								html: '<span style="display:inline-block;transform:translateX(-50%);background:rgba(255,255,255,.85);padding:0 4px;border-radius:4px;">'
									+ escapeHtml(need.name) + ' · ' + escapeHtml(label) + '</span>',
								iconSize: null,
								iconAnchor: [0, 38]
							}),
							interactive: false
						}).addTo(needLayer);

						// Hover: the name and what is needed. Click: the need opens in the side panel, like a resource
						var items = need.items.map(i => `${i.quantity} × ${escapeHtml(i.type)}`).join('<br>');
						L.marker([lat, lng], {
							icon: L.divIcon({
								className: '',
								html: `<div class="need-marker ${planned ? 'need-planlagt' : 'need-akutt'}" aria-label="${escapeHtml(need.name)}: ${need.count} trengs">${need.count}</div>`,
								iconSize: [26, 26],
								iconAnchor: [13, 13]
							}),
							keyboard: true
						})
							.bindTooltip(`<strong>${escapeHtml(need.name)}</strong> · ${escapeHtml(label)}<br>${items}`, { direction: 'top', offset: [0, -14] })
							.on('click', function () { openNeedPanel(needDetailUrl + need.id, [lat, lng]); })
							.addTo(needLayer);
					});
				})
				.catch(error => console.error("Feil ved henting av behov:", error));
		}

		// Offentlige aktører (police, fire station, hospital) from the group's PermanentMapMarkers - shown to everyone, also guests.
		// Blue in the case = public actor; the group's own icons are used (getPermanentIcon) (help with AI)
		var actorLayer = L.layerGroup().addTo(map);
		function loadActors() {
			return fetch('@Url.Action("PermanentMapMarkers", "Home")')
				.then(response => response.ok ? response.json() : [])
				.then(actors => {
					actorLayer.clearLayers();
					document.getElementById('rfActorsCount').textContent = actors.length;
					actors.forEach(actor => {
						L.marker([actor.latitude, actor.longitude], { icon: getPermanentIcon(actor.iconType) })
							.bindTooltip('<strong>' + escapeHtml(actor.name) + '</strong><br>' + escapeHtml(actor.type), { direction: 'top', offset: [0, -38] })
							.bindPopup('<strong>' + escapeHtml(actor.name) + '</strong><br>' + escapeHtml(actor.description || actor.type))
							.addTo(actorLayer);
					});
				})
				.catch(error => console.error("Feil ved henting av offentlige aktører:", error));
		}
		loadActors();

		if (canNeeds) {
			loadNeeds();
		}

		

		window.onResourceSearch = async function (params) {
			var statusText = document.getElementById('globalSearchStatus');
			applyLayerChoices(params);

			// The circle: the chosen place in the middle, with the radius in km
			if (radiusCircle) {
				map.removeLayer(radiusCircle);
				radiusCircle = null;
			}
			if (params.lat && params.lng && params.radius) {
				radiusCircle = L.circle([parseFloat(params.lat), parseFloat(params.lng)], { radius: params.radius * 1000 }).addTo(map);
			}

			var markers = await loadResources(params);
			document.getElementById('rfResourcesCount').textContent = markers.length;
			updateRadiusBar(params, markers.length);

			// Only type/status chosen (no search or place): the map stays where it is, so it doesn't jump on every tick
			if (!params.search && !params.lat) {
				if (statusText) statusText.textContent = '';
				return;
			}

			if (statusText) {
				var found = markers.length === 1 ? '1 ressurs' : markers.length + ' ressurser';
				var radiusText = parseFloat(params.radius) < 1 ? (params.radius * 1000) + ' m' : params.radius + ' km';
				statusText.textContent = params.lat ? found + ' innen ' + radiusText : found + ' funnet';
			}

			// Move the map: to the circle, so all results fit, or to the only result
			if (radiusCircle) {
				map.fitBounds(radiusCircle.getBounds());
			} else if (markers.length > 1) {
				map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [40, 40] });
			} else if (markers.length === 1) {
				map.setView(markers[0].getLatLng(), 16);
			}
			if (params.search && markers.length === 1) openResource(markers[0].resource.id); // not while you tick in the filter
		};

		window.onResourceSelected = async function (resource) {
			if (resource.latitude == null || resource.longitude == null) {
				window.location.href = detailUrl + resource.id;
				return;
			}
			if (radiusCircle) {
				map.removeLayer(radiusCircle);
				radiusCircle = null;
			}
			updateRadiusBar({}, 0);
			await loadResources({});
			map.setView([resource.latitude, resource.longitude], 16);
			openResource(resource.id);
		};

