@model Heimevernet_Prosjekt.Models.PositionModel
@using Heimevernet_Prosjekt.Security.Authorization
@{
    var canNeeds = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Operator);
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<div id="map"></div>
@* Side panel: "Meld behov" opens here, with the map still visible. The form is the same page, shown with ?embed=1 *@
<aside id="needPanel" class="need-panel" hidden aria-label="Meld behov">
	@* Drag the left edge to change the width (also ← → with the keyboard) *@
	<div id="needPanelResize" class="need-panel-resize" role="separator" aria-orientation="vertical"
		 aria-label="Endre bredden på panelet" tabindex="0"></div>
	<div class="need-panel-head">
		<span id="needPanelTitle" class="small fw-semibold"></span>
		<a id="needPanelFull" href="#" class="small me-auto">Åpne på egen side ↗</a>
		<button type="button" class="btn-close" onclick="closeNeedPanel()" aria-label="Lukk panelet"></button>
	</div>
	<iframe id="needPanelFrame" title="Meld behov"></iframe>
</aside>

<style>
	/* Thin black outline around the resource icons, so they stand out on the map (only images, not the need squares) */
	.leaflet-marker-pane img.leaflet-marker-icon {
		filter: drop-shadow(0 0 1px #000) drop-shadow(0 0 1px #000);
	}
	/* The side panel: on the right, under the menu, colours follow light/dark mode */
	.need-panel {
		position: fixed;
		right: 0;
		bottom: 0;
		top: 76px;
		width: min(480px, 100vw);
		z-index: 1000;
		display: flex;
		flex-direction: column;
		background: var(--bs-body-bg);
		border-left: 1px solid var(--bs-border-color);
		box-shadow: -4px 0 16px rgba(0,0,0,.25);
	}

		.need-panel[hidden] {
			display: none;
		}

	.need-panel-head {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 8px 12px;
		border-bottom: 1px solid var(--bs-border-color);
	}

	.need-panel iframe {
		flex: 1;
		width: 100%;
		border: 0;
	}
	/* The map fills the screen under the menu, without scrolling. The footer is hidden on this page */
	body:has(#map) {
		overflow: hidden;
		margin-bottom: 0;
	}

		body:has(#map) footer {
			display: none;
		}

	#map {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		height: calc(100dvh - 76px); /* reserve, before JavaScript has measured the menu */
		min-height: 300px;
		z-index: 1 !important;
	}

	.need-marker {
		display: flex; align-items: center; justify-content: center;
		width: 26px; height: 26px; border-radius: 5px;
		font-weight: 700; font-size: 13px; color: #fff;
		border: 2px solid #fff; box-shadow: 0 1px 3px rgba(0,0,0,.4);
	}
	.need-akutt { background: #E24B4A; }
	.need-planlagt { background: #378ADD; }
	.need-label {
		background: transparent; border: 0; box-shadow: none;
		font-weight: 700; font-size: 12px; white-space: nowrap;
	}
	.need-label.akutt { color: #E24B4A; }
	.need-label.planlagt { color: #378ADD; }
	.map-menu a { display: block; padding: 4px 0; }

	.need-panel-resize {
		position: absolute;
		left: -4px;
		top: 0;
		bottom: 0;
		width: 8px;
		cursor: ew-resize;
		z-index: 1;
	}

		.need-panel-resize:hover, .need-panel-resize:focus-visible, .need-panel.resizing .need-panel-resize {
			background: var(--hv-link);
			outline: none;
		}
	/* While dragging, the form in the panel must not catch the mouse */
	.need-panel.resizing iframe {
		pointer-events: none;
	}
</style>

@section Scripts {
	<script>
// 		@*Ikoner til default*@ 
var greenIcon = new L.Icon({
    iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-green.png',
    shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
    iconSize: [25, 41],
    iconAnchor: [12, 41],
    popupAnchor: [1, -34]
});

var yellowIcon = new L.Icon({
    iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-yellow.png',
    shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
    iconSize: [25, 41],
    iconAnchor: [12, 41],
    popupAnchor: [1, -34]
});

var redIcon = new L.Icon({
    iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png',
    shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
    iconSize: [25, 41],
    iconAnchor: [12, 41],
    popupAnchor: [1, -34]
});

		var greyIcon = new L.Icon({
			iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-grey.png',
			shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
			iconSize: [25, 41],
			iconAnchor: [12, 41],
			popupAnchor: [1, -34]
		});


function getDefaultMarker(status) {

    switch (status) {

        case "Opptatt":
            return yellowIcon;

        case "Ugyldig":
            return redIcon;

        default:
            return greenIcon;
    }
}

function getResourceIcon(type, status) {

//bilder legges inn i wwwroot/images/resource-icons/ med navn som "tools-ledig.png", "vehicle-opptatt.png" osv. altså (type-status.png)
    var typeMap = {
        "Verktøy og utstyr": "tools",
        "Motoriserte kjøretøy": "vehicle",
        "Husly og bygg": "shelter",
       // "Materialer og forsyninger": "supplies",		//Har ikke ikon enda så bruker default for nå
        "Sikkerhet og medisinsk": "medical"
    };
			// "Ikke tilgjengelig" (e.g. at the workshop): always a grey marker, whatever the type
			if (status === "Ikke tilgjengelig") {
				return greyIcon;
			}

    var iconType = typeMap[type];

    if (!iconType) {
        return getDefaultMarker(status);
    }

    var iconStatus = (status || "Ledig")
        .toLowerCase()
        .replace("ø", "o");

    return L.icon({
        iconUrl: `/images/resource-icons/${iconType}-${iconStatus}.png`,
        iconSize: [36, 36],
        iconAnchor: [18, 36],
        popupAnchor: [0, -36]
    });
}
		// Initialize the map and set its view to a specific location and zoom level
		var map = L.map('map').setView([58.14671, 7.9956], 13); // Coordinates for Kristiansand. 13 stands for zoom level.

		// Add a tile layer to the map (OpenStreetMap tiles)
		L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
			attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
		}).addTo(map);
	
		// Exact height: the window minus the menu, also when the window changes size (help with AI)
		// Docs: Leaflet invalidateSize - https://leafletjs.com/reference.html#map-invalidatesize
		function fitMapToScreen() {
			var headerHeight = document.querySelector('header').offsetHeight;
			document.getElementById('map').style.height = (window.innerHeight - headerHeight) + 'px';
			map.invalidateSize();
		}
		window.addEventListener('resize', fitMapToScreen);
		fitMapToScreen();

		// Markers are kept in one layer so they can be removed before a new search; the circle shows the radius - Docs: Leaflet API reference (LayerGroup, Circle)
		// https://leafletjs.com/reference.html
		var markerLayer = L.layerGroup().addTo(map);
		var markersById = {};
		var radiusCircle = null;
		var detailUrl = '@Url.Content("~/Resource/Index/")';

		// Text from users is escaped before it goes into the popup, so HTML in a name can't run as code (XSS)
		function escapeHtml(text) {
			var div = document.createElement('div');
			div.textContent = text || '';
			return div.innerHTML;
		}

		//Ressurser hentes fra databasen og legges til på kartet som markører.
		// params can contain search, type, lat, lng and radius (sent to MapResources in ResourceController)
		function loadResources(params) {
			return fetch('@Url.Action("MapResources", "Resource")' + '?' + new URLSearchParams(params))
				.then(response => response.json())
				.then(resources => {

					console.log("Ressurser hentet:", resources);
					markerLayer.clearLayers();
					markersById = {};
					var markers = [];

					for (const resource of resources) {

						var lat = parseFloat(resource.latitude);
						var lng = parseFloat(resource.longitude);

						// Kontroller at koordinatene er gyldige
						if (isNaN(lat) || isNaN(lng)) {
							console.warn("Ugyldige koordinater:", resource);
							return;
						}
				
						var icon = getResourceIcon(
							resource.type,
							resource.status
						);

						var marker = L.marker([lat, lng], { icon: icon }).addTo(markerLayer);

						marker.bindPopup(`
							<strong>${escapeHtml(resource.name)}</strong><br>
							${escapeHtml(resource.description)}
							<br>
							Type: ${escapeHtml(resource.type) || "Ukjent"}
							<br>
							Status: ${escapeHtml(resource.status) || "Ukjent"}
							<br>
							<a href="${detailUrl}${resource.id}">Vis ressurs</a>
						`);
						markers.push(marker);
						markersById[resource.id] = marker;
						marker.resourceId = resource.id;
					}
					if (needMode) showNeedMode();
					return markers;
				})
				.catch(error => {
					console.error("Feil ved henting av ressurser:", error);
					return [];
				});
		}

		var canNeeds = @(canNeeds ? "true" : "false");
		var needLayer = L.layerGroup();
		var needDetailUrl = '@Url.Content("~/ResourceNeed/Index/")';
		var needCreateUrl = '@Url.Action("Create", "ResourceNeedHandler")';

		function shortDate(utc) {
			if (!utc) return '';
			var date = new Date(utc.endsWith('Z') ? utc : utc + 'Z');
			return date.toLocaleDateString('nb-NO', { day: '2-digit', month: '2-digit', timeZone: 'Europe/Oslo' });
		}

		function loadNeeds() {
			if (!canNeeds) return Promise.resolve();
			return fetch('@Url.Action("MapResourceNeeds", "ResourceNeed")')
				.then(response => response.ok ? response.json() : [])
				.then(needs => {
					needLayer.clearLayers();
					needs.forEach(need => {
						var lat = parseFloat(need.latitude);
						var lng = parseFloat(need.longitude);
						if (isNaN(lat) || isNaN(lng)) return;

						var planned = need.urgency === 'Planlagt';
						var colour = planned ? '#378ADD' : '#E24B4A';
						var label = planned ? 'Planlagt ' + shortDate(need.neededFrom) : 'AKUTT';

						// The circle; bubblingMouseEvents: false so a click on it doesn't open the click menu as well
						L.circle([lat, lng], {
							radius: need.radiusKm * 1000,
							color: colour,
							weight: 3,
							dashArray: planned ? '2 6' : '8 6',
							fillOpacity: 0.08,
							bubblingMouseEvents: false
						}).addTo(needLayer);

						// Name and AKUTT/Planlagt as text above the square - Docs: Leaflet DivIcon
						L.marker([lat, lng], {
							icon: L.divIcon({
								className: 'need-label ' + (planned ? 'planlagt' : 'akutt'),
								html: '<span style="display:inline-block;transform:translateX(-50%);background:rgba(255,255,255,.85);padding:0 4px;border-radius:4px;">'
								+ escapeHtml(need.name) + ' · ' + escapeHtml(label) + '</span>',
								iconSize: null,
								iconAnchor: [0, 38]
							}),
							interactive: false
						}).addTo(needLayer);

						var items = need.items.map(i => `<li>${i.quantity} × ${escapeHtml(i.type)}</li>`).join('');
						L.marker([lat, lng], {
							icon: L.divIcon({
								className: '',
								html: `<div class="need-marker ${planned ? 'need-planlagt' : 'need-akutt'}" aria-label="${need.count} trengs">${need.count}</div>`,
								iconSize: [26, 26],
								iconAnchor: [13, 13]
							}),
							keyboard: true,
							title: need.name
						}).bindPopup(`
							<strong>${escapeHtml(need.name)}</strong> · ${escapeHtml(label)}
							<ul class="mb-1 ps-3">${items}</ul>
							<a href="${needDetailUrl}${need.id}" onclick="return openNeedPanel(this.href);">Åpne behovet</a><br>
							<a href="${needCreateUrl}?lat=${lat}&lng=${lng}">+ Legg til mer</a>
						`).addTo(needLayer);
					});
				})
				.catch(error => console.error("Feil ved henting av behov:", error));
		}

		if (canNeeds) {
			needLayer.addTo(map);
			// Turn resources and needs on and off - Docs: Leaflet Control.Layers
			L.control.layers(null, { 'Ressurser': markerLayer, 'Behov': needLayer }, { collapsed: false }).addTo(map);
			loadNeeds();
		}

		window.onResourceSearch = async function (params) {
			var statusText = document.getElementById('globalSearchStatus');

			// The circle: the chosen place in the middle, with the radius in km
			if (radiusCircle) {
				map.removeLayer(radiusCircle);
				radiusCircle = null;
			}
			if (params.lat && params.lng && params.radius) {
				radiusCircle = L.circle([parseFloat(params.lat), parseFloat(params.lng)], { radius: params.radius * 1000 }).addTo(map);
			}

			var markers = await loadResources(params);

			if (Object.keys(params).length === 0) {
				if (statusText) statusText.textContent = '';
				map.setView([58.14671, 7.9956], 13);
				return;
			}

			if (statusText) {
				var found = markers.length === 1 ? '1 ressurs' : markers.length + ' ressurser';
				var radiusText = parseFloat(params.radius) < 1 ? (params.radius * 1000) + ' m' : params.radius + ' km';
				statusText.textContent = params.lat ? found + ' innen ' + radiusText : found + ' funnet';
			}

			// Move the map: to the circle, so all results fit, or to the only result
			if (radiusCircle) {
				map.fitBounds(radiusCircle.getBounds());
			} else if (markers.length > 1) {
				map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [40, 40] });
			} else if (markers.length === 1) {
				map.setView(markers[0].getLatLng(), 16);
			}
			if (markers.length === 1) {
				markers[0].openPopup();
			}
		};

		window.onResourceSelected = async function (resource) {
			if (resource.latitude == null || resource.longitude == null) {
				window.location.href = detailUrl + resource.id;
				return;
			}
			if (radiusCircle) {
				map.removeLayer(radiusCircle);
				radiusCircle = null;
			}
			await loadResources({});
			map.setView([resource.latitude, resource.longitude], 16);
			if (markersById[resource.id]) {
				markersById[resource.id].openPopup();
			}
		};

		// "Velg punkt på kartet" i filter
		var pickingCenter = false;
		window.startPickCenter = function (callback) {
			pickingCenter = true;
			map.getContainer().style.cursor = 'crosshair';
			map.once('click', function (e) {
				map.getContainer().style.cursor = '';
				callback(e.latlng.lat, e.latlng.lng);
				pickingCenter = false;
			});
		};

		var resourceCreateUrl = '@Url.Action("Create", "ResourceHandler")';
		var mapUrl = '@Url.Action("Map", "Home")';
		var signedIn = @(signedIn ? "true" : "false");

		map.on('click', function (e) {
			// Not while "Velg punkt på kartet" is choosing the centre of the filter
			if (pickingCenter || !signedIn) return;

			var lat = e.latlng.lat.toFixed(6);
			var lng = e.latlng.lng.toFixed(6);
			var radius = radiusCircle ? (radiusCircle.getRadius() / 1000) : 2;

			var links = '';
			if (canNeeds) {
				links += `<a href="${needCreateUrl}?lat=${lat}&lng=${lng}&radius=${radius}" onclick="return openNeedPanel(this.href);">+ Meld behov her</a>`;
			}
			links += `<a href="${resourceCreateUrl}?lat=${lat}&lng=${lng}">+ Registrer ressurs her</a>`;
			links += `<a href="${mapUrl}?lat=${lat}&lng=${lng}&radius=${radius}">Vis ressurser i området</a>`;

			L.popup()
				.setLatLng(e.latlng)
				.setContent(`<div class="map-menu">${links}</div>`)
				.openOn(map);
		});

		// ?focus=12 (from "Vis på hovedkartet"): zoom to that resource and open its popup
		var startParams = Object.fromEntries(new URLSearchParams(window.location.search));
		var focusId = startParams.focus;
		delete startParams.focus;
		window.onResourceSearch(startParams).then(function () {
			if (focusId && markersById[focusId]) {
				map.setView(markersById[focusId].getLatLng(), 16);
				markersById[focusId].openPopup();
			}
		});

		
		// Side panel for "Meld behov" (help with AI) - Docs: Window.postMessage (MDN)
		// https://developer.mozilla.org/docs/Web/API/Window/postMessage
		function openNeedPanel(url) {
			exitNeedMode();
			var panel = document.getElementById('needPanel');
			panel.style.top = document.querySelector('header').offsetHeight + 'px';
			document.getElementById('needPanelFrame').src = url + (url.includes('?') ? '&' : '?') + 'embed=1';
			document.getElementById('needPanelFull').href = url;
			panel.hidden = false;
			map.closePopup();
			return false; // don't follow the link, the panel shows the form instead
		}

		function closeNeedPanel() {
			exitNeedMode();
			document.getElementById('needPanel').hidden = true;
			document.getElementById('needPanelFrame').src = 'about:blank';
		}

		// The form in the panel tells us when it is saved or cancelled. Only messages from our own site are trusted
		window.addEventListener('message', function (e) {
			if (e.origin !== window.location.origin || !e.data) return;
			if (e.data.type === 'need-open') {
				needMode = { name: e.data.name, suggestions: e.data.suggestions || [], picked: e.data.picked || [] };
				document.getElementById('needPanelTitle').textContent = 'Du jobber med: ' + e.data.name;
				showNeedMode();
			}
			if (e.data.type === 'need-close') {
				closeNeedPanel();
			}
			if (e.data.type === 'need-created') {
				closeNeedPanel();
				loadNeeds(); // the new circle shows up right away
			}
		});

		// Esc closes the panel
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape' && !document.getElementById('needPanel').hidden) closeNeedPanel();
		});

		
				//Change the panel's width by dragging the left edge; the width is remembered (help with AI)
				// Docs: Pointer events (MDN) - https://developer.mozilla.org/docs/Web/API/Pointer_events
				(function () {
					var panel = document.getElementById('needPanel');
					var handle = document.getElementById('needPanelResize');

					function setWidth(px) {
						var max = Math.max(320, window.innerWidth * 0.8);
						px = Math.min(Math.max(px, 320), max);
						panel.style.width = px + 'px';
						try { localStorage.setItem('needPanelWidth', px); } catch (e) { }
					}

					var saved = null;
					try { saved = parseInt(localStorage.getItem('needPanelWidth'), 10); } catch (e) { }
					if (saved) setWidth(saved);

					handle.addEventListener('pointerdown', function (e) {
						e.preventDefault();
						panel.classList.add('resizing');
						function move(ev) { setWidth(window.innerWidth - ev.clientX); }
						function up() {
							panel.classList.remove('resizing');
							window.removeEventListener('pointermove', move);
							window.removeEventListener('pointerup', up);
						}
						window.addEventListener('pointermove', move);
						window.addEventListener('pointerup', up);
					});

					// Keyboard: ← makes it wider, → narrower
					handle.addEventListener('keydown', function (e) {
						if (e.key === 'ArrowLeft') { setWidth(panel.offsetWidth + 40); e.preventDefault(); }
						if (e.key === 'ArrowRight') { setWidth(panel.offsetWidth - 40); e.preventDefault(); }
					});
				})();

		// "Behovsmodus": while a need is open in the panel, the resources it can use get a ring,
		// the others fade, and the popup can tick them in the panel (help with AI)
		// Docs: Leaflet CircleMarker and popupopen - https://leafletjs.com/reference.html
		var needMode = null;
		var needModeLayer = L.layerGroup().addTo(map);

		function showNeedMode() {
			needModeLayer.clearLayers();
			Object.keys(markersById).forEach(function (id) {
				var marker = markersById[id];
				var rid = parseInt(id, 10);
				// Not in need mode: every resource is shown, as normal
				if (!needMode) { markerLayer.addLayer(marker); return; }
				var suggested = needMode.suggestions.includes(rid);
				var picked = needMode.picked.includes(rid);
				// In need mode: only the resources this need can use are shown, like a filter
				if (suggested) markerLayer.addLayer(marker); else markerLayer.removeLayer(marker);
				if (suggested) {
					// Green ring = can be chosen, blue filled = chosen (also the popup says it in text)
					L.circleMarker(marker.getLatLng(), {
						radius: 20, weight: 3, interactive: false,
						color: picked ? '#378ADD' : '#639922',
						fillColor: '#378ADD', fillOpacity: picked ? 0.35 : 0
					}).addTo(needModeLayer);
				}
			});
		}

		function exitNeedMode() {
			needMode = null;
			showNeedMode();
			document.getElementById('needPanelTitle').textContent = '';
		}

		// The resource's popup gets "Velg til ..." while a need is open
		map.on('popupopen', function (e) {
			var marker = e.popup._source;
			if (!needMode || !marker || marker.resourceId == null) return;
			if (!needMode.suggestions.includes(marker.resourceId)) return;

			var picked = needMode.picked.includes(marker.resourceId);
			var button = document.createElement('button');
			button.type = 'button';
			button.className = 'btn btn-sm mt-2 ' + (picked ? 'btn-outline-secondary' : 'btn-success');
			button.textContent = (picked ? '✕ Fjern fra ' : '✓ Velg til ') + needMode.name;
			button.addEventListener('click', function () {
				document.getElementById('needPanelFrame').contentWindow.postMessage(
					{ type: 'need-pick', resourceId: marker.resourceId }, window.location.origin);
				map.closePopup();
			});
			e.popup.getElement().querySelector('.leaflet-popup-content').appendChild(button);
		});

	</script>
}