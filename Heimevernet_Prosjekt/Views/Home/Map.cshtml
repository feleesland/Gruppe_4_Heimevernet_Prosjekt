@model Heimevernet_Prosjekt.Models.PositionModel
@using Heimevernet_Prosjekt.Security.Authorization
@{
	var canNeeds = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Operator);
	var signedIn = User.Identity?.IsAuthenticated == true;
	ViewData["FilterOnMap"] = true;
	ViewData["FilterCanNeeds"] = canNeeds;
}

<link rel="stylesheet" href="~/css/crisis.css" asp-append-version="true" />
<div id="map"></div>
@* One side panel on the left, like Google Maps (on phones a sheet at the bottom). It shows one thing at a time: Liste, Filter,
   a resource or a need (the pages themselves with ?embed=1). While a need is open you can look at a resource and go back with ‹ *@
<aside id="sidePanel" class="side-panel" hidden aria-label="Sidepanel">
	@* Phones: the grip at the top of the sheet. Tap or drag up = full height, drag down = half height or close *@
	<button type="button" id="sidePanelGrip" class="side-panel-grip" aria-label="Gjør panelet større" aria-expanded="false"><span aria-hidden="true"></span></button>
	@* Drag the right edge to change the width (also ← → with the keyboard) *@
	<div id="sidePanelResize" class="side-panel-resize" role="separator" aria-orientation="vertical"
		 aria-label="Endre bredden på panelet" tabindex="0"></div>
	<div class="side-panel-head">
		<button type="button" id="sidePanelBack" class="btn btn-sm btn-link p-0" hidden onclick="sidePanelBack()"></button>
		<span id="sidePanelTitle" class="small fw-semibold"></span>
		@* Liste | Filter (help with AI): the resources that match the filter, and the filter itself *@
		<div id="panelTabs" class="panel-tabs" role="tablist" hidden>
			<button type="button" id="tabHits" class="panel-tab" role="tab" onclick="showView('hits')"><i class="ti ti-list" aria-hidden="true"></i> Liste <span id="tabHitsCount" class="badge rounded-pill"></span></button>
			<button type="button" id="tabFilter" class="panel-tab" role="tab" onclick="showView('filter')"><i class="ti ti-filter" aria-hidden="true"></i> Filter <span id="tabFilterCount" class="badge rounded-pill" hidden></span></button>
		</div>
		@* A button (a link that looks like one, since it opens another page), next to ✕ on the right *@
		<a id="sidePanelFull" href="#" class="btn btn-sm btn-outline-secondary panel-full-btn ms-auto" hidden><i class="ti ti-external-link" aria-hidden="true"></i> <span class="d-none d-sm-inline">Åpne på </span>egen side</a>
		<button type="button" class="btn-close ms-auto" onclick="closeSidePanel()" aria-label="Lukk panelet"></button>
	</div>
	@* Need mode: what you are doing, and what the rings on the map mean (text + icon, not only colour) *@
	<div id="needModeInfo" class="need-mode-info" role="status" hidden>
		<div>🎯 Klikk på en ressurs på kartet for å velge den til <strong id="needModeName"></strong></div>
		<div class="need-mode-legend">
			<span><span class="ring-dot" aria-hidden="true"></span>Kan velges</span>
			<span><span class="ring-dot ring-picked" aria-hidden="true">✓</span>Valgt</span>
		</div>
	</div>
	<div id="filterPanelBody" class="side-panel-list" hidden>
		<partial name="_ResourceFilter" />
	</div>
	@* "Liste": the resources on the map that match the filter, with Eksporter (renderHits below) *@
	<div id="hitsPanelBody" class="side-panel-list" hidden>
		<div class="d-flex align-items-center gap-2">
			<strong id="hitsSummary"></strong>
			<div class="dropdown ms-auto">
				<button type="button" class="btn btn-sm rf-reset dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="ti ti-download" aria-hidden="true"></i> Eksporter</button>
				<ul class="dropdown-menu dropdown-menu-end">
					<li><button type="button" class="dropdown-item" data-map-export="csv"><i class="ti ti-file-spreadsheet" aria-hidden="true"></i> CSV (Excel)</button></li>
					<li><button type="button" class="dropdown-item" data-map-export="json"><i class="ti ti-braces" aria-hidden="true"></i> JSON</button></li>
				</ul>
			</div>
		</div>
		<div id="hitsList"></div>
		<a id="hitsOpenList" class="d-block text-center small mt-3" href="#" data-url="@Url.Action("List", "Resource")">Åpne i Ressursoversikt ↗</a>
	</div>
	<div id="resourcePanelPick" class="px-3 pt-2" hidden></div>
	<iframe id="resourcePanelFrame" title="Ressurs" hidden></iframe>
	<iframe id="needPanelFrame" title="Behov" hidden></iframe>
</aside>
@* A short message at the bottom after you choose a resource (gone after 3 seconds) *@
<div id="mapToast" class="map-toast" role="status" aria-live="polite" hidden></div>
@* Phones: the choices for a clicked point as a sheet from the bottom, like Google Maps (help with AI) *@
<div id="mapSheet" class="map-sheet" role="dialog" aria-label="Valg for punktet på kartet" hidden>
	<div class="map-sheet-grip" aria-hidden="true"></div>
	<button type="button" id="mapSheetClose" class="btn-close map-sheet-close" aria-label="Lukk"></button>
	<div id="mapSheetBody"></div>
</div>

@* "Ressurser i området" at the bottom of the map: change the distance with the slider, the number, the quick buttons
   or the white dot on the edge of the circle. Shown when a point is chosen; "Ferdig" makes it small (updateRadiusBar below) *@
<div id="radiusBar" class="radius-bar" role="group" aria-labelledby="radiusBarTitle" hidden>
	<div class="d-flex align-items-center gap-2 mb-2">
		<i class="ti ti-map-pin" aria-hidden="true"></i>
		<strong id="radiusBarTitle">Ressurser i området</strong>
		<span id="radiusBarCount" class="ms-auto small text-body-secondary" aria-live="polite"></span>
	</div>
	<div class="d-flex align-items-center gap-2 mb-2">
		<label for="radiusSlider" class="small">Innen</label>
		<input type="range" id="radiusSlider" class="form-range flex-grow-1" min="0" max="1000" step="1" />
		<input type="number" id="radiusNumber" class="form-control form-control-sm" style="width: 5rem;" min="0.1" max="500" step="0.1" aria-label="Avstand i km" />
		<span class="small">km</span>
	</div>
	<div class="d-flex flex-wrap align-items-center gap-2">
		<span id="radiusChips" class="d-flex flex-wrap gap-2"></span>
		<button type="button" id="radiusRemove" class="btn btn-sm rf-reset ms-auto"><i class="ti ti-x" aria-hidden="true"></i> Fjern</button>
		<button type="button" id="radiusList" class="btn btn-sm rf-reset" onclick="showView('hits')"><i class="ti ti-list" aria-hidden="true"></i> Vis liste</button>
		<button type="button" id="radiusDone" class="btn btn-sm btn-success"><i class="ti ti-check" aria-hidden="true"></i> Ferdig</button>
	</div>
</div>
<button type="button" id="radiusBarSmall" class="radius-bar-small" hidden></button>

<style>

	/* The box with the number: green, white border, big enough to read and tap */
	.resource-cluster {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: #1e6447;
		color: #fff;
		font-weight: 700;
		font-size: 15px;
		border: 3px solid #fff;
		box-shadow: 0 1px 4px rgba(0,0,0,.5);
	}

	
	/* Thin black outline around the resource icons, so they stand out on the map (only images, not the need squares) */
	.leaflet-marker-pane img.leaflet-marker-icon {
		filter: drop-shadow(0 0 1px #000) drop-shadow(0 0 1px #000);
	}
	/* The side panel: on the left, under the menu, like Google Maps. Colours follow light/dark mode */
	.side-panel {
		position: fixed;
		left: 0;
		bottom: 0;
		top: 76px;
		width: min(420px, 100vw);
		z-index: 1000;
		display: flex;
		flex-direction: column;
		background: var(--bs-body-bg);
		border-right: 1px solid var(--bs-border-color);
		box-shadow: 4px 0 16px rgba(0,0,0,.25);
	}

		.side-panel[hidden], .side-panel iframe[hidden], .side-panel-list[hidden] {
			display: none;
		}

	.side-panel-head {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 8px 12px;
		border-bottom: 1px solid var(--bs-border-color);
	}

	.side-panel iframe {
		flex: 1;
		width: 100%;
		border: 0;
	}

	.side-panel-list {
		flex: 1;
		overflow-y: auto;
		padding: 8px 12px;
	}

	/* The handle on the right edge of the side panel */
	.side-panel-resize {
		position: absolute;
		right: -4px;
		top: 0;
		bottom: 0;
		width: 8px;
		cursor: ew-resize;
		z-index: 1;
	}

		.side-panel-resize:hover, .side-panel-resize:focus-visible, .side-panel.resizing .side-panel-resize {
			background: var(--hv-link);
			outline: none;
		}
	/* While dragging, the page in the panel must not catch the mouse */
	.side-panel.resizing iframe {
		pointer-events: none;
	}
	/* The map fills the screen under the menu, without scrolling. The footer is hidden on this page */
	body:has(#map) {
		overflow: hidden;
		margin-bottom: 0;
	}

		body:has(#map) footer {
			display: none;
		}

	#map {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		height: calc(100dvh - 76px); /* reserve, before JavaScript has measured the menu */
		min-height: 300px;
		z-index: 1 !important;
	}

	.need-marker {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 26px;
		height: 26px;
		border-radius: 5px;
		font-weight: 700;
		font-size: 13px;
		color: #fff;
		border: 2px solid #fff;
		box-shadow: 0 1px 3px rgba(0,0,0,.4);
	}

	.need-akutt {
		background: #E24B4A;
	}

	.need-planlagt {
		background: #FFC107; /* yellow = planlagt behov, like in the case */
		color: #412402;
		border-color: #7A5200;
	}

	.need-label {
		background: transparent;
		border: 0;
		box-shadow: none;
		font-weight: 700;
		font-size: 12px;
		white-space: nowrap;
	}

		.need-label.akutt {
			color: #E24B4A;
		}

		.need-label.planlagt {
			color: #7A5200;
		}

	/* Click on the map (help with AI): the address, three round buttons with text under, and what is near, like Google Maps */
	.point-menu {
		min-width: 230px;
	}

	.point-addr {
		font-weight: 600;
		padding-right: 18px;
	}

	.point-sub {
		min-height: 1em;
		margin-bottom: 10px;
		font-size: .8rem;
		color: var(--bs-secondary-color);
	}

	.point-buttons {
		display: flex;
		justify-content: space-around;
		gap: 6px;
	}

	.point-btn {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		font-size: .8rem;
		color: var(--bs-body-color) !important;
		text-decoration: none;
	}

	.point-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		font-size: 20px;
		transition: transform .1s;
	}

	.point-btn:hover .point-icon, .point-btn:focus-visible .point-icon {
		transform: scale(1.08);
	}

	.point-btn.is-need .point-icon {
		background: var(--bs-danger-bg-subtle);
		color: var(--bs-danger-text-emphasis);
	}

	.point-btn.is-resource .point-icon {
		background: var(--bs-success-bg-subtle);
		color: var(--bs-success-text-emphasis);
	}

	.point-btn.is-area .point-icon {
		background: var(--bs-primary-bg-subtle);
		color: var(--bs-primary-text-emphasis);
	}

	.point-near {
		margin-top: 10px;
		padding-top: 8px;
		border-top: 1px solid var(--bs-border-color);
		font-size: .8rem;
		color: var(--bs-secondary-color);
		text-align: center;
	}

	/* Phones: the same as a sheet from the bottom */
	.map-sheet {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1060;
		padding: 8px 16px 20px;
		background: var(--bs-body-bg);
		color: var(--bs-body-color);
		border-radius: 16px 16px 0 0;
		box-shadow: 0 -4px 16px rgba(0,0,0,.3);
	}

		.map-sheet[hidden] {
			display: none;
		}

	.map-sheet-grip {
		width: 40px;
		height: 4px;
		margin: 0 auto 10px;
		border-radius: 2px;
		background: var(--bs-border-color);
	}

	.map-sheet-close {
		position: absolute;
		top: 12px;
		right: 12px;
	}

	/* Liste | Filter in the panel head (help with AI): the two tabs share the width, and ✕ has its own box on the right */
	.side-panel-head.tabbed {
		padding: 0;
		gap: 0;
	}

	.panel-tabs {
		display: flex;
		flex: 1;
		align-self: stretch;
	}

	.panel-tab {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 10px 0;
		border: 0;
		border-bottom: 2px solid transparent;
		background: none;
		color: var(--bs-secondary-color);
		font-weight: 500;
	}

		.panel-tab + .panel-tab {
			border-left: 1px solid var(--bs-border-color);
		}

		.panel-tab.active {
			color: var(--bs-body-color);
			border-bottom-color: var(--hv-green);
		}

		.panel-tab:focus:not(:focus-visible) {
			outline: none; /* no frame after a mouse click, still there with the keyboard (Tab) */
		}

		.panel-tab .badge {
			background: var(--bs-secondary-bg);
			color: var(--bs-body-color);
		}

		.panel-tab.active .badge {
			background: var(--hv-green);
			color: #fff;
		}

	.side-panel-head.tabbed .btn-close {
		align-self: stretch;
		width: 44px;
		height: auto;
		border-left: 1px solid var(--bs-border-color);
		border-radius: 0;
	}

	.hit-group {
		font-size: .8rem;
		font-weight: 600;
		color: var(--bs-secondary-color);
		margin: 12px 0 6px;
	}

	.hit-row {
		display: flex;
		gap: 10px;
		align-items: center;
		width: 100%;
		text-align: left;
		margin-bottom: 6px;
		padding: 8px 10px;
		border: 1px solid var(--bs-border-color);
		border-radius: 8px;
		background: var(--bs-body-bg);
		color: inherit;
	}

		.hit-row:hover {
			background: var(--bs-secondary-bg);
		}

	.hit-text {
		flex: 1;
		min-width: 0;
	}

	.hit-name, .hit-sub {
		display: block;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.hit-name {
		font-weight: 600;
	}

	.hit-sub {
		font-size: .85rem;
		color: color-mix(in srgb, var(--bs-body-color) 78%, transparent);
	}
	/* Need mode: the top of the panel is yellow, and an info box says what to do and what the rings mean (text + icon, not only colour) */
	.need-mode-info {
		background: #ffc107;
		color: #000;
		padding: 8px 12px;
		border-bottom: 1px solid rgba(0,0,0,.15);
		font-size: .9rem;
	}

		.need-mode-info[hidden] {
			display: none;
		}

	.need-mode-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 4px;
	}

	.ring-dot {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 18px;
		height: 18px;
		margin-right: 6px;
		vertical-align: middle;
		border-radius: 50%;
		border: 3px solid #639922;
		font-size: 10px;
		font-weight: 700;
	}

		.ring-dot.ring-picked {
			border-color: #378ADD;
			background: rgba(55,138,221,.35);
		}

	.side-panel.need-mode .side-panel-head {
		background: #ffc107;
		color: #000;
		border-bottom-color: rgba(0,0,0,.15);
	}

	/* "Åpne på egen side": the button and ✕ sit together on the right */
	.panel-full-btn {
		white-space: nowrap;
	}

		.panel-full-btn:not([hidden]) + .btn-close {
			margin-left: 0 !important;
		}

	.side-panel.need-mode .panel-full-btn {
		border-color: rgba(0,0,0,.45);
	}

		.side-panel.need-mode .panel-full-btn:hover {
			background: rgba(0,0,0,.1);
			color: #000;
		}

	.side-panel.need-mode .side-panel-head a, .side-panel.need-mode .side-panel-head .btn-link {
		color: #000;
	}

	.side-panel.need-mode .side-panel-head .btn-close {
		filter: none; /* the black ✕, also in dark mode */
	}
	/* The ✓ on a chosen resource in need mode */
	.picked-check {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: #378ADD;
		color: #fff;
		font-weight: 700;
		font-size: 13px;
		border: 2px solid #fff;
	}
	/* The short message at the bottom of the screen, like Google Maps */
	.map-toast {
		position: fixed;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1100;
		background: #212529;
		color: #fff;
		padding: 10px 18px;
		border-radius: 8px;
		box-shadow: 0 2px 10px rgba(0,0,0,.4);
	}

		.map-toast[hidden] {
			display: none;
		}
	/* "Ressurser i området" at the bottom of the map, and the small button after "Ferdig". Colours follow light/dark mode */
	.radius-bar, .radius-bar-small {
		position: fixed;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1050;
		background: var(--bs-body-bg);
		color: var(--bs-body-color);
		border: 1px solid var(--bs-border-color);
		box-shadow: 0 2px 12px rgba(0,0,0,.35);
	}

	.radius-bar {
		width: min(640px, calc(100vw - 24px));
		padding: 12px 16px;
		border-radius: 12px;
	}

	.radius-bar-small {
		padding: 8px 16px;
		border-radius: 999px;
		font-weight: 600;
	}

		.radius-bar[hidden], .radius-bar-small[hidden] {
			display: none;
		}

	.radius-chip {
		border: 1px solid var(--bs-border-color);
		border-radius: 999px;
		padding: 3px 12px;
		background: none;
		color: inherit;
	}

		.radius-chip.active {
			background: var(--bs-success-bg-subtle);
			border-color: var(--bs-success-border-subtle);
			color: var(--bs-success-text-emphasis);
			font-weight: 600;
		}

	/* The white dot on the edge of the circle: drag it to change the distance */
	.radius-handle {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: #fff;
		border: 4px solid #3388ff;
		box-shadow: 0 1px 4px rgba(0,0,0,.5);
		cursor: ew-resize;
	}
	/* + −, Filter and the chips in one row at the top left, like Google Maps */
	.leaflet-top.leaflet-left {
		display: flex;
		align-items: flex-start;
		right: 0;
	}
	/* Tegnforklaring nede til høyre; colours follow light/dark mode */
	.map-legend {
		background: var(--bs-body-bg);
		color: var(--bs-body-color);
		border-radius: 8px;
		padding: 6px 10px;
		box-shadow: 0 1px 6px rgba(0,0,0,.35);
		font-size: .85rem;
		line-height: 1.7;
		max-width: 240px;
	}

		.map-legend summary {
			cursor: pointer;
			font-weight: 600;
		}

	.map-legend-title {
		margin-top: 6px;
		color: var(--bs-secondary-color);
	}

	.legend-dot, .legend-square, .legend-circle, .legend-cluster {
		display: inline-block;
		vertical-align: middle;
		margin-right: 8px;
		width: 14px;
		height: 14px;
	}

	.legend-dot {
		border-radius: 50%;
		border: 1px solid #000;
	}

	.legend-square {
		border-radius: 3px;
		border: 2px solid #fff;
	}

	.legend-circle {
		border-radius: 50%;
		border: 2px dashed #E24B4A;
	}

	.legend-cluster {
		border-radius: 50%;
		background: #1e6447;
		color: #fff;
		font-size: 9px;
		text-align: center;
		line-height: 14px;
		font-weight: 700;
	}

	.legend-pin, .legend-img {
		display: inline-block;
		vertical-align: middle;
		margin-right: 8px;
	}

	.legend-pin {
		margin-left: 1px;
	}

	.legend-return {
		display: inline-block;
		vertical-align: middle;
		width: 16px;
		height: 16px;
		margin-right: 6px;
		border-radius: 50%;
		background: #7F77DD;
		color: #fff;
		font-size: 11px;
		line-height: 16px;
		text-align: center;
	}

	.legend-line {
		display: inline-block;
		vertical-align: middle;
		width: 22px;
		margin-right: 8px;
		border-top: 2px dashed #378ADD;
	}

	/* "Endre ressurs" in the panel, step 3: the line at the top of the map, and the other markers faded and not clickable */
	.place-bar {
		position: absolute;
		top: 12px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1000;
		background: #1e6447;
		color: #fff;
		font-weight: 600;
		padding: 6px 16px;
		border-radius: 999px;
		box-shadow: 0 1px 6px rgba(0,0,0,.35);
		pointer-events: none;
	}

	#map.place-mode .leaflet-marker-icon:not(.place-pin) {
		opacity: .45;
		pointer-events: none;
	}

	.place-pin:focus {
		outline: none;
	}

	/* "Meld behov" in the side panel: the stripe is purple while the kontaktpunkt is chosen */
	.place-bar.is-meeting {
		background: #7A5AF8;
	}

	/* The resource pins (resourcePin below): green = ledig now, grey = not ledig now; the white icon is the type's own icon */
	.resource-pin svg {
		position: absolute;
		inset: 0;
		fill: #2f8a3a;
		stroke: #fff;
		stroke-width: 2;
		filter: drop-shadow(0 1px 2px rgba(0,0,0,.5));
		z-index: 0; /* Leaflet gives every svg on the map z-index 200; ours must stay under the icon */
	}

	.resource-pin-busy svg {
		fill: #888780;
	}

	.resource-pin i {
		position: absolute;
		left: 0;
		right: 0;
		top: 7px;
		text-align: center;
		color: #fff;
		font-size: 18px;
		z-index: 1; /* on top of the green shape */
		display: block;
		line-height: 1;
	}

	/* "Lever tilbake": a purple ring, a ↩︎ badge and a name tag, so it is easy to see (icon + text, not colour alone) */
	.resource-pin-return::before {
		content: "";
		position: absolute;
		left: -10px;
		top: -11px;
		width: 56px;
		height: 56px;
		border-radius: 50%;
		border: 2px dashed #7F77DD;
		background: rgba(127,119,221,.18);
	}

	.return-badge, .return-tag {
		position: absolute;
		z-index: 2;
	}

	.return-badge {
		right: -9px;
		top: -8px;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: #7F77DD;
		color: #fff;
		border: 2px solid #fff;
		font-size: 12px;
		line-height: 16px;
		text-align: center;
	}

	.return-tag {
		top: 48px;
		left: 50%;
		transform: translateX(-50%);
		white-space: nowrap;
		background: #fff;
		color: #3C3489;
		font-size: 11px;
		font-weight: 700;
		padding: 0 5px;
		border-radius: 4px;
		box-shadow: 0 1px 3px rgba(0,0,0,.3);
	}

	/* "↩︎ 2 skal leveres tilbake" next to Filter */
	.return-chip {
		margin-left: 8px;
		padding: 6px 14px;
		border: 0;
		border-radius: 999px;
		background: #7F77DD;
		color: #fff;
		font-weight: 600;
		box-shadow: 0 1px 6px rgba(0,0,0,.35);
	}

		.return-chip[hidden] {
			display: none;
		}

	/* Over "Liste" (help with AI): what the list is limited to, as chips you can remove with ✕ */
	.hits-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 8px 0 4px;
	}

	.hits-chip {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 3px 8px 3px 10px;
		border: 1px solid var(--bs-primary-border-subtle);
		border-radius: 999px;
		background: var(--bs-primary-bg-subtle);
		color: var(--bs-primary-text-emphasis);
		font-size: .85rem;
	}

	/* The grip is only used on phones */
	.side-panel-grip {
		display: none;
	}

	/* Phones (help with AI): the side panel is one sheet at the bottom, like Google Maps. Three heights:
		   Liten (.is-small), Halv (no class) and Full (.is-full). "Ressurser i området" moves into the Filter tab while the sheet is open
		   Docs: CSS dvh units (MDN) - https://developer.mozilla.org/docs/Web/CSS/length#dynamic_viewport_units */
	@@media (max-width: 767.98px) {
		.side-panel {
			top: auto !important;
			left: 0;
			right: 0;
			width: 100% !important;
			height: 50dvh;
			border-right: 0;
			border-radius: 16px 16px 0 0;
			box-shadow: 0 -4px 16px rgba(0,0,0,.3);
			transition: height .2s;
		}

			.side-panel.is-full {
				height: calc(100dvh - var(--map-top, 76px));
				border-radius: 0;
			}
			/* Liten: the tabs, "Ressurser i området" and a bit of what is under, so you see that you can scroll (height set by JS) */
			.side-panel.is-small {
				height: var(--sheet-small, 35dvh);
			}

			.side-panel.dragging {
				transition: none;
			}

				.side-panel.dragging iframe {
					pointer-events: none;
				}

		.side-panel-resize {
			display: none;
		}

		.side-panel-grip {
			display: flex;
			justify-content: center;
			width: 100%;
			padding: 8px 0 4px;
			border: 0;
			border-radius: 16px 16px 0 0;
			background: none;
			touch-action: none; /* the finger drags the sheet, the page does not scroll */
			cursor: grab;
		}

			.side-panel-grip span {
				width: 40px;
				height: 4px;
				border-radius: 2px;
				background: var(--bs-secondary-color);
			}

		.side-panel.need-mode .side-panel-grip {
			background: #ffc107;
		}
		/* Phones: "Ressurser i området" is only in the Filter tab, never over the map (the circle and the white dot are still on the map).
			   The legend is hidden while the sheet is open, since it would be under it */
		.radius-bar:not(.in-panel), .radius-bar-small {
			display: none;
		}

		body.map-panel-open .map-legend {
			display: none;
		}

		.radius-bar.in-panel {
			position: static;
			transform: none;
			width: auto;
			margin-bottom: 12px;
			box-shadow: none;
		}
			/* The tabs are right above it, so "Vis liste" and "Ferdig" are not needed there */
			.radius-bar.in-panel #radiusList, .radius-bar.in-panel #radiusDone {
				display: none;
			}
	}
</style>

@section Scripts {
	<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
	<script src="~/js/resource-filter.js" asp-append-version="true"></script>
	<script src="~/js/resource-export.js" asp-append-version="true"></script>
	<script>
		// The group's PNG icons per type (old type names, so only the default pins showed). Replaced by resourcePin below,
		// which uses the type icons from the database. Kept as a comment until the group has seen it

		// 		var greenIcon = new L.Icon({
		// 			iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-green.png',
