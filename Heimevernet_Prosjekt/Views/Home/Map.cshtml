@model Heimevernet_Prosjekt.Models.PositionModel
@using Heimevernet_Prosjekt.Security.Authorization
@{
	var canNeeds = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Operator);
	var signedIn = User.Identity?.IsAuthenticated == true;
	ViewData["FilterOnMap"] = true;
	ViewData["FilterCanNeeds"] = canNeeds;
}

<div id="map"></div>
@* One side panel on the left, like Google Maps. It shows one thing at a time: a list (from a box), a resource or a need
   (the pages themselves with ?embed=1). While a need is open you can look at a resource and go back with ‹ *@
<aside id="sidePanel" class="side-panel" hidden aria-label="Sidepanel">
	@* Drag the right edge to change the width (also ← → with the keyboard) *@
	<div id="sidePanelResize" class="side-panel-resize" role="separator" aria-orientation="vertical"
		 aria-label="Endre bredden på panelet" tabindex="0"></div>
	<div class="side-panel-head">
		<button type="button" id="sidePanelBack" class="btn btn-sm btn-link p-0" hidden onclick="sidePanelBack()"></button>
		<span id="sidePanelTitle" class="small fw-semibold"></span>
		<a id="sidePanelFull" href="#" class="small" hidden>Åpne på egen side ↗</a>
		<button type="button" class="btn-close ms-auto" onclick="closeSidePanel()" aria-label="Lukk panelet"></button>
	</div>
	@* Need mode: what you are doing, and what the rings on the map mean (text + icon, not only colour) *@
	<div id="needModeInfo" class="need-mode-info" role="status" hidden>
		<div>🎯 Klikk på en ressurs på kartet for å velge den til <strong id="needModeName"></strong></div>
		<div class="need-mode-legend">
			<span><span class="ring-dot" aria-hidden="true"></span>Kan velges</span>
			<span><span class="ring-dot ring-picked" aria-hidden="true">✓</span>Valgt</span>
		</div>
	</div>
	<div id="filterPanelBody" class="side-panel-list" hidden>
		<partial name="_ResourceFilter" />
	</div>
	<div id="resourcePanelPick" class="px-3 pt-2" hidden></div>
	<div id="resourcePanelList" class="side-panel-list" hidden></div>
	<iframe id="resourcePanelFrame" title="Ressurs" hidden></iframe>
	<iframe id="needPanelFrame" title="Behov" hidden></iframe>
</aside>
@* A short message at the bottom after you choose a resource (gone after 3 seconds) *@
<div id="mapToast" class="map-toast" role="status" aria-live="polite" hidden></div>

<style>

	/* The box with the number: green, white border, big enough to read and tap */
	.resource-cluster {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: #1e6447;
		color: #fff;
		font-weight: 700;
		font-size: 15px;
		border: 3px solid #fff;
		box-shadow: 0 1px 4px rgba(0,0,0,.5);
	}

	
	/* Thin black outline around the resource icons, so they stand out on the map (only images, not the need squares) */
	.leaflet-marker-pane img.leaflet-marker-icon {
		filter: drop-shadow(0 0 1px #000) drop-shadow(0 0 1px #000);
	}
	/* The side panel: on the left, under the menu, like Google Maps. Colours follow light/dark mode */
	.side-panel {
		position: fixed;
		left: 0;
		bottom: 0;
		top: 76px;
		width: min(420px, 100vw);
		z-index: 1000;
		display: flex;
		flex-direction: column;
		background: var(--bs-body-bg);
		border-right: 1px solid var(--bs-border-color);
		box-shadow: 4px 0 16px rgba(0,0,0,.25);
	}

		.side-panel[hidden], .side-panel iframe[hidden], .side-panel-list[hidden] {
			display: none;
		}

	.side-panel-head {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 8px 12px;
		border-bottom: 1px solid var(--bs-border-color);
	}

	.side-panel iframe {
		flex: 1;
		width: 100%;
		border: 0;
	}

	.side-panel-list {
		flex: 1;
		overflow-y: auto;
		padding: 8px 12px;
	}

	/* The handle on the right edge of the side panel */
	.side-panel-resize {
		position: absolute;
		right: -4px;
		top: 0;
		bottom: 0;
		width: 8px;
		cursor: ew-resize;
		z-index: 1;
	}

		.side-panel-resize:hover, .side-panel-resize:focus-visible, .side-panel.resizing .side-panel-resize {
			background: var(--hv-link);
			outline: none;
		}
	/* While dragging, the page in the panel must not catch the mouse */
	.side-panel.resizing iframe {
		pointer-events: none;
	}
	/* The map fills the screen under the menu, without scrolling. The footer is hidden on this page */
	body:has(#map) {
		overflow: hidden;
		margin-bottom: 0;
	}

		body:has(#map) footer {
			display: none;
		}

	#map {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		height: calc(100dvh - 76px); /* reserve, before JavaScript has measured the menu */
		min-height: 300px;
		z-index: 1 !important;
	}

	.need-marker {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 26px;
		height: 26px;
		border-radius: 5px;
		font-weight: 700;
		font-size: 13px;
		color: #fff;
		border: 2px solid #fff;
		box-shadow: 0 1px 3px rgba(0,0,0,.4);
	}

	.need-akutt {
		background: #E24B4A;
	}

	.need-planlagt {
		background: #378ADD;
	}

	.need-label {
		background: transparent;
		border: 0;
		box-shadow: none;
		font-weight: 700;
		font-size: 12px;
		white-space: nowrap;
	}

		.need-label.akutt {
			color: #E24B4A;
		}

		.need-label.planlagt {
			color: #378ADD;
		}

	.map-menu a {
		display: block;
		padding: 4px 0;
	}

	.resource-row {
		display: flex;
		gap: 10px;
		align-items: center;
		width: 100%;
		text-align: left;
		border: 0;
		border-bottom: 1px solid var(--bs-border-color);
		background: none;
		color: inherit;
		padding: 10px 4px;
	}

		.resource-row:hover {
			background: var(--bs-secondary-bg);
		}

	.type-chip {
		border: 1px solid var(--bs-border-color);
		border-radius: 999px;
		padding: 3px 10px;
		background: none;
		color: inherit;
		font-size: .85rem;
	}

		.type-chip.active {
			background: var(--hv-green);
			color: #fff;
			border-color: var(--hv-green);
		}
	/* Need mode: the top of the panel is yellow, and an info box says what to do and what the rings mean (text + icon, not only colour) */
	.need-mode-info {
		background: #ffc107;
		color: #000;
		padding: 8px 12px;
		border-bottom: 1px solid rgba(0,0,0,.15);
		font-size: .9rem;
	}

		.need-mode-info[hidden] {
			display: none;
		}

	.need-mode-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 4px;
	}

	.ring-dot {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 18px;
		height: 18px;
		margin-right: 6px;
		vertical-align: middle;
		border-radius: 50%;
		border: 3px solid #639922;
		font-size: 10px;
		font-weight: 700;
	}

		.ring-dot.ring-picked {
			border-color: #378ADD;
			background: rgba(55,138,221,.35);
		}

	.side-panel.need-mode .side-panel-head {
		background: #ffc107;
		color: #000;
		border-bottom-color: rgba(0,0,0,.15);
	}

		.side-panel.need-mode .side-panel-head a, .side-panel.need-mode .side-panel-head .btn-link {
			color: #000;
		}

		.side-panel.need-mode .side-panel-head .btn-close {
			filter: none; /* the black ✕, also in dark mode */
		}
	/* The ✓ on a chosen resource in need mode */
	.picked-check {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: #378ADD;
		color: #fff;
		font-weight: 700;
		font-size: 13px;
		border: 2px solid #fff;
	}
	/* The short message at the bottom of the screen, like Google Maps */
	.map-toast {
		position: fixed;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1100;
		background: #212529;
		color: #fff;
		padding: 10px 18px;
		border-radius: 8px;
		box-shadow: 0 2px 10px rgba(0,0,0,.4);
	}

		.map-toast[hidden] {
			display: none;
		}
</style>

@section Scripts {
	<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
	<script src="~/js/resource-filter.js" asp-append-version="true"></script>
	<script>
		// 		@*Ikoner til default*@
		var greenIcon = new L.Icon({
			iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-green.png',
			shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
			iconSize: [25, 41],
			iconAnchor: [12, 41],
			popupAnchor: [1, -34]
		});

		var yellowIcon = new L.Icon({
			iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-yellow.png',
			shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
			iconSize: [25, 41],
			iconAnchor: [12, 41],
			popupAnchor: [1, -34]
		});

		var redIcon = new L.Icon({
			iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png',
			shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
			iconSize: [25, 41],
			iconAnchor: [12, 41],
			popupAnchor: [1, -34]
		});

		var greyIcon = new L.Icon({
			iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-grey.png',
			shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
			iconSize: [25, 41],
			iconAnchor: [12, 41],
			popupAnchor: [1, -34]
		});


		function getDefaultMarker(status) {

			switch (status) {

				case "Opptatt":
					return yellowIcon;

				case "Ugyldig":
					return redIcon;

				default:
					return greenIcon;
			}
		}

		function getResourceIcon(type, status) {

			//bilder legges inn i wwwroot/images/resource-icons/ med navn som "tools-ledig.png", "vehicle-opptatt.png" osv. altså (type-status.png)
			var typeMap = {
				"Verktøy og utstyr": "tools",
				"Motoriserte kjøretøy": "vehicle",
				"Husly og bygg": "shelter",
				// "Materialer og forsyninger": "supplies",		//Har ikke ikon enda så bruker default for nå
				"Sikkerhet og medisinsk": "medical"
			};
			// "Ikke tilgjengelig" (e.g. at the workshop): always a grey marker, whatever the type
			if (status === "Ikke tilgjengelig") {
				return greyIcon;
			}

			var iconType = typeMap[type];

			if (!iconType) {
				return getDefaultMarker(status);
			}

			var iconStatus = (status || "Ledig")
				.toLowerCase()
				.replace("ø", "o");

			return L.icon({
				iconUrl: `/images/resource-icons/${iconType}-${iconStatus}.png`,
				iconSize: [36, 36],
				iconAnchor: [18, 36],
				popupAnchor: [0, -36]
			});
		}
		// Initialize the map and set its view to a specific location and zoom level
		var map = L.map('map').setView([58.14671, 7.9956], 13); // Coordinates for Kristiansand. 13 stands for zoom level.

		// The map pictures come from wwwroot/js/map-style.js (Kartverket or OpenStreetMap, chosen in the account menu)
		addMapPictures(map);

		// Exact height: the window minus the menu, also when the window changes size (help with AI)
		// Docs: Leaflet invalidateSize - https://leafletjs.com/reference.html#map-invalidatesize
		function fitMapToScreen() {
			var headerHeight = document.querySelector('header').offsetHeight;
			document.getElementById('map').style.height = (window.innerHeight - headerHeight) + 'px';
			map.invalidateSize();
		}
		window.addEventListener('resize', fitMapToScreen);
		fitMapToScreen();

		// Markers are kept in one layer so they can be removed before a new search; the circle shows the radius - Docs: Leaflet API reference (LayerGroup, Circle)
		// https://leafletjs.com/reference.html
		// Markers close together become a box with the number. Click the box: a list of what is in it (help with AI)
		var markerLayer = L.markerClusterGroup({
			zoomToBoundsOnClick: false,
			showCoverageOnHover: false,
			disableClusteringAtZoom: 16,
			iconCreateFunction: function (cluster) {
				var n = cluster.getChildCount();
				return L.divIcon({
					html: `<div class="resource-cluster" aria-label="${n} ressurser">${n}</div>`,
					className: '',
					iconSize: [44, 44]
				});
			}
		}).addTo(map);
		var markersById = {};
		var radiusCircle = null;
		var detailUrl = '@Url.Content("~/Resource/Index/")';

		// Text from users is escaped before it goes into the popup, so HTML in a name can't run as code (XSS)
		function escapeHtml(text) {
			var div = document.createElement('div');
			div.textContent = text || '';
			return div.innerHTML;
		}

		//Ressurser hentes fra databasen og legges til på kartet som markører.
		// params can contain search, type, lat, lng and radius (sent to MapResources in ResourceController)
		function loadResources(params) {
			return fetch('@Url.Action("MapResources", "Resource")' + '?' + new URLSearchParams(params))
				.then(response => response.json())
				.then(resources => {

					console.log("Ressurser hentet:", resources);
					markerLayer.clearLayers();
					markersById = {};
					var markers = [];
					// The filter: type and status are chosen here; search and distance are done by the server
					if (window.ResourceFilter) ResourceFilter.render(resources, params);
					resources = resources.filter(function (r) { return !window.ResourceFilter || ResourceFilter.matches(r, params); });

					for (const resource of resources) {

						var lat = parseFloat(resource.latitude);
						var lng = parseFloat(resource.longitude);

						// Kontroller at koordinatene er gyldige
						if (isNaN(lat) || isNaN(lng)) {
							console.warn("Ugyldige koordinater:", resource);
							return;
						}

						var icon = getResourceIcon(
							resource.type,
							resource.status
						);

						var marker = L.marker([lat, lng], { icon: icon }).addTo(markerLayer);

						// Hover: the name. Click: the resource in the panel on the left (like Google Maps)
						marker.bindTooltip(escapeHtml(resource.name), { direction: 'top', offset: [0, -34] });
						marker.on('click', function () { openResource(resource.id); });
						markers.push(marker);
						markersById[resource.id] = marker;
						marker.resource = resource;
					}
					if (needMode) showNeedMode();
					return markers;
				})
				.catch(error => {
					console.error("Feil ved henting av ressurser:", error);
					return [];
				});
		}

		var canNeeds = @(canNeeds ? "true" : "false");
		var needLayer = L.layerGroup();
		var needDetailUrl = '@Url.Content("~/ResourceNeed/Index/")';
		var needCreateUrl = '@Url.Action("Create", "ResourceNeedHandler")';

		function shortDate(utc) {
			if (!utc) return '';
			var date = new Date(utc.endsWith('Z') ? utc : utc + 'Z');
			return date.toLocaleDateString('nb-NO', { day: '2-digit', month: '2-digit', timeZone: 'Europe/Oslo' });
		}

		function loadNeeds() {
			if (!canNeeds) return Promise.resolve();
			return fetch('@Url.Action("MapResourceNeeds", "ResourceNeed")')
				.then(response => response.ok ? response.json() : [])
				.then(needs => {
					needLayer.clearLayers();
					if (document.getElementById('rfNeedsCount')) document.getElementById('rfNeedsCount').textContent = needs.length;
					needs.forEach(need => {
						var lat = parseFloat(need.latitude);
						var lng = parseFloat(need.longitude);
						if (isNaN(lat) || isNaN(lng)) return;

						var planned = need.urgency === 'Planlagt';
						var colour = planned ? '#378ADD' : '#E24B4A';
						var label = planned ? 'Planlagt ' + shortDate(need.neededFrom) : 'AKUTT';

						// The circle; bubblingMouseEvents: false so a click on it doesn't open the click menu as well
						L.circle([lat, lng], {
							radius: need.radiusKm * 1000,
							color: colour,
							weight: 3,
							dashArray: planned ? '2 6' : '8 6',
							fillOpacity: 0.08,
							bubblingMouseEvents: false
						}).addTo(needLayer);

						// Name and AKUTT/Planlagt as text above the square - Docs: Leaflet DivIcon
						L.marker([lat, lng], {
							icon: L.divIcon({
								className: 'need-label ' + (planned ? 'planlagt' : 'akutt'),
								html: '<span style="display:inline-block;transform:translateX(-50%);background:rgba(255,255,255,.85);padding:0 4px;border-radius:4px;">'
									+ escapeHtml(need.name) + ' · ' + escapeHtml(label) + '</span>',
								iconSize: null,
								iconAnchor: [0, 38]
							}),
							interactive: false
						}).addTo(needLayer);

						// Hover: the name and what is needed. Click: the need opens in the side panel, like a resource
						var items = need.items.map(i => `${i.quantity} × ${escapeHtml(i.type)}`).join('<br>');
						L.marker([lat, lng], {
							icon: L.divIcon({
								className: '',
								html: `<div class="need-marker ${planned ? 'need-planlagt' : 'need-akutt'}" aria-label="${escapeHtml(need.name)}: ${need.count} trengs">${need.count}</div>`,
								iconSize: [26, 26],
								iconAnchor: [13, 13]
							}),
							keyboard: true
						})
							.bindTooltip(`<strong>${escapeHtml(need.name)}</strong> · ${escapeHtml(label)}<br>${items}`, { direction: 'top', offset: [0, -14] })
							.on('click', function () { openNeedPanel(needDetailUrl + need.id, [lat, lng]); })
							.addTo(needLayer);
					});
				})
				.catch(error => console.error("Feil ved henting av behov:", error));
		}

		if (canNeeds) {
			loadNeeds();
		}

		window.onResourceSearch = async function (params) {
			var statusText = document.getElementById('globalSearchStatus');
			applyLayerChoices(params);

			// The circle: the chosen place in the middle, with the radius in km
			if (radiusCircle) {
				map.removeLayer(radiusCircle);
				radiusCircle = null;
			}
			if (params.lat && params.lng && params.radius) {
				radiusCircle = L.circle([parseFloat(params.lat), parseFloat(params.lng)], { radius: params.radius * 1000 }).addTo(map);
			}

			var markers = await loadResources(params);
			document.getElementById('rfResourcesCount').textContent = markers.length;

			// Only type/status chosen (no search or place): the map stays where it is, so it doesn't jump on every tick
			if (!params.search && !params.lat) {
				if (statusText) statusText.textContent = '';
				return;
			}

			if (statusText) {
				var found = markers.length === 1 ? '1 ressurs' : markers.length + ' ressurser';
				var radiusText = parseFloat(params.radius) < 1 ? (params.radius * 1000) + ' m' : params.radius + ' km';
				statusText.textContent = params.lat ? found + ' innen ' + radiusText : found + ' funnet';
			}

			// Move the map: to the circle, so all results fit, or to the only result
			if (radiusCircle) {
				map.fitBounds(radiusCircle.getBounds());
			} else if (markers.length > 1) {
				map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [40, 40] });
			} else if (markers.length === 1) {
				map.setView(markers[0].getLatLng(), 16);
			}
			if (params.search && markers.length === 1) openResource(markers[0].resource.id); // not while you tick in the filter
		};

		window.onResourceSelected = async function (resource) {
			if (resource.latitude == null || resource.longitude == null) {
				window.location.href = detailUrl + resource.id;
				return;
			}
			if (radiusCircle) {
				map.removeLayer(radiusCircle);
				radiusCircle = null;
			}
			await loadResources({});
			map.setView([resource.latitude, resource.longitude], 16);
			openResource(resource.id);
		};

		// "Velg punkt på kartet" i filter
		var pickingCenter = false;
		window.startPickCenter = function (callback) {
			pickingCenter = true;
			map.getContainer().style.cursor = 'crosshair';
			map.once('click', function (e) {
				map.getContainer().style.cursor = '';
				callback(e.latlng.lat, e.latlng.lng);
				pickingCenter = false;
			});
		};

		var resourceCreateUrl = '@Url.Action("Create", "ResourceHandler")';
		var mapUrl = '@Url.Action("Map", "Home")';
		var signedIn = @(signedIn ? "true" : "false");

		map.on('click', function (e) {
			// Not while "Velg punkt på kartet" is choosing the centre of the filter
			if (pickingCenter || !signedIn) return;

			var lat = e.latlng.lat.toFixed(6);
			var lng = e.latlng.lng.toFixed(6);
			var radius = radiusCircle ? (radiusCircle.getRadius() / 1000) : 2;

			var links = '';
			if (canNeeds) {
				links += `<a href="${needCreateUrl}?lat=${lat}&lng=${lng}&radius=${radius}" onclick="return openNeedPanel(this.href);">+ Meld behov her</a>`;
			}
			links += `<a href="${resourceCreateUrl}?lat=${lat}&lng=${lng}">+ Registrer ressurs her</a>`;
			links += `<a href="${mapUrl}?lat=${lat}&lng=${lng}&radius=${radius}">Vis ressurser i området</a>`;

			L.popup()
				.setLatLng(e.latlng)
				.setContent(`<div class="map-menu">${links}</div>`)
				.openOn(map);
		});

		// ?focus=12 (from "Vis på hovedkartet"): zoom to that resource and open its popup
		var startParams = Object.fromEntries(new URLSearchParams(window.location.search));
		var focusId = startParams.focus;
		delete startParams.focus;
		window.onResourceSearch(startParams).then(function () {
			if (focusId && markersById[focusId]) {
				zoomToResource(focusId);
			}
		});

		
		// Open a need ("Meld behov" or an existing need) in the side panel (help with AI) - Docs: Window.postMessage (MDN)
		// https://developer.mozilla.org/docs/Web/API/Window/postMessage
		function openNeedPanel(url, latlng) {
			needLatLng = latlng || null; // where the need is, for the lines to the chosen resources
			exitNeedMode();
			needUrl = url;
			needTitle = '';
			resourceList = [];
			openResourceId = null;
			document.getElementById('needPanelFrame').src = url + (url.includes('?') ? '&' : '?') + 'embed=1';
			document.getElementById('sidePanelFull').href = url;
			showView('need');
			map.closePopup();
			return false; // don't follow the link, the panel shows the form instead
		}

		// The form in the panel tells us when it is saved or cancelled. Only messages from our own site are trusted
		window.addEventListener('message', function (e) {
			if (e.origin !== window.location.origin || !e.data) return;
			if (e.data.type === 'need-open') {
				needMode = { name: e.data.name, suggestions: e.data.suggestions || [], picked: e.data.picked || [] };
				needTitle = 'Du jobber med: ' + e.data.name;
				if (panelView === 'need') document.getElementById('sidePanelTitle').textContent = needTitle;
				showNeedMode();
				renderPick();
			}
			if (e.data.type === 'need-close') {
				closeSidePanel();
			}
			if (e.data.type === 'need-created') {
				closeSidePanel();
				loadNeeds(); // the new circle shows up right away
			}
		});

		// "Behovsmodus": while a need is open in the panel, the resources it can use get a ring,
		// the others are hidden, and the resource panel can choose them for the need (help with AI)
		// Docs: Leaflet CircleMarker - https://leafletjs.com/reference.html
		var needMode = null;
		var needModeLayer = L.layerGroup().addTo(map);

		function showNeedMode() {
			needModeLayer.clearLayers();
			Object.keys(markersById).forEach(function (id) {
				var marker = markersById[id];
				var rid = parseInt(id, 10);
				// Not in need mode: every resource is shown, as normal
				if (!needMode) { markerLayer.addLayer(marker); return; }
				var suggested = needMode.suggestions.includes(rid);
				var picked = needMode.picked.includes(rid);
				// In need mode: only the resources this need can use are shown, like a filter
				if (suggested) markerLayer.addLayer(marker); else markerLayer.removeLayer(marker);
				if (suggested) {
					// Green ring = can be chosen, blue filled = chosen (the side panel says it in text too)
					L.circleMarker(marker.getLatLng(), {
						radius: 20, weight: 3, interactive: false,
						color: picked ? '#378ADD' : '#639922',
						fillColor: '#378ADD', fillOpacity: picked ? 0.35 : 0
					}).addTo(needModeLayer);
					// Chosen: a ✓ on the resource too, so it doesn't rely on colour alone
					if (picked) {
						L.marker(marker.getLatLng(), {
							icon: L.divIcon({ className: '', html: '<div class="picked-check" aria-hidden="true">✓</div>', iconSize: [20, 20], iconAnchor: [-6, 46] }),
							interactive: false
						}).addTo(needModeLayer);
						if (needLatLng) L.polyline([marker.getLatLng(), needLatLng], { color: '#378ADD', weight: 2, dashArray: '6 6', interactive: false }).addTo(needModeLayer);
					}
				}
			});

			// Need mode is easy to see: the yellow top of the panel, and the info box with what the rings mean
			var info = document.getElementById('needModeInfo');
			info.hidden = !needMode;
			if (needMode) document.getElementById('needModeName').textContent = needMode.name;
			document.getElementById('sidePanel').classList.toggle('need-mode', !!needMode);
		}

		function exitNeedMode() {
			needMode = null;
			showNeedMode();
		}

		// Click on a box: a list of the resources in it, and "Zoom inn"
		var lastCluster = null;
		markerLayer.on('clusterclick', function (e) {
			lastCluster = e.layer;
			var count = e.layer.getChildCount();
			// Short and simple: the number and what you can do. The list comes in the side panel
			L.popup()
				.setLatLng(e.latlng)
				.setContent(`<strong>${count} ressurser her</strong>`
					+ `<div class="d-flex gap-2 mt-2">`
					+ `<button type="button" class="btn btn-sm btn-success" onclick="zoomToCluster();">🔍 Zoom inn</button>`
					+ `<button type="button" class="btn btn-sm btn-outline-secondary" onclick="showClusterList();">☰ Vis i lista</button>`
					+ `</div>`)
				.openOn(map);
		});

		// Zoom to the box: stop the popup's small pan first, then jump straight there.
		// Two animations at the same time made Leaflet skip loading map pictures (grey squares) (help with AI)
		// Docs: Leaflet Map stop / fitBounds - https://leafletjs.com/reference.html#map-stop
		function zoomToCluster() {
			if (!lastCluster) return;
			map.closePopup();
			map.stop();
			map.fitBounds(lastCluster.getBounds(), { padding: [40, 40], animate: false });
		}

		// Go to one resource, even if it is inside a box
		function zoomToResource(id) {
			var marker = markersById[id];
			if (!marker) return;
			map.closePopup();
			markerLayer.zoomToShowLayer(marker, function () { openResource(id); });
		}

		// The side panel on the left (help with AI): shows one view at a time - 'list' (from a box), 'resource' or 'need'.
		// The resource is its own page with ?embed=1, so it looks the same everywhere.
		// The need stays loaded in the background while you look at a resource, so "✓ Velg til …" still works
		var resourceList = [];      // the resources in the list (from a box)
		var resourceListType = '';  // the chosen type chip ('' = all)
		var openResourceId = null;
		var panelView = null;       // what the panel shows now (null = closed)
		var needUrl = null;         // the need that is open (null = none)
		var needLatLng = null;      // where the open need is on the map
		var needTitle = '';         // "Du jobber med: …"

		function showView(view) {
			panelView = view;
			var panel = document.getElementById('sidePanel');
			panel.style.top = document.querySelector('header').offsetHeight + 'px';
			panel.hidden = false;
			document.getElementById('resourcePanelList').hidden = view !== 'list';
			document.getElementById('resourcePanelFrame').hidden = view !== 'resource';
			document.getElementById('needPanelFrame').hidden = view !== 'need';
			document.getElementById('sidePanelFull').hidden = view !== 'need';
			document.getElementById('filterPanelBody').hidden = view !== 'filter';
			if (view === 'filter') document.getElementById('sidePanelTitle').textContent = 'Filter';
			if (view === 'need') document.getElementById('sidePanelTitle').textContent = needTitle;

			// ‹ back: from a resource to the list, or to the need you are working on
			var backTo = null;
			if (view === 'resource' && resourceList.length > 0) backTo = 'lista';
			else if (view !== 'need' && needUrl) backTo = 'behovet';
			var back = document.getElementById('sidePanelBack');
			back.hidden = !backTo;
			back.textContent = backTo ? '‹ Tilbake til ' + backTo : '';
			moveMapControls();
			renderPick();
		}

		function sidePanelBack() {
			if (panelView === 'resource' && resourceList.length > 0) showResourceList();
			else showView('need');
		}

		function openResource(id) {
			openResourceId = id;
			document.getElementById('resourcePanelFrame').src = detailUrl + id + '?embed=1';
			document.getElementById('sidePanelTitle').textContent = '';
			showView('resource');
		}

		function showClusterList() {
			if (!lastCluster) return;
			resourceList = lastCluster.getAllChildMarkers().map(function (m) { return m.resource; });
			resourceListType = '';
			map.closePopup();
			showResourceList();
		}

		function showResourceList() {
			openResourceId = null;
			document.getElementById('resourcePanelFrame').src = 'about:blank';
			showView('list');
			document.getElementById('sidePanelTitle').textContent = resourceList.length + ' ressurser her';
			var list = document.getElementById('resourcePanelList');

			// Type chips with the number: a filter for the list
			var counts = {};
			resourceList.forEach(function (r) { var t = r.type || 'Ukjent'; counts[t] = (counts[t] || 0) + 1; });
			var types = Object.keys(counts).sort();
			var chips = `<div class="d-flex flex-wrap gap-1 mb-2">`
				+ `<button type="button" class="type-chip ${resourceListType === '' ? 'active' : ''}" data-index="-1">Alle ${resourceList.length}</button>`
				+ types.map(function (t, i) {
					return `<button type="button" class="type-chip ${resourceListType === t ? 'active' : ''}" data-index="${i}">${escapeHtml(t)} ${counts[t]}</button>`;
				}).join('') + `</div>`;

			var rows = resourceList
				.filter(function (r) { return resourceListType === '' || (r.type || 'Ukjent') === resourceListType; })
				.map(function (r) {
					return `<button type="button" class="resource-row" data-id="${r.id}">`
						+ `<span class="flex-grow-1"><span class="fw-semibold d-block">${escapeHtml(r.name)}</span>`
						+ `<span class="small text-body-secondary">${escapeHtml(r.type)} · ${escapeHtml(r.status || 'Ledig')}</span></span>`
						+ `<span aria-hidden="true">›</span></button>`;
				}).join('');

			list.innerHTML = chips + rows;
			list.querySelectorAll('.type-chip').forEach(function (chip) {
				chip.addEventListener('click', function () {
					var i = parseInt(chip.dataset.index, 10);
					resourceListType = i < 0 ? '' : types[i];
					showResourceList();
				});
			});
			list.querySelectorAll('.resource-row').forEach(function (row) {
				row.addEventListener('click', function () { openResource(parseInt(row.dataset.id, 10)); });
			});
		}

		// ✕ or Esc: close the panel, and the need if one is open
		function closeSidePanel() {
			exitNeedMode();
			panelView = null;
			needUrl = null;
			needLatLng = null;
			resourceList = [];
			openResourceId = null;
			document.getElementById('sidePanel').hidden = true;
			moveMapControls();
			document.getElementById('resourcePanelFrame').src = 'about:blank';
			document.getElementById('needPanelFrame').src = 'about:blank';
		}

		// Need mode: the open resource can be chosen for the need that is open
		function renderPick() {
			var box = document.getElementById('resourcePanelPick');
			if (panelView !== 'resource' || !needMode || openResourceId == null || !needMode.suggestions.includes(openResourceId)) { box.hidden = true; return; }
			var picked = needMode.picked.includes(openResourceId);
			box.hidden = false;
			box.innerHTML = '';
			var button = document.createElement('button');
			button.type = 'button';
			button.className = 'btn w-100 ' + (picked ? 'btn-outline-secondary' : 'btn-success');
			button.textContent = (picked ? '✕ Fjern fra ' : '✓ Velg til ') + needMode.name;
			button.addEventListener('click', function () {
				document.getElementById('needPanelFrame').contentWindow.postMessage(
				{ type: 'need-pick', resourceId: openResourceId }, window.location.origin);
				var name = markersById[openResourceId] ? markersById[openResourceId].resource.name : 'Ressursen';
				showToast((picked ? '✕ ' + name + ' er fjernet fra ' : '✓ ' + name + ' er valgt til ') + needMode.name);
				showView('need'); // back to the need, so you see it ticked
			});
			box.appendChild(button);
		}

		// A short message at the bottom for 3 seconds (help with AI)
		var toastTimer = null;
		function showToast(text) {
			var toast = document.getElementById('mapToast');
			toast.textContent = text;
			toast.hidden = false;
			clearTimeout(toastTimer);
			toastTimer = setTimeout(function () { toast.hidden = true; }, 3000);
		}

		// Esc closes the side panel
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape' && panelView) closeSidePanel();
		});

		// The side panel's width: drag the right edge (or ← → on the keyboard).
		// The width is remembered (help with AI) - Docs: Pointer events (MDN) - https://developer.mozilla.org/docs/Web/API/Pointer_events
		function setPanelWidth(px) {
			var max = Math.max(320, window.innerWidth * 0.8);
			px = Math.min(Math.max(px, 320), max);
			document.getElementById('sidePanel').style.width = px + 'px';
			moveMapControls();
			try { localStorage.setItem('panelWidth', px); } catch (e) { }
		}

		function makeResizable(panel, handle) {
			handle.addEventListener('pointerdown', function (e) {
				e.preventDefault();
				panel.classList.add('resizing');
				function move(ev) { setPanelWidth(ev.clientX); }
				function up() {
					panel.classList.remove('resizing');
					window.removeEventListener('pointermove', move);
					window.removeEventListener('pointerup', up);
				}
				window.addEventListener('pointermove', move);
				window.addEventListener('pointerup', up);
			});
			// Keyboard: → makes it wider, ← narrower
			handle.addEventListener('keydown', function (e) {
				if (e.key === 'ArrowRight') { setPanelWidth(panel.offsetWidth + 40); e.preventDefault(); }
				if (e.key === 'ArrowLeft') { setPanelWidth(panel.offsetWidth - 40); e.preventDefault(); }
			});
		}

		makeResizable(document.getElementById('sidePanel'), document.getElementById('sidePanelResize'));
		try { var savedWidth = parseInt(localStorage.getItem('panelWidth'), 10); if (savedWidth) setPanelWidth(savedWidth); } catch (e) { }

		// The Filter button on the map, under + and −. It opens the filter in the side panel (help with AI)
		// Docs: Leaflet Control - https://leafletjs.com/reference.html#control
		var FilterControl = L.Control.extend({
			options: { position: 'topleft' },
			onAdd: function () {
				var button = L.DomUtil.create('button', 'btn btn-success shadow-sm d-flex align-items-center gap-2');
				button.type = 'button';
				button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5z" /></svg>'
					+ '<span>Filter</span><span id="rfCount" class="badge text-bg-light" hidden></span>';
				L.DomEvent.disableClickPropagation(button);
				L.DomEvent.on(button, 'click', function () {
					if (panelView === 'filter') closeSidePanel(); else showView('filter');
				});
				return button;
			}
		});
		new FilterControl().addTo(map);

		// + − and Filter move to the right of the side panel while it is open, so they are never hidden under it
		function moveMapControls() {
			var panel = document.getElementById('sidePanel');
			document.querySelector('.leaflet-left').style.left = panel.hidden ? '' : panel.offsetWidth + 'px';
		}

		// "Vis på kartet" in the filter (only on Kart): turn resources and needs on and off.
		// Kept in the URL as hide=resources / hide=needs, like the rest of the filter (help with AI)
		function applyLayerChoices(params) {
			var hide = (params.hide || '').split(',');
			if (hide.includes('resources')) map.removeLayer(markerLayer); else map.addLayer(markerLayer);
			if (canNeeds) {
				if (hide.includes('needs')) map.removeLayer(needLayer); else map.addLayer(needLayer);
			}
			document.getElementById('rfShowResources').checked = !hide.includes('resources');
			var needsBox = document.getElementById('rfShowNeeds');
			if (needsBox) needsBox.checked = !hide.includes('needs');
			// Type and status only matter for resources: greyed out while resources are hidden
			document.getElementById('rfPanel').classList.toggle('rf-resources-off', hide.includes('resources'));
		}

		function changeLayerChoice() {
			var hide = [];
			if (!document.getElementById('rfShowResources').checked) hide.push('resources');
			var needsBox = document.getElementById('rfShowNeeds');
			if (needsBox && !needsBox.checked) hide.push('needs');
			var params = window.getResourceParams();
			params.hide = hide.join(',');
			window.applyResourceParams(params);
		}

		document.getElementById('rfShowResources').addEventListener('change', changeLayerChoice);
		if (document.getElementById('rfShowNeeds')) document.getElementById('rfShowNeeds').addEventListener('change', changeLayerChoice);
	</script>
}