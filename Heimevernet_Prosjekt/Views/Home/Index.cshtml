@using Heimevernet_Prosjekt.Security.Authorization

@{
    ViewData["Title"] = "Hjem";
}

<style>
    .home-banner {
    min-height: 320px;
    background: linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.35)),
                url(/images/Krs.png) center 40% / cover no-repeat;
    width: 100vw;
    margin-left: calc(50% - 50vw);

    
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 0;
}

.home-banner .home-panel {
    margin: 0;
    width: 100%;
}
.home-cards {
    margin-top: -140px;   
    position: relative;   
}

    
    .home-panel {
        max-width: 720px;
        margin: 3rem auto;
        padding: 2rem;
        border-radius: 12px;
        background: rgba(var(--bs-body-bg-rgb), 0.88);
        color: var(--bs-body-color);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    
    .home-grid {
        max-width: 1100px;
        margin: 1.5rem auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
    }

    .home-card {
        padding: 1.5rem;
        border-radius: 12px;
        background: rgba(var(--bs-body-bg-rgb), 0.88);
        color: var(--bs-body-color);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    .home-links a {
    display: flex;                      
    justify-content: space-between;      
    padding: .75rem 0;
    border-top: 1px solid var(--bs-border-color);
    font-weight: 600;
    text-decoration: none;
}
.home-links a:hover {
    text-decoration: underline;
}
</style>

<div class="home-banner">
<div class="text-center home-panel">
    <h1 class="display-5">Heimevernets nettside for krise og ressurshåndtering</h1>
    <p>Vi hjelper med å gi kriseteam ressursene de trenger.</p>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <p>Har du noe du kan bidra med?</p>
        <a class="button" asp-controller="Account" asp-action="Register">Registrer her!</a>
        <p class="mt-2">Er du en internperson?</p>
        <a class="button" asp-controller="Account" asp-action="Login">Gå til innlogging</a>
    }
</div>
</div>

@if (User.Identity?.IsAuthenticated != true)
{
    <div class="home-panel">
        <h2 class="h4">Om applikasjonen</h2>
        <p>
            Heimevernet kobler ressurser med behov under kriser. Ressurser kan være
            utstyr, kjøretøy, lokaler eller personell.
        </p>
        <ol>
            <li>Registrer deg eller logg inn</li>
            <li>Legg inn ressursene du kan bidra med</li>
            <li>Kriseteam finner og ber om det de trenger</li>
        </ol>
    </div>
}
else if (User.IsInRole(RoleNames.Admin))
{
    <div class="home-grid">
        <div class="home-card">
            <h2 class="h4">Kart</h2>
            <p>Se ressurser og behov plassert på kartet. Se informasjon om hvordan du bruker kartet.</p>
            <div class="home-links">
            <a asp-controller="Home" asp-action="Map">Åpne kart <span>›</span></a>
            <a href="#guide-kart"> Mer informasjon <span>›</span></a>
            </div>
        </div>
        <div class="home-card">
            <h2 class="h4">Ressurser</h2>
            <p>Se ressursene som er tilgjengelige og registrer nye ressurser. Se informasjon om hvordan du registrerer ressurser.</p>
           <div class="home-links">
             <a asp-controller="Resource" asp-action="List">Ressursoversikt <span>›</span></a>
            <a asp-controller="ResourceHandler" asp-action="Create">Registrer ressurs <span>›</span></a>
            <a href="#guide-ressurser"> Mer informasjon <span>›</span></a>
            </div>
        </div>
        <div class="home-card">
            <h2 class="h4">Behov</h2>
            <p>Se alle behov og opprett nye behov. Se informasjon om hvordan du oppretter behov.</p>
            <div class="home-links">
            <a asp-controller="ResourceNeed" asp-action="List">Se behov <span>›</span></a>
            <a asp-controller="ResourceNeed" asp-action="Create">Opprett behov <span>›</span></a>
            <a href="#guide-behov"> Mer informasjon <span>›</span></a>
            </div>
        </div>
    </div>
}
else if (User.IsInRole(RoleNames.Operator))
{
    <div class="home-grid">
        <div class="home-card">
            <h2 class="h4">Kart</h2>
            <p>Se ressurser og behov plassert på kartet. Se informasjon om hvordan du bruker kartet.</p>
            <div class="home-links">
            <a asp-controller="Home" asp-action="Map">Åpne kart <span>›</span></a>
            <a href="#guide-kart"> Mer informasjon <span>›</span></a>
            </div>
        </div>
        <div class="home-card">
            <h2 class="h4">Behov</h2>
            <p>Se alle behov og opprett nye behov. Se informasjon om hvordan du oppretter behov.</p>
            <div class="home-links">
            <a asp-controller="ResourceNeed" asp-action="List">Se behov <span>›</span></a>
            <a asp-controller="ResourceNeed" asp-action="Create">Opprett behov <span>›</span></a>
            <a href="#guide-behov"> Mer informasjon <span>›</span></a>
            </div>
        </div>
        <div class="home-card">
            <h2 class="h4">Ressurser</h2>
            <p>Se ressursene som er tilgjengelige og registrer nye ressurser. Se informasjon om hvordan du registrerer ressurser.</p>
            <div class="home-links">
            <a asp-controller="Resource" asp-action="List">Ressursoversikt <span>›</span></a>
            <a asp-controller="ResourceHandler" asp-action="Create">Registrer ressurs <span>›</span></a>
            <a href="#guide-ressurser"> Mer informasjon <span>›</span></a>
            </div>
        </div>
    </div>
}
else if (User.IsInRole(RoleNames.Partner))
{
    <div class="home-grid">
        <div class="home-card">
            <h2 class="h4">Kart</h2>
            <p>Se ressurser og steder på kartet.</p>
            <div class="home-links">
            <a asp-controller="Home" asp-action="Map">Åpne kart <span>›</span></a>
            <a href="#guide-kart"> Mer informasjon <span>›</span></a>
            </div>
        </div>
        <div class="home-card">
            <h2 class="h4">Ressurser</h2>
            <p>Se ressursene som er tilgjengelige og registrer nye ressurser. Se informasjon om hvordan du registrerer ressurser.</p>
            <div class="home-links">
            <a asp-controller="Resource" asp-action="List">Ressursoversikt <span>›</span></a>
            <a asp-controller="ResourceHandler" asp-action="Create">Registrer ressurs <span>›</span></a>
            <a href="#guide-ressurser"> Mer informasjon <span>›</span></a>
            </div>
        </div>
    </div>
}
else
{
    <div class="home-grid">
        <div class="home-card">
            <h2 class="h4">Kart</h2>
            <p>Se ressurser og steder på kartet.</p>
            <div class="home-links">
            <a asp-controller="Home" asp-action="Map">Åpne kart <span>›</span></a>
            <a href="#guide-kart"> Mer informasjon <span>›</span></a>
            </div>
        </div>
        <div class="home-card">
            <h2 class="h4">Mine ressurser</h2>
            <p>Se ressursene som er tilgjengelige og registrer nye ressurser. Se informasjon om hvordan du registrerer ressurser.</p>
            <div class="home-links">
            <a asp-controller="Resource" asp-action="List">Ressursoversikt <span>›</span></a>
            <a asp-controller="ResourceHandler" asp-action="Create">Registrer ressurs <span>›</span></a>
            <a href="#guide-ressurser"> Mer informasjon <span>›</span></a>
            </div>
        </div>
    </div>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="home-panel">
        <h2 class="h4">Slik bruker du siden</h2>
        <ol>
            <li><strong>Kart:</strong> Gir en oversikt over området og ressursene som er plassert, for operatører viser den hvor tilgjengelige ressurser er samt hendelser.</li>
            <li><strong>Ressurser:</strong> Oversikt over det som kan bidra i en krise.</li>
            <li><strong>Behov:</strong> Det som blir meldt inn av operatører av nød for ressurser og hvilken type ressurser de trenger.</li>
        </ol>
    </div>
}
