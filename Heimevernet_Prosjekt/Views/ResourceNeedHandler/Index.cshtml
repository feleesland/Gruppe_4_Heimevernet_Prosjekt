﻿@using Heimevernet_Prosjekt.Models.ViewModels.ResourceNeed
@model List<ResourceNeedViewModel>
@{
    ViewData["Title"] = "Behov";
}
<a asp-controller="ResourceNeedHandler" asp-action="Create">Opprett nytt behov</a>
<table>
    <tr>
        <th>ID</th>
        <th>Navn</th>
        <th>Beskrivelse</th>
        <th>Type</th>
        <th>Handlinger</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>@item.Type</td>
            <td>
                <a asp-controller="ResourceNeedHandler" asp-action="Edit" asp-route-id="@item.Id">Rediger</a> |
                <form asp-controller="ResourceNeedHandler" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline">
                    <button type="submit">Slett</button>
                </form>
            </td>
        </tr>
    }
</table>