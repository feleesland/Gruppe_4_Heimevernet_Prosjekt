@using Heimevernet_Prosjekt.Models.ViewModels.ResourceNeed
@using Heimevernet_Prosjekt.Models.Entities
@model ReportNeedViewModel
@{
    // The same form for "Meld behov" and "Rediger behov" (EditNeedId is set)
    var editing = Model.EditNeedId != null;
    ViewData["Title"] = editing ? "Rediger behov" : "Meld behov";
    var types = ViewData["ResourceTypes"] as IReadOnlyCollection<ResourceType> ?? Array.Empty<ResourceType>();
    var isPlanned = Model.Urgency == NeedUrgency.Planlagt;
    // In the side panel on the map (?embed=1): no menu, and the panel closes after saving
    var embed = Context.Request.Query["embed"] == "1"
                || (Context.Request.HasFormContentType && Context.Request.Form["embed"] == "1");
    if (embed)
    {
        Layout = "_EmbedLayout";
    }
}

<link rel="stylesheet" href="~/css/need-form.css" asp-append-version="true" />

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

@* Docs: Tag Helpers in forms (also adds the antiforgery token) - https://learn.microsoft.com/aspnet/core/mvc/views/working-with-forms
   data-*: read by wwwroot/js/need-form.js *@
<form asp-controller="ResourceNeedHandler" asp-action="@(editing ? "Edit" : "Create")" method="post" id="needForm"
      data-editing="@(editing ? "true" : "false")" data-active-url="@Url.Action("ActiveAt", "ResourceNeedHandler")">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="ExistingNeedId" />
    <input type="hidden" asp-for="EditNeedId" />
    @if (embed)
    {
        <input type="hidden" name="embed" value="1" />
    }

    @* Big screens: left (what, and what is needed) | right (where), and the bar under both, all on one screen without scrolling.
       Small screens and the side panel: the map first, then the rest (.need-layout in need-form.css) *@
    <div id="needLayout" class="need-layout">
        <div class="need-left">
            @* Shown only when the chosen place is inside an active need (filled by need-form.js). Not when editing *@
            <div id="activeBox" class="need-card need-card-warning" hidden>
                <div class="need-card-title"><i class="ti ti-alert-triangle" aria-hidden="true"></i> Det er allerede et aktivt behov her</div>
                <div id="activeList"></div>
                <div id="alreadyReported" class="small mt-2"></div>
            </div>

            @* Name and Akutt/Planlagt on one line, the description under. Hidden when adding to an existing need *@
            <div id="newNeedFields" class="need-card">
                <div class="need-name-row">
                    <label asp-for="Name" class="visually-hidden"></label>
                    <input asp-for="Name" class="form-control" placeholder="Navn, f.eks. Flom Lund" />
                    @* Akutt or Planlagt. Icon + text, not colour alone *@
                    <div class="btn-group need-urgency" role="radiogroup" aria-label="Akutt eller planlagt">
                        <input type="radio" class="btn-check" name="Urgency" id="urgencyAkutt" value="Akutt" checked="@(!isPlanned)" />
                        <label class="btn btn-outline-danger" for="urgencyAkutt"><i class="ti ti-alarm" aria-hidden="true"></i> Akutt · nå</label>
                        <input type="radio" class="btn-check" name="Urgency" id="urgencyPlanlagt" value="Planlagt" checked="@isPlanned" />
                        <label class="btn btn-outline-warning" for="urgencyPlanlagt"><i class="ti ti-calendar" aria-hidden="true"></i> Planlagt</label>
                    </div>
                </div>
                <span asp-validation-for="Name" class="text-danger small"></span>

                @* Planlagt: from (required) and to. Akutt: "Innen" only after "+ Frist" *@
                <div id="timeFields" class="row g-2 mt-0">
                    <div class="col-sm-6" id="fromCol" hidden="@(!isPlanned)">
                        <label asp-for="NeededFrom" class="form-label small mb-1"></label>
                        <input asp-for="NeededFrom" class="form-control" />
                        <span asp-validation-for="NeededFrom" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6" id="toCol" hidden="@(!isPlanned && Model.NeededTo == null)">
                        <label asp-for="NeededTo" id="toLabel" class="form-label small mb-1">@(isPlanned ? "Til (valgfritt)" : "Innen")</label>
                        <input asp-for="NeededTo" class="form-control" />
                        <span asp-validation-for="NeededTo" class="text-danger small"></span>
                    </div>
                </div>

                @* One line that grows while you write (need-form.js) *@
                <label asp-for="Description" class="visually-hidden"></label>
                <textarea asp-for="Description" class="form-control mt-2 need-grow" rows="1" placeholder="Beskrivelse for operatørene, f.eks. «Elva har gått over sine bredder»"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>

                @* The optional things are links, so the form stays short *@
                <div class="d-flex flex-wrap gap-3 mt-2">
                    <button type="button" id="addDeadline" class="btn btn-link btn-sm p-0 need-link">+ Frist</button>
                </div>
            </div>

            <div id="addingInfo" class="alert alert-secondary py-2 mb-0" hidden></div>

            @* What is needed. The lines scroll inside the card, so the page stays still. Drawn by need-form.js
               (hidden inputs Lines[i].… for the server). Empty: "Ofte brukt" and the categories fill the card *@
            <div class="need-card need-lines-card">
                <div class="need-card-title">
                    <i class="ti ti-package" aria-hidden="true"></i> <span id="linesLegend">Hva trengs?</span>
                    <span id="linesCount" class="ms-auto small fw-normal text-body-secondary"></span>
                </div>
                <div id="lines" class="need-lines"></div>
                <div id="quickBox"></div>
                <button type="button" class="need-all" data-bs-toggle="modal" data-bs-target="#addModal">
                    <i class="ti ti-layout-grid" aria-hidden="true"></i> Vis alle ressurser <span id="allHint" class="fw-normal opacity-75"></span>
                </button>
            </div>
        </div>

        @* The place: same ids and map as on resources (location-picker.js), the address on one line *@
        <fieldset class="need-card need-map-card">
            <legend class="need-card-title"><i class="ti ti-map-pin" aria-hidden="true"></i> Hvor?</legend>
            <div class="need-address-row">
                <input asp-for="Address" class="form-control form-control-sm need-address" placeholder="Adresse" aria-label="Adresse" />
                <input asp-for="ZipCode" class="form-control form-control-sm need-zip" placeholder="Postnr." aria-label="Postnummer" />
                <input asp-for="City" class="form-control form-control-sm need-city" placeholder="Poststed" aria-label="Poststed" />
                <button type="button" id="findOnMap" class="btn btn-sm rf-reset" title="Finn adressen på kartet" aria-label="Finn adressen på kartet"><i class="ti ti-search" aria-hidden="true"></i></button>
                <button type="button" id="useMyLocation" class="btn btn-sm rf-reset" title="Bruk min posisjon" aria-label="Bruk min posisjon"><i class="ti ti-current-location" aria-hidden="true"></i></button>
                <span id="radiusWrap">
                    <label asp-for="RadiusKm" class="visually-hidden"></label>
                    <select asp-for="RadiusKm" class="form-select form-select-sm" title="Radius" style="width: auto;">
                        <option value="0.5">500 m</option>
                        <option value="1">1 km</option>
                        <option value="2">2 km</option>
                        <option value="5">5 km</option>
                        <option value="10">10 km</option>
                    </select>
                </span>
            </div>
            <span id="geoStatus" class="small text-muted d-block"></span>
            <div id="pickMap" class="need-map rounded"></div>
            <small class="text-muted">Klikk på kartet eller dra markøren.</small>
            <input type="hidden" asp-for="Latitude" />
            <input type="hidden" asp-for="Longitude" />
            <input type="hidden" asp-for="Municipality" />
        </fieldset>

        @* Under both columns: a short summary and the button, always in view *@
        <div class="need-bar">
            <span id="needSummary" class="small text-body-secondary"></span>
            <button type="submit" id="submitButton" class="btn btn-primary ms-auto">@(editing ? "Lagre endringer" : "Meld behov")</button>
            @if (embed)
            {
                @* In the side panel: tell the map to close the panel *@
                <button type="button" class="btn rf-reset" onclick="parent.postMessage({ type: 'need-close' }, location.origin);">Avbryt</button>
            }
            else if (editing)
            {
                <a asp-controller="ResourceNeed" asp-action="Index" asp-route-id="@Model.EditNeedId" class="btn rf-reset">Avbryt</a>
            }
            else
            {
                <a asp-controller="ResourceNeed" asp-action="List" class="btn rf-reset">Avbryt</a>
            }
        </div>
    </div>
</form>

@* "Legg til ressurs" (help with AI): categories like in "Ny ressurs", the types in the chosen one, and "Valgt" on the right.
   On small screens the window fills the screen and "Valgt" is a bar at the bottom that opens - Docs: Bootstrap Modal
   https://getbootstrap.com/docs/5.3/components/modal/ *@
<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-md-down modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="addModalTitle">Legg til ressurs</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Lukk"></button>
            </div>
            <div class="modal-body p-0">
                <div class="row g-0 h-100">
                    <div class="col-md-8 p-3">
                        <input type="search" id="typeSearch" class="form-control mb-3" placeholder="Søk type, f.eks. «bil» og trykk Enter" autocomplete="off" aria-label="Søk type" />
                        <div id="catGrid" class="need-cat-grid mb-3" role="group" aria-label="Kategorier"></div>
                        <div id="typeTitle" class="small text-body-secondary mb-2"></div>
                        <div id="typeList" class="need-type-grid"></div>
                    </div>
                    <div class="col-md-4 need-cart d-none d-md-flex">
                        <div class="need-card-title"><i class="ti ti-check" aria-hidden="true"></i> Valgt <span id="cartCount" class="ms-auto small fw-normal"></span></div>
                        <div id="cartSide" class="need-cart-list"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer flex-column align-items-stretch">
                @* Small screens: "Valgt" folds out from the bottom *@
                <details class="d-md-none need-cart-mobile">
                    <summary><i class="ti ti-chevron-up" aria-hidden="true"></i> <span id="cartCountMobile">Valgt</span></summary>
                    <div id="cartMobile" class="need-cart-list mt-2"></div>
                </details>
                <button type="button" id="addDone" class="btn btn-success" data-bs-dismiss="modal">Ferdig</button>
            </div>
        </div>
    </div>
</div>

@* Data for need-form.js: the categories with their types, all types (old ones without a category go under "Annet"),
   the most used types ("Ofte brukt") and the lines *@
<script type="application/json" id="needCategories">@Json.Serialize(ViewData["TypeCategories"])</script>
<script type="application/json" id="needTypes">@Json.Serialize(types.Select(t => t.Name))</script>
<script type="application/json" id="needPopular">@Json.Serialize(ViewData["PopularTypes"])</script>
<script type="application/json" id="needLines">@Json.Serialize(Model.Lines)</script>

@section Scripts {
    <script src="~/js/location-picker.js" asp-append-version="true"></script>
    <script src="~/js/need-form.js" asp-append-version="true"></script>
}