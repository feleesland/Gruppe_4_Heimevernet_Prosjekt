@using Heimevernet_Prosjekt.Models.ViewModels.ResourceNeed
@using Heimevernet_Prosjekt.Models.Entities
@model ReportNeedViewModel
@{
    // The same form for "Meld behov" and "Rediger behov" (EditNeedId is set)
    var editing = Model.EditNeedId != null;
    ViewData["Title"] = editing ? "Rediger behov" : "Meld behov";
    var types = ViewData["ResourceTypes"] as IReadOnlyCollection<ResourceType> ?? Array.Empty<ResourceType>();
    var isPlanned = Model.Urgency == NeedUrgency.Planlagt;
    // Start with one empty line so it is clear what to fill in
    var lines = Model.Lines.Count > 0 ? Model.Lines : new List<NeedLineInput> { new() };
    // In the side panel on the map (?embed=1): no menu, and the panel closes after saving
    var embed = Context.Request.Query["embed"] == "1"
                || (Context.Request.HasFormContentType && Context.Request.Form["embed"] == "1");
    if (embed)
    {
        Layout = "_EmbedLayout";
    }
}

<div style="max-width: 760px;">
    <h1>@ViewData["Title"]</h1>

    @* Docs: Tag Helpers in forms (also adds the antiforgery token) - https://learn.microsoft.com/aspnet/core/mvc/views/working-with-forms *@
    <form asp-controller="ResourceNeedHandler" asp-action="@(editing ? "Edit" : "Create")" method="post" id="needForm">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="ExistingNeedId" />
        <input type="hidden" asp-for="EditNeedId" />
        @if (embed)
        {
            <input type="hidden" name="embed" value="1" />
        }

        @* Shown only when the chosen place is inside an active need (filled by JavaScript below). Not when editing *@
        <div id="activeBox" class="alert alert-warning" hidden>
            <div id="activeList"></div>
            <div id="alreadyReported" class="small mt-2"></div>
        </div>

        @* Only for a new need: hidden when adding to an existing one *@
        <div id="newNeedFields">
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="F.eks. Flom Lund" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            @* Akutt or Planlagt, right under the name. Icon + text, not colour alone *@
            <div class="btn-group w-100 mb-3" role="radiogroup" aria-label="Akutt eller planlagt">
                <input type="radio" class="btn-check" name="Urgency" id="urgencyAkutt" value="Akutt" checked="@(!isPlanned)" />
                <label class="btn btn-outline-danger" for="urgencyAkutt">⏰ Akutt</label>
                <input type="radio" class="btn-check" name="Urgency" id="urgencyPlanlagt" value="Planlagt" checked="@isPlanned" />
                <label class="btn btn-outline-primary" for="urgencyPlanlagt">📅 Planlagt</label>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" placeholder="Valgfritt, f.eks. «Elva har gått over sine bredder»" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div id="addingInfo" class="alert alert-secondary py-2" hidden></div>

        @* The place: same fields, ids and map as on resources (location-picker.js) *@
        <fieldset class="mb-3">
            <legend class="form-label fs-6 fw-semibold">Hvor?</legend>
            <div class="row g-2">
                <div class="col-md-6"><input asp-for="Address" class="form-control" placeholder="Adresse" aria-label="Adresse" /></div>
                <div class="col-md-2"><input asp-for="ZipCode" class="form-control" placeholder="Postnr." aria-label="Postnummer" /></div>
                <div class="col-md-4"><input asp-for="City" class="form-control" placeholder="Poststed" aria-label="Poststed" /></div>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center my-2">
                <button type="button" id="findOnMap" class="btn btn-outline-secondary btn-sm">Finn på kartet</button>
                <button type="button" id="useMyLocation" class="btn btn-outline-secondary btn-sm">Bruk min posisjon</button>
                <span id="radiusWrap" class="d-flex align-items-center gap-2">
                    <label asp-for="RadiusKm" class="small mb-0"></label>
                    <select asp-for="RadiusKm" class="form-select form-select-sm" style="width: auto;">
                        <option value="0.5">500 m</option>
                        <option value="1">1 km</option>
                        <option value="2">2 km</option>
                        <option value="5">5 km</option>
                        <option value="10">10 km</option>
                    </select>
                </span>
                <span id="geoStatus" class="small text-muted"></span>
            </div>
            <div id="pickMap" style="height: 280px;" class="rounded"></div>
            <small class="text-muted">Klikk på kartet eller dra markøren.</small>
            <input type="hidden" asp-for="Latitude" />
            <input type="hidden" asp-for="Longitude" />
        </fieldset>

        @* The lines. Chips fill an empty line or add a new one *@
        <fieldset class="mb-3">
            <legend id="linesLegend" class="form-label fs-6 fw-semibold">Hva trengs?</legend>
            <div class="d-flex flex-wrap gap-2 mb-2">
                @foreach (var type in types)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" data-add-type="@type.Name">+ @type.Name</button>
                }
            </div>
            <div id="lines">
                @for (var i = 0; i < lines.Count; i++)
                {
                    var locked = lines[i].HasRequests;
                    <div class="row g-2 mb-2 need-line">
                        @* Rediger: which saved line this is, so the server knows what changed *@
                        @if (lines[i].ItemId != null)
                        {
                            <input type="hidden" name="Lines[@i].ItemId" value="@lines[i].ItemId" />
                            <input type="hidden" name="Lines[@i].Accepted" value="@lines[i].Accepted" />
                            <input type="hidden" name="Lines[@i].HasRequests" value="@(locked ? "true" : "false")" />
                        }
                        <div class="col">
                            @if (locked)
                            {
                                @* Requests are sent for this line: the type can't change (a disabled field isn't sent, so a hidden one is) *@
                                <input type="hidden" name="Lines[@i].Type" value="@lines[i].Type" />
                                <select class="form-select" aria-label="Ressurs" disabled>
                                    <option selected>@lines[i].Type</option>
                                </select>
                                <div class="small text-body-secondary">
                                    🔒 Forespørsler er sendt@(lines[i].Accepted > 0 ? $", {lines[i].Accepted} har sagt ja" : "")
                                </div>
                            }
                            else
                            {
                                <select name="Lines[@i].Type" class="form-select" aria-label="Ressurs">
                                    <option value="">Velg type …</option>
                                    @foreach (var type in types)
                                    {
                                        <option value="@type.Name" selected="@(type.Name == lines[i].Type)">@type.Name</option>
                                    }
                                </select>
                            }
                            @Html.ValidationMessage($"Lines[{i}].Type", new { @class = "text-danger" })
                        </div>
                        <div class="col-3 col-md-2">
                            @* The quantity can't be lower than how many already said yes *@
                            <input name="Lines[@i].Quantity" type="number" min="@Math.Max(1, lines[i].Accepted)" max="1000"
                                   value="@lines[i].Quantity" class="form-control" aria-label="Antall" />
                        </div>
                        <div class="col-auto">
                            @if (locked)
                            {
                                <span class="btn btn-outline-secondary disabled" title="Kan ikke fjernes: forespørsler er sendt" aria-label="Låst">🔒</span>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-secondary remove-line" aria-label="Fjern linjen">✕</button>
                            }
                        </div>
                    </div>
                }
            </div>
        </fieldset>

        @* Time at the bottom: Akutt = now (optional "innen"), Planlagt = from (required) and to *@
        <fieldset id="timeFields" class="mb-3 border-top pt-3">
            <legend class="form-label fs-6 fw-semibold">Når trengs det?</legend>
            <p id="nowText" class="mb-2" hidden="@isPlanned">⏰ <strong>Nå</strong>. Fyll inn «Innen» bare hvis det er en frist.</p>
            <div class="row g-2">
                <div class="col-md-6" id="fromCol" hidden="@(!isPlanned)">
                    <label asp-for="NeededFrom" class="form-label small"></label>
                    <input asp-for="NeededFrom" class="form-control" />
                    <span asp-validation-for="NeededFrom" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NeededTo" id="toLabel" class="form-label small">@(isPlanned ? "Til (valgfritt)" : "Innen (valgfritt)")</label>
                    <input asp-for="NeededTo" class="form-control" />
                    <span asp-validation-for="NeededTo" class="text-danger"></span>
                </div>
            </div>
        </fieldset>

        <button type="submit" id="submitButton" class="btn btn-primary" style="min-height: 44px;">@(editing ? "Lagre endringer" : "Meld behov")</button>
        @if (embed)
        {
            @* In the side panel: tell the map to close the panel *@
            <button type="button" class="btn btn-outline-secondary" style="min-height: 44px;"
                    onclick="parent.postMessage({ type: 'need-close' }, location.origin);">
                Avbryt
            </button>
        }
        else if (editing)
        {
            <a asp-controller="ResourceNeed" asp-action="Index" asp-route-id="@Model.EditNeedId" class="btn btn-outline-secondary" style="min-height: 44px;">Avbryt</a>
        }
        else
        {
            <a asp-controller="ResourceNeed" asp-action="List" class="btn btn-outline-secondary" style="min-height: 44px;">Avbryt</a>
        }
    </form>
</div>

@* A new line, copied by JavaScript (the numbers in the names are fixed by renumber()) *@
<template id="lineTemplate">
    <div class="row g-2 mb-2 need-line">
        <div class="col">
            <select name="Lines[0].Type" class="form-select" aria-label="Ressurs">
                <option value="">Velg type …</option>
                @foreach (var type in types)
                {
                    <option value="@type.Name">@type.Name</option>
                }
            </select>
        </div>
        <div class="col-3 col-md-2">
            <input name="Lines[0].Quantity" type="number" min="1" max="1000" value="1" class="form-control" aria-label="Antall" />
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-outline-secondary remove-line" aria-label="Fjern linjen">✕</button>
        </div>
    </div>
</template>

@section Scripts {
    <script src="~/js/location-picker.js" asp-append-version="true"></script>
    <script>
        // "Meld behov" / "Rediger behov": lines, akutt/planlagt and "Legg til i ..." (help with AI)
        // Docs: Leaflet API reference (Circle, LayerGroup) - https://leafletjs.com/reference.html
        (function () {
            const editing = @(editing ? "true" : "false");
            const activeUrl = '@Url.Action("ActiveAt", "ResourceNeedHandler")';
            const latField = document.getElementById('Latitude');
            const lngField = document.getElementById('Longitude');
            const existingField = document.getElementById('ExistingNeedId');
            const radiusSelect = document.getElementById('RadiusKm');
            const linesBox = document.getElementById('lines');
            const lineTemplate = document.getElementById('lineTemplate');
            const submitButton = document.getElementById('submitButton');

            let activeNeeds = [];
            let chosen = null;            // the active need we add to, or null = new need
            let userChoseNew = false;     // the user clicked "Nytt behov": don't pick for them again
            let radiusCircle = null;

            // ---- Lines ----
            // Every field in a line is named Lines[i]..., so the numbers are fixed after adding or removing a line
            function renumber() {
                linesBox.querySelectorAll('.need-line').forEach((row, i) => {
                    row.querySelectorAll('[name^="Lines["]').forEach(el => {
                        el.name = el.name.replace(/^Lines\[\d+\]/, `Lines[${i}]`);
                    });
                });
                updateSubmit();
            }

            function addLine(type) {
                // A chip fills the first empty line before it adds a new one
                const empty = [...linesBox.querySelectorAll('.need-line select:not([disabled])')].find(s => s.value === '');
                if (empty) {
                    empty.value = type;
                    empty.closest('.need-line').querySelector('input[type=number]').focus();
                } else {
                    const row = lineTemplate.content.firstElementChild.cloneNode(true);
                    row.querySelector('select').value = type;
                    linesBox.appendChild(row);
                    row.querySelector('input[type=number]').focus();
                }
                renumber();
            }

            document.querySelectorAll('[data-add-type]').forEach(chip =>
                chip.addEventListener('click', () => addLine(chip.dataset.addType)));

            linesBox.addEventListener('click', e => {
                const remove = e.target.closest('.remove-line');
                if (remove) {
                    remove.closest('.need-line').remove();
                    renumber();
                }
            });
            linesBox.addEventListener('change', updateSubmit);

            function lineCount() {
                return [...linesBox.querySelectorAll('.need-line select')].filter(s => s.value !== '').length;
            }

            function updateSubmit() {
                if (editing) {
                    submitButton.textContent = 'Lagre endringer';
                    return;
                }
                const n = lineCount();
                submitButton.textContent = chosen ? `Legg til ${n} behov i ${chosen.name}` : `Meld ${n} behov`;
            }

            // ---- Akutt / Planlagt ----
            function isPlanned() {
                return document.getElementById('urgencyPlanlagt').checked;
            }

            function applyUrgency() {
                const planned = isPlanned();
                document.getElementById('fromCol').hidden = !planned;
                document.getElementById('nowText').hidden = planned;
                document.getElementById('toLabel').textContent = planned ? 'Til (valgfritt)' : 'Innen (valgfritt)';
                drawRadius();
            }
            document.querySelectorAll('input[name="Urgency"]').forEach(r => r.addEventListener('change', applyUrgency));

            // ---- The circle for the need ----
            function drawRadius() {
                if (radiusCircle) {
                    pickMap.removeLayer(radiusCircle);
                    radiusCircle = null;
                }
                const lat = parseFloat(latField.value);
                const lng = parseFloat(lngField.value);
                if (chosen || isNaN(lat) || isNaN(lng)) return;
                radiusCircle = L.circle([lat, lng], {
                    radius: parseFloat(radiusSelect.value) * 1000,
                    color: isPlanned() ? '#378ADD' : '#E24B4A',
                    dashArray: isPlanned() ? '2 6' : '8 6',
                    fillOpacity: 0.08
                }).addTo(pickMap);
            }
            radiusSelect.addEventListener('change', drawRadius);

            // ---- "Legg til i ..." or "Nytt behov" ----
            function applyMode() {
                existingField.value = chosen ? chosen.id : '';
                document.getElementById('newNeedFields').hidden = !!chosen;
                document.getElementById('timeFields').hidden = !!chosen;
                document.getElementById('radiusWrap').hidden = !!chosen;
                const info = document.getElementById('addingInfo');
                info.hidden = !chosen;
                info.textContent = chosen
                    ? `Behovene legges til i «${chosen.name}» (${chosen.urgency.toLowerCase()}). Navn og tid hentes derfra.`
                    : '';
                document.getElementById('linesLegend').textContent = chosen ? 'Hva trengs i tillegg?' : 'Hva trengs?';
                drawRadius();
                updateSubmit();
            }

            function renderBox() {
                const box = document.getElementById('activeBox');
                const list = document.getElementById('activeList');
                list.replaceChildren();
                box.hidden = activeNeeds.length === 0;

                activeNeeds.forEach(need => {
                    const line = document.createElement('p');
                    line.className = 'mb-2';
                    // textContent, so names from users can't run as code (XSS)
                    line.textContent = `⚠ ${need.name} er aktivt her (${String(need.distanceKm).replace('.', ',')} km unna).`;
                    list.appendChild(line);
                });

                const buttons = document.createElement('div');
                buttons.className = 'd-flex flex-wrap gap-2';
                activeNeeds.forEach(need => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'btn ' + (chosen && chosen.id === need.id ? 'btn-primary' : 'btn-outline-warning');
                    button.textContent = `Legg til i ${need.name}`;
                    button.addEventListener('click', () => { chosen = need; userChoseNew = false; renderBox(); applyMode(); });
                    buttons.appendChild(button);
                });
                const newButton = document.createElement('button');
                newButton.type = 'button';
                newButton.className = 'btn ' + (chosen ? 'btn-outline-warning' : 'btn-warning');
                newButton.textContent = 'Nytt behov';
                newButton.addEventListener('click', () => { chosen = null; userChoseNew = true; renderBox(); applyMode(); });
                buttons.appendChild(newButton);
                list.appendChild(buttons);

                const already = document.getElementById('alreadyReported');
                already.textContent = chosen && chosen.items.length
                    ? 'Allerede meldt: ' + chosen.items.map(i => `${i.quantity} × ${i.type}`).join(' · ')
                    : '';
            }

            // Ask the server: is the chosen place inside an active need? (not when editing: the need would find itself)
            async function checkPlace() {
                if (editing) {
                    drawRadius();
                    return;
                }
                const lat = parseFloat(latField.value);
                const lng = parseFloat(lngField.value);
                if (isNaN(lat) || isNaN(lng)) return;

                try {
                    const response = await fetch(`${activeUrl}?lat=${lat}&lng=${lng}`);
                    activeNeeds = response.ok ? await response.json() : [];
                } catch {
                    activeNeeds = [];
                }

                // Keep the choice if it is still here; after a failed submit, keep the need from the server
                const fromServer = parseInt(existingField.value);
                if (chosen && !activeNeeds.some(n => n.id === chosen.id)) chosen = null;
                if (!chosen && !isNaN(fromServer)) chosen = activeNeeds.find(n => n.id === fromServer) || null;
                if (!chosen && !userChoseNew && activeNeeds.length > 0) chosen = activeNeeds[0];

                renderBox();
                applyMode();
            }

            latField.addEventListener('change', checkPlace);

            applyUrgency();
            renumber();
            checkPlace();   // e.g. when the form opens with a place from the main map
        })();
    </script>
}