@using Heimevernet_Prosjekt.Models.ViewModels.Resource
@using Heimevernet_Prosjekt.Models.Authorization
@inject Heimevernet_Prosjekt.DataAccess.IResourceReportRepository ReportRepository
@inject Heimevernet_Prosjekt.DataAccess.IResourceRequestRepository RequestRepository
@using Heimevernet_Prosjekt.Models.Entities
@model ResourceViewModel
@{
    ViewData["Title"] = "Ressurs";
}

@* Rediger/Slett only show when the user is allowed (CanEdit/CanDelete set in ResourceController.Index) *@
@if (Model.CanEdit || Model.CanDelete)
{
    <h1>@ViewData["Title"]</h1>
    <div class="d-flex flex-wrap gap-2 mb-3">
        @if (Model.CanEdit)
        {
            <a class="btn btn-secondary" asp-controller="ResourceHandler" asp-action="Edit" asp-route-id="@Model.Id">Rediger</a>
        }
        @if (Model.CanDelete)
        {
            <form asp-controller="ResourceHandler" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="m-0">
                <button type="submit" class="btn btn-danger"
                        onclick="return confirm('Er du sikker på at du vil slette denne ressursen?');">
                    Slett
                </button>
            </form>
        }
    </div>
}
@* Status with one click: icon + text, not colour alone. Only those who may edit (owner, admin) *@
@if (Model.CanEdit && Model.Id != null)
{
    var activeLoan = RequestRepository.GetLoansForResource(Model.Id.Value).FirstOrDefault(l => l.ReturnedAt == null);
    var unavailable = Model.Status == "Ikke tilgjengelig";
    var oslo = TimeZoneInfo.FindSystemTimeZoneById("Europe/Oslo");

    if (activeLoan != null)
    {
        <div class="alert alert-info py-2 mb-3">
            📦 Utlånt til «@activeLoan.NeedName». Den blir ledig når den er markert som levert tilbake.
        </div>
    }
    else
    {
        <form asp-controller="ResourceStatus" asp-action="Set" method="post" class="mb-2">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="small text-body-secondary mb-1">Status</div>
            <div class="btn-group flex-wrap" role="group" aria-label="Status">
                <button type="submit" name="status" value="Ledig"
                        class="btn @(Model.Status == "Ledig" ? "btn-success" : "btn-outline-success")"
                        aria-pressed="@(Model.Status == "Ledig" ? "true" : "false")">
                    ✓ Ledig
                </button>
                <button type="submit" name="status" value="Opptatt"
                        class="btn @(Model.Status == "Opptatt" ? "btn-warning" : "btn-outline-warning")"
                        aria-pressed="@(Model.Status == "Opptatt" ? "true" : "false")">
                    ● Opptatt
                </button>
                @* Opens the small form below instead of saving straight away *@
                <button type="button" data-bs-toggle="collapse" data-bs-target="#unavailableForm"
                        aria-expanded="false" aria-controls="unavailableForm"
                        class="btn @(unavailable ? "btn-secondary" : "btn-outline-secondary")"
                        aria-pressed="@(unavailable ? "true" : "false")">
                    ⏸ Ikke tilgjengelig
                </button>
                <button type="submit" name="status" value="Ugyldig"
                        class="btn @(Model.Status == "Ugyldig" ? "btn-danger" : "btn-outline-danger")"
                        aria-pressed="@(Model.Status == "Ugyldig" ? "true" : "false")">
                    ✗ Ugyldig
                </button>
            </div>
        </form>

        @* Why, and when it's free again. The time is Norwegian time *@
        <div class="collapse mb-3" id="unavailableForm">
            <form asp-controller="ResourceStatus" asp-action="SetUnavailable" method="post" class="card card-body" style="max-width: 520px;">
                <input type="hidden" name="id" value="@Model.Id" />
                <label for="unavailableReason" class="form-label">Hvorfor? <span class="text-body-secondary">(valgfritt)</span></label>
                <input id="unavailableReason" name="reason" class="form-control mb-3" maxlength="200"
                       placeholder="F.eks. på verksted" value="@Model.UnavailableReason" />

                <label for="unavailableUntil" class="form-label">Ledig igjen</label>
                <input id="unavailableUntil" name="until" type="datetime-local" class="form-control mb-2" />
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="unavailableUnknown" name="unknown" value="true"
                           onchange="document.getElementById('unavailableUntil').disabled = this.checked;" />
                    <label class="form-check-label" for="unavailableUnknown">Vet ikke når</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="button m-0 border-0">Lagre</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#unavailableForm">Avbryt</button>
                </div>
            </form>
        </div>

        @* Shown while it is unavailable: icon + text *@
        @if (unavailable)
        {
            <div class="alert alert-secondary py-2 mb-3">
                ⏸ Ikke tilgjengelig@(string.IsNullOrEmpty(Model.UnavailableReason) ? "" : $" – {Model.UnavailableReason}").
                @if (Model.UnavailableUntil != null)
                {
                    <text>Ledig igjen @TimeZoneInfo.ConvertTimeFromUtc(Model.UnavailableUntil.Value, oslo).ToString("dd.MM.yyyy 'kl' HH:mm"). Blir ledig av seg selv da.</text>
                }
                else
                {
                    <text>Ukjent når den er ledig igjen.</text>
                }
            </div>
        }
    }
}

@* Confirmation after "Meld til admin" *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@* Operator on a resource they can't edit: send a message to admin instead (e.g. "wrong address") *@
@if (!Model.CanEdit && (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Operator)))
{
    <button class="btn btn-outline-warning mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#reportForm"
            aria-expanded="false" aria-controls="reportForm">
        ⚑ Meld til admin
    </button>

    <div class="collapse mb-3" id="reportForm">
        <form asp-controller="ResourceReport" asp-action="Create" method="post">
            <input type="hidden" name="resourceId" value="@Model.Id" />
            <label for="reportMessage" class="form-label">Hva bør admin endre eller slette?</label>
            <textarea id="reportMessage" name="message" class="form-control mb-2" rows="3" maxlength="1000" required
                      placeholder="F.eks. feil adresse, traktoren står på Lund"></textarea>
            <button type="submit" class="btn btn-warning">Send</button>
        </form>
    </div>
}


@* Admin: open messages from operators about this resource, with "Marker som løst" - Docs: Dependency injection into views *@
@* https://learn.microsoft.com/aspnet/core/mvc/views/dependency-injection *@
@if (User.IsInRole(RoleNames.Admin) && Model.Id != null)
{
    var reports = ReportRepository.GetOpenForResource(Model.Id.Value);
    if (reports.Count > 0)
    {
        <div class="alert alert-warning">
            <h5 class="alert-heading">⚑ Meldinger til admin (@reports.Count)</h5>
            @foreach (var report in reports)
            {
                var sent = TimeZoneInfo.ConvertTimeFromUtc(report.CreatedAt, TimeZoneInfo.FindSystemTimeZoneById("Europe/Oslo"));
                <div class="border-top pt-2 mt-2">
                    <div class="small">@report.ReporterEmail · @sent.ToString("dd.MM.yyyy HH:mm")</div>
                    <p class="mb-2">@report.Message</p>
                    <form asp-controller="ResourceReport" asp-action="Resolve" method="post" class="m-0">
                        <input type="hidden" name="id" value="@report.Id" />
                        <input type="hidden" name="resourceId" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-success">✓ Marker som løst</button>
                    </form>
                </div>
            }
        </div>
    }
}

<p>@Model.Description</p>
<p>Type: @Model.Type</p>
@if (Model.HasImage)
{
    <img src="@Url.Action("Image", "Resource", new { id = Model.Id })" alt="@Model.Name" class="img-fluid mb-3" style="max-height: 300px;" />
}
@if (!string.IsNullOrEmpty(Model.Notes))
{
    <p><strong>Merknader:</strong> @Model.Notes</p>
}
@if (Model.OwnerRemoved)
{
    <p class="text-warning">Eieren er fjernet fra systemet.</p>
}
else if (Model.OwnerEmail != null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Eier</h5>
            <p class="mb-1">@(string.IsNullOrEmpty(Model.OwnerName) ? "Navn ikke oppgitt" : Model.OwnerName)</p>
            <p class="mb-1">E-post: <a href="mailto:@Model.OwnerEmail">@Model.OwnerEmail</a></p>
            <p class="mb-0">
                Telefon: @if (string.IsNullOrEmpty(Model.OwnerPhone)) {
                <span>Ikke oppgitt</span>
            } else
            {
                <a href="tel:@Model.OwnerPhone">@Model.OwnerPhone</a>
            }
        </p>
    </div>
</div>
}


<!-- Address, date and position - Docs: Converting times between time zones -->
<!-- https://learn.microsoft.com/dotnet/standard/datetime/converting-between-time-zones -->
<p>Adresse: @(string.IsNullOrEmpty(Model.Address) ? "Ikke oppgitt" : $"{Model.Address}, {Model.ZipCode} {Model.City}")</p>

@if (Model.CreatedAt != null)
{
    var osloTime = TimeZoneInfo.ConvertTimeFromUtc(Model.CreatedAt.Value, TimeZoneInfo.FindSystemTimeZoneById("Europe/Oslo"));
    <p>Registrert: @osloTime.ToString("dd.MM.yyyy HH:mm")</p>
}

@* "Utlån": which needs the resource has been lent to. Only operator, admin and the owner (CanEdit) see it *@
@if (Model.Id != null && (Model.CanEdit || User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Operator)))
{
    var loans = RequestRepository.GetLoansForResource(Model.Id.Value);
    var oslo = TimeZoneInfo.FindSystemTimeZoneById("Europe/Oslo");
    string When(DateTime? utc) => utc == null ? "–" : TimeZoneInfo.ConvertTimeFromUtc(utc.Value, oslo).ToString("dd.MM.yyyy HH:mm");

    <h2 class="h5 mt-4">📦 Utlån (@loans.Count)</h2>
    @if (loans.Count == 0)
    {
        <p class="text-body-secondary">Ressursen har ikke vært utlånt ennå.</p>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col">Behov</th>
                        <th scope="col">Sa ja</th>
                        <th scope="col">Levert</th>
                        <th scope="col">Levert tilbake</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in loans)
                    {
                        <tr>
                            <td>
                                @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Operator))
                                {
                                    <a asp-controller="ResourceNeed" asp-action="Index" asp-route-id="@loan.NeedId">@loan.NeedName</a>
                                }
                                else
                                {
                                    @loan.NeedName
                                }
                                <div class="small text-body-secondary">@(loan.Delivery == DeliveryMethod.Hentes ? "Hentes" : "Eieren leverer")</div>
                            </td>
                            <td class="small">@When(loan.AnsweredAt)</td>
                            <td class="small">@When(loan.DeliveredAt)</td>
                            <td class="small">@When(loan.ReturnedAt)</td>
                            <td>
                                @if (loan.ReturnedAt != null)
                                {
                                    <span class="badge text-bg-secondary">↩ Levert tilbake</span>
                                }
                                else if (loan.DeliveredAt != null)
                                {
                                    <span class="badge text-bg-info">📦 I bruk</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">✓ Avtalt</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
@if (Model.Latitude != null && Model.Longitude != null)
{
    <a class="btn btn-sm btn-outline-secondary mb-2" asp-controller="Home" asp-action="Map" asp-route-focus="@Model.Id">🗺 Vis på hovedkartet</a>
}

@if (Model.Latitude != null && Model.Longitude != null)
{
    <div id="detailMap" style="height: 300px;"
         data-lat="@Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         data-lng="@Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"></div>
}

@section Scripts {
    <script>
        // Show the resource's position on a small map - Docs: Leaflet API reference
        // https://leafletjs.com/reference.html
        const mapDiv = document.getElementById('detailMap');
        if (mapDiv) {
            const lat = parseFloat(mapDiv.dataset.lat);
            const lng = parseFloat(mapDiv.dataset.lng);
            const detailMap = L.map('detailMap').setView([lat, lng], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(detailMap);
            L.marker([lat, lng]).addTo(detailMap);
        }
    </script>
}