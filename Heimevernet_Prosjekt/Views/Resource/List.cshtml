@using Heimevernet_Prosjekt.Models.ViewModels.Resource
@model List<ResourceViewModel>

@{
    ViewData["Title"] = "Ressurser";
}

<h1>Ressurser</h1>

<a class="btn btn-primary mb-3"
   asp-controller="ResourceHandler"
   asp-action="Create">
    + Opprett ny ressurs
</a>

@* Shows the active search/filter from the menu, with links to the map and to clear it (text, not only color) *@
@{
    var query = Context.Request.Query;
    var activeSearch = query["search"].ToString();
    var activeType = query["type"].ToString();
    var activeWhere = query["where"].ToString();
    var hasPlace = query["lat"].ToString() != "";
}
@if (activeSearch != "" || activeType != "" || hasPlace)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">
        <span>
            <strong>Filter aktivt:</strong>
            @if (activeSearch != "")
            {
                <span>«@activeSearch»</span>
            }
            @if (activeType != "")
            {
                <span>· type @activeType</span>
            }
            @if (hasPlace)
            {
                <span>· innen @query["radius"] km fra @(activeWhere == "" ? "valgt punkt" : activeWhere)</span>
            }
        </span>
        <a href="@Url.Action("Map", "Home")@Context.Request.QueryString" class="btn btn-sm btn-primary">Vis på kart</a>
        <a asp-action="List" class="btn btn-sm btn-outline-secondary">Nullstill</a>
    </div>
}

@if (!Model.Any())
{
    <p>Ingen ressurser funnet.</p>
}
else
{
    @* Allow horizontal scrolling when the table does not fit. *@
    <div class="table-responsive"
         role="region"
         aria-label="Registrerte ressurser"
         tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Navn</th>
                    <th scope="col">Type</th>
                    <th scope="col">Beskrivelse</th>
                    <th scope="col">Handlinger</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="Resource"
                               asp-action="Index"
                               asp-route-id="@r.Id">@r.Name</a>
                        </td>
                        <td>@r.Type</td>
                        <td>@r.Description</td>
                        <td>
                            @* Keep space between buttons and allow wrapping. *@
                            <div class="d-flex flex-wrap gap-2">
                                @* Buttons only show if the user is allowed (CanEdit/CanDelete set in ResourceController) *@
                                @if (r.CanEdit)
                                {
                                    @* A minimum height of 44px makes tapping easier. *@
                                    <a class="btn btn-secondary d-inline-flex align-items-center justify-content-center"
                                       style="min-height: 44px; min-width: 44px;"
                                       asp-controller="ResourceHandler"
                                       asp-action="Edit"
                                       asp-route-id="@r.Id">
                                        Rediger
                                    </a>
                                }

                                @if (r.CanDelete)
                                {
                                    @* Keep deletion as a POST with confirmation. *@
                                    <form asp-controller="ResourceHandler"
                                          asp-action="Delete"
                                          asp-route-id="@r.Id"
                                          method="post"
                                          class="m-0">
                                        <button type="submit"
                                                class="btn btn-danger"
                                                style="min-height: 44px; min-width: 44px;"
                                                onclick="return confirm('Er du sikker på at du vil slette denne ressursen?');">
                                            Slett
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}