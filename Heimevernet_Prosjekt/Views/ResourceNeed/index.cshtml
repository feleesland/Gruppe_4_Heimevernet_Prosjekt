@using Heimevernet_Prosjekt.Models.ViewModels.ResourceNeed
@using Heimevernet_Prosjekt.Models.Entities
@using System.Globalization
@model ResourceNeedViewModel
@inject Heimevernet_Prosjekt.DataAccess.IResourceReportRepository ReportRepository
@{
    ViewData["Title"] = Model.Name;
    var planned = Model.Urgency == NeedUrgency.Planlagt;
    var active = Model.ClosedAt == null;
    var updates = ViewData["Updates"] as IReadOnlyList<NeedUpdate> ?? new List<NeedUpdate>(); // "Info til innbyggere", newest first
    var log = ViewData["Log"] as IReadOnlyList<ResourceNeedLog> ?? new List<ResourceNeedLog>();
    // Resources reported as wrong ("feil info"): shown as ⚑ in the suggestions, so the operator can choose another (fetched once)
    var openReports = ReportRepository.CountOpenByResource();
    var hasMeeting = Model.MeetingLatitude != null && Model.MeetingLongitude != null;
    var meetingKm = hasMeeting && Model.Latitude != null && Model.Longitude != null
        ? DistanceKm(Model.Latitude.Value, Model.Longitude.Value, Model.MeetingLatitude!.Value, Model.MeetingLongitude!.Value)
        : (double?)null;
    var anySuggestions = active && Model.Lines.Any(l => !l.IsCovered && l.Suggestions.Count > 0);
    // In the side panel on the map (?embed=1): no menu, and no small map (the big map shows the dots)
    var embed = Context.Request.Query["embed"] == "1";
    if (embed)
    {
        Layout = "_EmbedLayout";
    }
    var showMap = !embed && Model.Latitude != null && Model.Longitude != null;
    var radiusText = RadiusText(Model.RadiusKm);

    // «Neste steg»: one «Finn …» button per line that can be searched (it opens the line), and «Øk radius» when nothing
    // is free inside the circle (help with AI)
    void NextButtons(IEnumerable<NeedLineViewModel> lines, bool far)
    {
        var first = true;
        <div class="np-next-actions">
            @foreach (var l in lines.Where(l => l.Suggestions.Count > 0))
            {
                <button type="button" class="btn btn-sm @(first ? "btn-danger" : "rf-reset")" data-open-line="@l.ItemId">
                    <i class="ti ti-search" aria-hidden="true"></i> Finn @l.Type
                </button>
                first = false;
            }
            @if (far)
            {
                <a class="btn btn-sm rf-reset" href="@Url.Action("Edit", "ResourceNeedHandler", new { id = Model.Id, embed = embed ? "1" : null })">
                    <i class="ti ti-circle-dashed" aria-hidden="true"></i> Øk radius
                </a>
            }
        </div>
    }
}

@functions {
    // Times are saved as UTC and shown in Norwegian time - Docs: Converting times between time zones
    // https://learn.microsoft.com/dotnet/standard/datetime/converting-between-time-zones
    private static readonly TimeZoneInfo Oslo = TimeZoneInfo.FindSystemTimeZoneById("Europe/Oslo");
    private static readonly CultureInfo Norwegian = CultureInfo.GetCultureInfo("nb-NO");
    private static string OsloTime(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(utc, Oslo).ToString("dd.MM.yyyy HH:mm");
    private static string OsloShort(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(utc, Oslo).ToString("dd.MM HH:mm");
    private static string Invariant(double value) => value.ToString(CultureInfo.InvariantCulture);

    // Request status as text + colour (not colour alone). The "when" lines must come before plain Godtatt
    private static (string Text, string Css) StatusBadge(RequestRowViewModel r) => r.Status switch
    {
        RequestStatus.Sendt when r.Unanswered => ("Ikke svart", "text-bg-secondary"),
        RequestStatus.Sendt => ($"⏳ Venter · svar innen {OsloShort(r.AnswerBy)}", "text-bg-warning"),
        RequestStatus.Godtatt when r.ReturnedAt != null => ($"↩︎ Levert tilbake {OsloShort(r.ReturnedAt.Value)}", "text-bg-light"),
        RequestStatus.Godtatt when r.DeliveredAt != null => ($"📦 Levert {OsloShort(r.DeliveredAt.Value)} · i bruk", "text-bg-info"),
        RequestStatus.Godtatt => ((r.Delivery == DeliveryMethod.Hentes ? "✓ Godtatt · må hentes" : "✓ Godtatt · leverer") + (r.ConfirmedByPhone ? " · ☎" : ""), "text-bg-success"),
        RequestStatus.Avslatt => ("✗ Avslått" + (r.ConfirmedByPhone ? " · ☎" : ""), "text-bg-secondary"),
        RequestStatus.IkkeLengerNodvendig => ("Ikke lenger nødvendig", "text-bg-light"),
        _ => ("Avbrutt", "text-bg-secondary")
    };

    // The line's state on the overview, icon + text (help with AI)
    private static (string Text, string Css) LineBadge(NeedLineViewModel line) =>
        line.IsCovered ? ("✓ Dekket", "text-bg-success")
        : line.Accepted > 0 ? ($"◐ {line.Accepted} av {line.Quantity}", "text-bg-warning")
        : line.Requests.Any(r => r.Status == RequestStatus.Sendt) ? ($"⏳ 0 av {line.Quantity}", "text-bg-warning")
        : ($"○ 0 av {line.Quantity}", "text-bg-danger");

    // How many are free for a line: "3 ledige innen 5 km", "ingen innen 5 km · nærmeste 7,2 km" or "ingen ledige i hele området"
    // (the same words as «Mangler» on Oversikt) (help with AI)
    private static string FreeText(NeedLineViewModel line, string radiusText)
    {
        if (line.Suggestions.Count == 0) return "ingen ledige i hele området";
        var inside = line.Suggestions.Count(s => s.InsideCircle);
        if (inside > 0) return $"{inside} {(inside == 1 ? "ledig" : "ledige")} innen {radiusText}";
        var known = line.Suggestions.Where(s => s.DistanceKm != null).Select(s => s.DistanceKm!.Value).ToList();
        return known.Count > 0 ? $"ingen innen {radiusText} · nærmeste {KmText(known.Min())}" : $"ingen innen {radiusText}";
    }

    // A short text under the line: who has said yes, how many we wait for, and how many are free (help with AI)
    private static string LineNote(NeedLineViewModel line, bool active, string radiusText)
    {
        var parts = new List<string>();
        var yes = line.Requests.Where(r => r.Status == RequestStatus.Godtatt && r.ReturnedAt == null).ToList();
        if (yes.Count == 1)
        {
            var r = yes[0];
            parts.Add(r.DeliveredAt != null ? $"{r.OwnerName}: levert" : r.Delivery == DeliveryMethod.Hentes ? $"{r.OwnerName}: må hentes" : $"{r.OwnerName} leverer");
        }
        else if (yes.Count > 1)
        {
            parts.Add(string.Join(", ", yes.Take(2).Select(r => r.OwnerName)) + (yes.Count > 2 ? $" +{yes.Count - 2}" : "") + " har sagt ja");
        }
        var waiting = line.Requests.Count(r => r.Status == RequestStatus.Sendt && !r.Unanswered);
        var unanswered = line.Requests.Count(r => r.Status == RequestStatus.Sendt && r.Unanswered);
        if (waiting > 0) parts.Add($"venter på {waiting}");
        if (unanswered > 0) parts.Add($"{unanswered} ikke svart");
        // Nobody is being asked: say if anyone has been asked, and how many are free
        if (active && !line.IsCovered && waiting + unanswered == 0)
        {
            if (line.Requests.Count == 0) parts.Add("ingen spurt");
            parts.Add(FreeText(line, radiusText));
        }
        return parts.Count == 0 ? "" : string.Join(" · ", parts);
    }

    // Distance in km between two points (the haversine formula)
    private static double DistanceKm(double lat1, double lng1, double lat2, double lng2)
    {
        static double Rad(double d) => d * Math.PI / 180;
        var a = Math.Pow(Math.Sin(Rad(lat2 - lat1) / 2), 2)
              + Math.Cos(Rad(lat1)) * Math.Cos(Rad(lat2)) * Math.Pow(Math.Sin(Rad(lng2 - lng1) / 2), 2);
        return 6371 * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
    }

    private static string KmText(double km) => km < 1 ? $"{Math.Round(km * 100) * 10:0} m" : km.ToString("0.0", Norwegian) + " km";

    // The radius: "500 m" or "5 km"
    private static string RadiusText(double km) => km < 1 ? $"{km * 1000:0} m" : km.ToString("0.#", Norwegian) + " km";

    // How long the need lasted: "40 min", "5 t" or "3 d" (help with AI)
    private static string DurationText(TimeSpan t) =>
        t.TotalHours < 1 ? $"{(int)t.TotalMinutes} min" : t.TotalHours < 48 ? $"{(int)t.TotalHours} t" : $"{(int)t.TotalDays} d";

    // "1,2 km", "4,6 km · utenfor sirkelen" or "ukjent avstand"
    private static string DistanceText(SuggestionViewModel s) =>
        s.DistanceKm == null ? "ukjent avstand" : KmText(s.DistanceKm.Value) + (s.InsideCircle ? "" : " · utenfor sirkelen");
}

<link rel="stylesheet" href="~/css/need-page.css" asp-append-version="true" />

@if (TempData["Message"] != null)
{
    var undoText = TempData["UndoText"] as string;
    <div class="alert alert-success d-flex flex-wrap align-items-center gap-2" role="status">
        <span>@TempData["Message"]</span>
        @* «Angre» after Publiser or Fjern in "Info til innbyggere": puts back what was there before (help with AI) *@
        @if (undoText != null)
        {
            <form asp-controller="ResourceNeedHandler" asp-action="UndoUpdate" method="post" class="ms-auto">
                <input type="hidden" name="needId" value="@Model.Id" />
                <input type="hidden" name="restoreText" value="@undoText" />
                @if (embed)
                {
                    <input type="hidden" name="embed" value="1" />
                }
                <button type="submit" class="btn btn-sm btn-outline-success py-0"><i class="ti ti-arrow-back-up" aria-hidden="true"></i> Angre</button>
            </form>
        }
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

@* Back to where you came from (help with AI): «← Oversikt» from Oversikt (?from=overview, remembered by need-page.js after
   a form is sent), otherwise «← Alle behov». From the Behov list it goes back with the same filter (need-page.js) *@
@if (!embed)
{
    var fromOverview = Context.Request.Query["from"] == "overview";
    <a href="@(fromOverview ? Url.Action("Overview", "ResourceNeed") : Url.Action("List", "ResourceNeed"))" class="np-back np-noprint" id="npBack"
       data-overview="@Url.Action("Overview", "ResourceNeed")">
        <i class="ti ti-arrow-left" aria-hidden="true"></i> <span>@(fromOverview ? "Oversikt" : "Alle behov")</span>
    </a>
}

@* The top: name and badges, and the actions on the right (they wrap under on small screens) *@
<div class="np-head">
    <div class="np-title">
        <h1 class="mb-0 @(embed ? "h4" : "h3")">@Model.Name</h1>
        @* Icon + text, not colour alone *@
        @if (planned)
        {
            <span class="badge text-bg-warning">📅 Planlagt</span>
        }
        else
        {
            <span class="badge text-bg-danger">⏰ Akutt</span>
        }
        <partial name="_NeedStatusBadge" model="Model.Status" />
        @* How much is covered, or how much is still out, next to the status *@
        @{
            var coverOut = Model.Lines.SelectMany(l => l.Requests).Count(r => r.Status == RequestStatus.Godtatt && r.ReturnedAt == null);
            var coverText = Model.Status switch
            {
                NeedStatus.Lost => "",
                NeedStatus.LeverTilbake => $"{coverOut} ute",
                _ => $"{Model.Lines.Sum(l => Math.Min(l.Accepted, l.Quantity))}/{Model.Lines.Sum(l => l.Quantity)} dekket"
            };
        }
        @if (coverText != "")
        {
            <span class="need-cover">· @coverText</span>
        }
    </div>
    <div class="np-actions np-noprint">
        @* Export: print / PDF now; CSV and JSON come later *@
        <div class="dropdown">
            <button type="button" class="btn btn-sm rf-reset dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Eksporter">
                <i class="ti ti-download" aria-hidden="true"></i> @(embed ? "" : "Eksporter")
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><button type="button" class="dropdown-item" data-need-export="print"><i class="ti ti-printer" aria-hidden="true"></i> Skriv ut / PDF</button></li>
                <li><button type="button" class="dropdown-item" data-need-export="csv"><i class="ti ti-file-spreadsheet" aria-hidden="true"></i> CSV (Excel)</button></li>
                <li><button type="button" class="dropdown-item" data-need-export="json"><i class="ti ti-braces" aria-hidden="true"></i> JSON</button></li>
            </ul>
        </div>
        @if (active && Model.Latitude != null && Model.Longitude != null)
        {
            <a class="btn btn-sm btn-primary"
               asp-controller="ResourceNeedHandler" asp-action="Create"
               asp-route-lat="@Invariant(Model.Latitude.Value)" asp-route-lng="@Invariant(Model.Longitude.Value)"
               asp-route-add="@Model.Id"
               asp-route-embed="@(embed ? "1" : null)">
                <i class="ti ti-plus" aria-hidden="true"></i> @(embed ? "Mer" : "Legg til mer")
            </a>
        }
        @if (active)
        {
            <a class="btn btn-sm rf-reset" asp-controller="ResourceNeedHandler" asp-action="Edit" asp-route-id="@Model.Id" asp-route-embed="@(embed ? "1" : null)">
                <i class="ti ti-pencil" aria-hidden="true"></i> Rediger
            </a>
            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#closeModal">
                <i class="ti ti-circle-check" aria-hidden="true"></i> Avslutt
            </button>
        }
    </div>
</div>

<div class="np-layout @(showMap ? "has-map" : "")">
    <div class="np-main">
        @* «Neste steg» (help with AI): the same words as on Oversikt, with the buttons that do the work.
           Ring (who has not answered in time), spør (the lines nobody is being asked for), vent, or all covered *@
        @if (active && Model.Lines.Count > 0)
        {
            var missingLines = Model.Lines.Where(l => !l.IsCovered).ToList();
            // Each overdue request with its line, so the same resource asked on two lines shows which line it is (help with AI)
            var overdueReqs = Model.Lines
                .SelectMany(l => l.Requests.Where(r => r.Status == RequestStatus.Sendt && r.Unanswered).Select(r => (Line: l, Req: r)))
                .ToList();
            var waitingReqs = Model.Lines.SelectMany(l => l.Requests).Where(r => r.Status == RequestStatus.Sendt && !r.Unanswered).ToList();
            var idleLines = missingLines.Where(l => !l.Requests.Any(r => r.Status == RequestStatus.Sendt)).ToList();
            // The same type on two lines is said once ("Lokaler", not "Lokaler. Lokaler")
            var idleTypes = idleLines.GroupBy(l => l.Type).Select(g => g.First()).ToList();
            var far = idleTypes.Any(l => !l.Suggestions.Any(s => s.InsideCircle));
            // Said yes, not delivered yet: shown with a «📦 Levert» button each, under the next step (help with AI)
            var undelivered = Model.Lines
                .SelectMany(l => l.Requests.Where(r => r.Status == RequestStatus.Godtatt && r.DeliveredAt == null && r.ReturnedAt == null).Select(r => (Line: l, Req: r)))
                .OrderBy(x => x.Req.SentAt)
                .ToList();

            if (overdueReqs.Count > 0)
            {
                var owners = overdueReqs.Select(x => x.Req.ResourceName).Distinct().Count();
                <section class="np-next is-hot np-noprint" aria-labelledby="npNextTitle">
                    <div id="npNextTitle" class="np-next-title"><i class="ti ti-phone" aria-hidden="true"></i> Neste steg: ring @(owners == 1 ? "1 eier" : $"{owners} eiere")</div>
                    <div class="np-next-why">@overdueReqs.Count har ikke svart innen fristen. Ring dem, eller gi mer tid.</div>
                    @foreach (var x in overdueReqs)
                    {
                        <div class="np-next-call">
                            <b>@x.Req.ResourceName</b>
                            <span class="text-body-secondary">· @x.Line.Type · @x.Req.OwnerName</span>
                            @if (!string.IsNullOrEmpty(x.Req.OwnerPhone))
                            {
                                <a href="tel:@x.Req.OwnerPhone" class="btn btn-sm btn-outline-danger"><i class="ti ti-phone" aria-hidden="true"></i> @x.Req.OwnerPhone</a>
                            }
                            else
                            {
                                <span class="small text-body-secondary">ingen telefon</span>
                            }
                            <form asp-controller="ResourceNeedHandler" asp-action="ExtendDeadline" method="post">
                                <input type="hidden" name="needId" value="@Model.Id" />
                                @if (embed)
                                {
                                    <input type="hidden" name="embed" value="1" />
                                }
                                <button type="submit" name="extend" value="@x.Req.Id:30" class="btn btn-sm rf-reset">+30 min</button>
                            </form>
                        </div>
                    }
                    @if (idleTypes.Count > 0)
                    {
                        <div class="np-next-why mt-2">Mangler også: @string.Join(". ", idleTypes.Select(l => $"{l.Type}: {FreeText(l, radiusText)}")).</div>
                        NextButtons(idleTypes, far);
                    }
                </section>
            }
            else if (idleTypes.Count > 0)
            {
                <section class="np-next is-hot np-noprint" aria-labelledby="npNextTitle">
                    <div id="npNextTitle" class="np-next-title">
                        <i class="ti @(far ? "ti-current-location" : "ti-plus")" aria-hidden="true"></i> Neste steg: @(far ? "spør lenger unna" : "spør ressurser")
                    </div>
                    <div class="np-next-why">@string.Join(". ", idleTypes.Select(l => $"{l.Type}: {(l.Requests.Count == 0 ? "ingen spurt, " : "")}{FreeText(l, radiusText)}")).</div>
                    @{
                        NextButtons(idleTypes, far);
                    }
                </section>
            }
            else if (missingLines.Count > 0)
            {
                <section class="np-next is-wait np-noprint" aria-labelledby="npNextTitle">
                    <div id="npNextTitle" class="np-next-title"><i class="ti ti-hourglass" aria-hidden="true"></i> Neste steg: vent på svar</div>
                    <div class="np-next-why">@waitingReqs.Count venter@(waitingReqs.Count > 0 ? $" · første frist {OsloShort(waitingReqs.Min(r => r.AnswerBy))}" : "").</div>
                </section>
            }
            else if (undelivered.Count == 0)
            {
                <section class="np-next is-ok np-noprint" aria-label="Neste steg">
                    <i class="ti ti-circle-check" aria-hidden="true"></i> Alt er dekket og levert.
                </section>
            }

            @* «📦 Sagt ja – ikke levert»: one row per resource with «📦 Levert», so nobody has to open the line to find it.
               Alone it is the next step (all covered); otherwise it comes under the red/yellow box *@
            if (undelivered.Count > 0)
            {
                <section class="np-next is-deliver np-noprint" aria-labelledby="npDeliverTitle">
                    <div id="npDeliverTitle" class="np-next-title">
                        <i class="ti ti-package" aria-hidden="true"></i> @(missingLines.Count == 0 ? "Neste steg: marker som levert" : "Sagt ja – ikke levert") (@undelivered.Count)
                    </div>
                    <div class="np-next-why">Trykk «Levert» når ressursen er kommet fram.</div>
                    @foreach (var x in undelivered)
                    {
                        <div class="np-next-call">
                            <b>@x.Req.ResourceName</b>
                            <span class="text-body-secondary">· @x.Line.Type · @x.Req.OwnerName @(x.Req.Delivery == DeliveryMethod.Hentes ? "· må hentes" : "leverer")</span>
                            <form asp-controller="ResourceNeedHandler" asp-action="MarkDelivered" method="post">
                                <input type="hidden" name="needId" value="@Model.Id" />
                                @if (embed)
                                {
                                    <input type="hidden" name="embed" value="1" />
                                }
                                <button type="submit" name="delivered" value="@x.Req.Id" class="btn btn-sm btn-success" aria-label="Marker @x.Req.ResourceName som levert">
                                    <i class="ti ti-package" aria-hidden="true"></i> Levert
                                </button>
                            </form>
                        </div>
                    }
                </section>
            }
        }

        @* Four short facts. 2×2 on phones and in the side panel *@
        <div class="np-facts">
            <div class="np-fact">
                <div class="np-fact-label"><i class="ti ti-clock" aria-hidden="true"></i> Når</div>
                <div class="np-fact-value">
                    @if (planned && Model.NeededFrom != null)
                    {
                        <text>@OsloShort(Model.NeededFrom.Value)</text>
                        @if (Model.NeededTo != null)
                        {
                            <text> – @OsloShort(Model.NeededTo.Value)</text>
                        }
                    }
                    else
                    {
                        <text>Nå</text>
                        @if (Model.NeededTo != null)
                        {
                            <text> · innen @OsloShort(Model.NeededTo.Value)</text>
                        }
                    }
                </div>
                @if (Model.CreatedAt != null)
                {
                    <div class="np-fact-small">
                        Meldt @OsloShort(Model.CreatedAt.Value)
                        @if (Model.OwnerRemoved)
                        {
                            <span class="text-warning-emphasis">· den som meldte er fjernet</span>
                        }
                        else if (!string.IsNullOrEmpty(Model.ReportedByName))
                        {
                            <text>av @Model.ReportedByName</text>
                            @if (!string.IsNullOrEmpty(Model.ReportedByPhone))
                            {
                                <text>·</text> <a href="tel:@Model.ReportedByPhone" class="np-link">☎ @Model.ReportedByPhone</a>
                            }
                        }
                    </div>
                }
            </div>

            <div class="np-fact">
                <div class="np-fact-label"><i class="ti ti-map-pin" aria-hidden="true"></i> Hvor</div>
                <div class="np-fact-value">@(string.IsNullOrEmpty(Model.Address) ? "Valgt i kartet" : Model.Address)</div>
                <div class="np-fact-small">
                    @(string.IsNullOrEmpty(Model.City) ? "" : $"{Model.ZipCode} {Model.City} · ")radius @radiusText
                </div>
            </div>

            <div class="np-fact">
                <div class="np-fact-label"><span class="meeting-flag np-flag-sm"><i class="ti ti-flag" aria-hidden="true"></i></span> Kontaktpunkt</div>
                <div class="np-fact-value">@(hasMeeting ? Model.MeetingPointName : "Samme sted som behovet")</div>
                @if (meetingKm != null)
                {
                    <div class="np-fact-small">
                        @KmText(meetingKm.Value) fra behovet
                        @if (showMap)
                        {
                            <text>·</text>
                            <button type="button" class="btn btn-link btn-sm p-0 align-baseline np-link" id="showMeeting">Vis på kartet</button>
                        }
                    </div>
                }
            </div>

            @* "Info til innbyggere": what is on the front page now. The whole box opens the window to publish, change or remove *@
            <button type="button" class="np-fact np-fact-button @(updates.Count > 0 && active ? "is-public" : "")" data-bs-toggle="modal" data-bs-target="#infoModal">
                <span class="np-fact-label"><i class="ti ti-world" aria-hidden="true"></i> Forsiden</span>
                @if (updates.Count > 0)
                {
                    <span class="np-fact-value np-clamp">«@updates[0].Text»</span>
                    <span class="np-fact-small">@OsloShort(updates[0].At) · @updates[0].UserName</span>
                }
                else
                {
                    <span class="np-fact-value text-body-secondary">Ikke publisert</span>
                    <span class="np-fact-small">@(active ? "Ingen info til innbyggere ennå" : "Ingen info ble publisert")</span>
                }
                @if (active)
                {
                    @* Looks like a button, so it is clear the box can be pressed *@
                    <span class="btn btn-sm rf-reset mt-2 align-self-start np-noprint">
                        <i class="ti @(updates.Count > 0 ? "ti-pencil" : "ti-send")" aria-hidden="true"></i> @(updates.Count > 0 ? "Endre / fjern" : "Publiser info")
                    </span>
                }
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="np-description"><i class="ti ti-notes" aria-hidden="true"></i> @Model.Description</p>
        }

        @{
            // The log: collapsed at the bottom with the latest entry while the need is active, open at the top when it is closed
            // Docs: Razor syntax - templated local functions https://learn.microsoft.com/aspnet/core/mvc/views/razor
            var latest = log.OrderByDescending(e => e.At).FirstOrDefault();
            void RenderLog(bool open)
            {
                <details class="np-log" open="@open">
                    <summary>
                        <span class="fw-semibold">📋 Logg (@log.Count)</span>
                        @if (latest != null)
                        {
                            <span class="np-log-latest">· siste: @OsloShort(latest.At) @latest.UserName · @latest.Text</span>
                        }
                    </summary>
                    @if (log.Count == 0)
                    {
                        <p class="text-body-secondary small mt-2 mb-0">Ingenting er logget ennå.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush mt-2">
                            @foreach (var entry in log)
                            {
                                <li class="list-group-item small px-0">
                                    <span class="text-body-secondary">@OsloShort(entry.At)</span>
                                    · <strong>@entry.UserName</strong>
                                    · @entry.Text
                                </li>
                            }
                        </ul>
                    }
                </details>
            }
        }
        @if (!active)
        {
            // The closed need (help with AI): why, a few numbers, what is still out (oldest first), and the log open.
            // The reason is read from the log line «Avsluttet behovet: «…»»
            var closeEntry = log.Where(e => e.Text.StartsWith("Avsluttet behovet")).OrderByDescending(e => e.At).FirstOrDefault();
            var closeReason = closeEntry == null ? null : closeEntry.Text[(closeEntry.Text.IndexOf('«') + 1)..].TrimEnd('»');
            var wanted = Model.Lines.Sum(l => l.Quantity);
            var covered = Model.Lines.Sum(l => Math.Min(l.Accepted, l.Quantity));
            var asked = Model.Lines.Sum(l => l.Requests.Count);
            var outList = Model.Lines.SelectMany(l => l.Requests)
                .Where(r => r.Status == RequestStatus.Godtatt && r.ReturnedAt == null)
                .OrderBy(r => r.DeliveredAt ?? r.SentAt)
                .ToList();

            <section class="mb-3" aria-labelledby="npClosedTitle">
                <h2 id="npClosedTitle" class="np-section-title">
                    <i class="ti ti-flag-check" aria-hidden="true"></i> Avsluttet @OsloShort(Model.ClosedAt!.Value)@(closeEntry != null ? $" av {closeEntry.UserName}" : "")
                </h2>
                @if (!string.IsNullOrEmpty(closeReason))
                {
                    <p class="np-description mb-2">«@closeReason»</p>
                }
                <div class="np-stats">
                    <div class="np-stat"><b>@covered av @wanted</b><span>dekket</span></div>
                    <div class="np-stat"><b>@asked</b><span>forespørsler sendt</span></div>
                    <div class="np-stat"><b>@(Model.CreatedAt != null ? DurationText(Model.ClosedAt.Value - Model.CreatedAt.Value) : "–")</b><span>varte</span></div>
                    <div class="np-stat @(outList.Count > 0 ? "is-out" : "")"><b>@outList.Count</b><span>ikke levert tilbake</span></div>
                </div>
            </section>

            @* «↩︎ Lever tilbake»: what is still out, the longest first. Red with ⚠ after 3 days (icon + text, not colour alone) *@
            @if (outList.Count > 0)
            {
                <section class="np-return" aria-labelledby="npReturnTitle">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h2 id="npReturnTitle" class="h6 mb-0">↩︎ Lever tilbake (@outList.Count)</h2>
                        @if (outList.Count > 1)
                        {
                            <form asp-controller="ResourceNeedHandler" asp-action="MarkAllReturned" method="post" class="ms-auto np-noprint">
                                <input type="hidden" name="needId" value="@Model.Id" />
                                @if (embed)
                                {
                                    <input type="hidden" name="embed" value="1" />
                                }
                                <button type="submit" class="btn btn-sm np-return-btn" data-confirm="Er alle @outList.Count ressursene levert tilbake til eierne?">↩︎ Marker alle</button>
                            </form>
                        }
                    </div>
                    <p class="small text-body-secondary mb-2">Behovet blir «Løst» når alt er levert tilbake til eierne.</p>
                    <div class="np-list">
                        @foreach (var r in outList)
                        {
                            var since = r.DeliveredAt ?? r.SentAt;
                            var days = (int)(DateTime.UtcNow - since).TotalDays;
                            <div class="np-req @(days >= 3 ? "is-late" : "")">
                                <div class="np-req-main">
                                    <b>@r.ResourceName</b>
                                    <span class="small text-body-secondary">
                                        · @r.OwnerName
                                        @if (!string.IsNullOrEmpty(r.OwnerPhone))
                                        {
                                            <text>·</text> <a href="tel:@r.OwnerPhone">☎ @r.OwnerPhone</a>
                                        }
                                    </span>
                                    <div class="small @(days >= 3 ? "text-danger-emphasis fw-semibold" : "text-body-secondary")">
                                        @(days >= 3 ? "⚠ " : "")@(r.DeliveredAt != null ? "Levert" : "Godtatt") @OsloShort(since) · @(days == 0 ? "ute i dag" : days == 1 ? "1 dag ute" : $"{days} dager ute")
                                    </div>
                                </div>
                                <form asp-controller="ResourceNeedHandler" asp-action="MarkReturned" method="post" class="np-noprint">
                                    <input type="hidden" name="needId" value="@Model.Id" />
                                    @if (embed)
                                    {
                                        <input type="hidden" name="embed" value="1" />
                                    }
                                    <button type="submit" name="returned" value="@r.Id" class="btn btn-sm np-return-btn"
                                            data-confirm="Er @r.ResourceName levert tilbake til eieren? Den blir ledig igjen.">
                                        ↩︎ Levert tilbake
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </section>
            }
            RenderLog(true);
        }

        @* One form for all lines, so the operator chooses on several lines and sends once *@
        <form asp-controller="ResourceNeedHandler" asp-action="SendRequests" method="post" id="requestForm">
            <input type="hidden" name="needId" value="@Model.Id" />
            @if (embed)
            {
                <input type="hidden" name="embed" value="1" />
            }

            @* The overview: one row per line. «Finn ▸» / «Vis ▸» opens the line (need-page.js).
               A line that still misses something has a light red background *@
            <section id="npOverview" aria-labelledby="npLinesTitle">
                <h2 id="npLinesTitle" class="np-section-title"><i class="ti ti-package" aria-hidden="true"></i> Hva trengs</h2>
                @if (Model.Lines.Count == 0)
                {
                    <p class="text-body-secondary">Ingen behov ennå.</p>
                }
                <div class="np-rows">
                    @foreach (var line in Model.Lines)
                    {
                        var badge = LineBadge(line);
                        var note = LineNote(line, active, radiusText);
                        var find = active && !line.IsCovered;
                        // 📦 Ikke levert (yellow) / 📦 Levert (blue) next to the line's badge, icon + text (help with AI)
                        var yesOut = line.Requests.Where(r => r.Status == RequestStatus.Godtatt && r.ReturnedAt == null).ToList();
                        var notDeliveredHere = yesOut.Count(r => r.DeliveredAt == null);
                        <button type="button" class="np-row @(find ? "is-missing" : "")" data-open-line="@line.ItemId" aria-controls="np-line-@line.ItemId">
                            <span class="np-row-main">
                                <b>@line.Quantity × @line.Type</b>
                                @if (note != "")
                                {
                                    <span class="np-row-note">@note</span>
                                }
                            </span>
                            @if (active && notDeliveredHere > 0)
                            {
                                <span class="badge np-badge-undelivered"><i class="ti ti-package" aria-hidden="true"></i> Ikke levert@(notDeliveredHere > 1 ? $" ({notDeliveredHere})" : "")</span>
                            }
                            else if (yesOut.Count > 0)
                            {
                                <span class="badge text-bg-info"><i class="ti ti-package" aria-hidden="true"></i> Levert</span>
                            }
                            <span class="badge @badge.Css">@badge.Text</span>
                            <span class="np-row-go @(find ? "is-find" : "")">@(find ? "Finn ▸" : "Vis ▸")</span>
                        </button>
                    }
                </div>
            </section>

            @* One view per line: the requests sent (SPURT) and the free resources (LEDIGE). Only one is shown at a time *@
            @foreach (var line in Model.Lines)
            {
                var badge = LineBadge(line);
                <section class="np-line" id="np-line-@line.ItemId" data-line="@line.ItemId" aria-labelledby="np-line-title-@line.ItemId" hidden>
                    <div class="np-line-head">
                        <button type="button" class="btn btn-link btn-sm px-0 np-link np-noprint" data-close-line>‹ Alle linjer</button>
                        <h2 id="np-line-title-@line.ItemId" class="h5 mb-0">@line.Quantity × @line.Type</h2>
                        <span class="badge @badge.Css">@badge.Text</span>
                    </div>

                    @if (line.Requests.Count > 0)
                    {
                        <h3 class="np-sub">Spurt (@line.Requests.Count)</h3>
                        <div class="np-list">
                            @foreach (var r in line.Requests)
                            {
                                var status = StatusBadge(r);
                                <div class="np-req">
                                    <div class="np-req-main">
                                        <b>@r.ResourceName</b>
                                        <span class="small text-body-secondary">
                                            · @r.OwnerName
                                            @if (!string.IsNullOrEmpty(r.OwnerPhone))
                                            {
                                                <text>·</text> <a href="tel:@r.OwnerPhone">☎ @r.OwnerPhone</a>
                                            }
                                        </span>
                                        <div class="d-flex flex-wrap align-items-center gap-1 mt-1">
                                            <span class="badge @status.Css">@status.Text</span>
                                            <span class="small text-body-secondary">sendt @OsloShort(r.SentAt)</span>
                                            @* Only answers the operator registered by phone can be undone (a misclick), not after delivery *@
                                            @if (r.ConfirmedByPhone && (r.Status == RequestStatus.Godtatt || r.Status == RequestStatus.Avslatt) && active && r.DeliveredAt == null)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-0"
                                                        formaction="@Url.Action("UndoAnswer", "ResourceNeedHandler")"
                                                        name="undo" value="@r.Id"
                                                        data-confirm="Angre svaret som ble registrert på telefon? Forespørselen venter på svar igjen.">
                                                    ↩︎ Angre
                                                </button>
                                            }
                                        </div>
                                        @if (r.ConfirmedByPhone && (r.Status == RequestStatus.Godtatt || r.Status == RequestStatus.Avslatt))
                                        {
                                            <div class="small text-body-secondary">☎ Svaret ble registrert av en operatør etter en telefonsamtale.</div>
                                        }
                                        @if (!string.IsNullOrEmpty(r.Comment))
                                        {
                                            <div class="small text-body-secondary">«@r.Comment»</div>
                                        }
                                    </div>

                                    @* The next step as a button you can see (help with AI): said yes, not delivered yet = «📦 Levert».
                                       It was hard to find in ⋯ (it is still there too) *@
                                    @if (r.Status == RequestStatus.Godtatt && r.DeliveredAt == null && r.ReturnedAt == null && active)
                                    {
                                        <button type="submit" class="btn btn-sm btn-success np-noprint"
                                                formaction="@Url.Action("MarkDelivered", "ResourceNeedHandler")"
                                                name="delivered" value="@r.Id"
                                                aria-label="Marker @r.ResourceName som levert">
                                            <i class="ti ti-package" aria-hidden="true"></i> Levert
                                        </button>
                                    }
                                    @* One small menu instead of many buttons. Every choice that changes much asks "Er du sikker?" - Docs: Bootstrap Dropdowns
                                       strategy fixed: the menu isn't cut off by the scrolling column *@
                                    @if ((r.Status == RequestStatus.Sendt && active) || (r.Status == RequestStatus.Godtatt && r.ReturnedAt == null))
                                    {
                                        <div class="dropdown np-noprint">
                                            <button type="button" class="btn btn-sm rf-reset" data-bs-toggle="dropdown"
                                                    data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false"
                                                    aria-label="Flere valg for @r.ResourceName">
                                                ⋯
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-end">
                                                @if (r.Status == RequestStatus.Sendt)
                                                {
                                                    <h6 class="dropdown-header">Eieren svarte på telefon:</h6>
                                                    <button type="submit" class="dropdown-item"
                                                            formaction="@Url.Action("ConfirmByPhone", "ResourceNeedHandler")"
                                                            name="phoneAnswer" value="@r.Id:leverer"
                                                            data-confirm="Registrere at eieren av @r.ResourceName sa ja på telefon og leverer selv?">
                                                        ✓ Ja – eieren leverer selv
                                                    </button>
                                                    <button type="submit" class="dropdown-item"
                                                            formaction="@Url.Action("ConfirmByPhone", "ResourceNeedHandler")"
                                                            name="phoneAnswer" value="@r.Id:hentes"
                                                            data-confirm="Registrere at eieren av @r.ResourceName sa ja på telefon, og at vi må hente den?">
                                                        ✓ Ja – vi må hente den
                                                    </button>
                                                    <button type="submit" class="dropdown-item"
                                                            formaction="@Url.Action("ConfirmByPhone", "ResourceNeedHandler")"
                                                            name="phoneAnswer" value="@r.Id:nei"
                                                            data-confirm="Registrere at eieren av @r.ResourceName sa nei på telefon?">
                                                        ✗ Nei – eieren kan ikke
                                                    </button>

                                                    <div class="dropdown-divider"></div>
                                                    <h6 class="dropdown-header">Gi mer tid:</h6>
                                                    <button type="submit" class="dropdown-item"
                                                            formaction="@Url.Action("ExtendDeadline", "ResourceNeedHandler")"
                                                            name="extend" value="@r.Id:30">
                                                        +30 min
                                                    </button>
                                                    <button type="submit" class="dropdown-item"
                                                            formaction="@Url.Action("ExtendDeadline", "ResourceNeedHandler")"
                                                            name="extend" value="@r.Id:60">
                                                        +1 time
                                                    </button>

                                                    <div class="dropdown-divider"></div>
                                                    <button type="submit" class="dropdown-item text-danger"
                                                            formaction="@Url.Action("CancelRequest", "ResourceNeedHandler")"
                                                            name="cancel" value="@r.Id"
                                                            data-confirm="Trekke tilbake forespørselen til @r.ResourceName? Eieren kan ikke svare på den lenger.">
                                                        Trekk tilbake forespørselen
                                                    </button>
                                                }
                                                else
                                                {
                                                    @* Accepted: delivered, returned, or cancel the yes (only before delivery) *@
                                                    @if (r.DeliveredAt == null && active)
                                                    {
                                                        <button type="submit" class="dropdown-item"
                                                                formaction="@Url.Action("MarkDelivered", "ResourceNeedHandler")"
                                                                name="delivered" value="@r.Id">
                                                            📦 Marker som levert
                                                        </button>
                                                    }
                                                    <button type="submit" class="dropdown-item"
                                                            formaction="@Url.Action("MarkReturned", "ResourceNeedHandler")"
                                                            name="returned" value="@r.Id"
                                                            data-confirm="Er @r.ResourceName levert tilbake til eieren? Den blir ledig igjen.">
                                                        ↩︎ Marker som levert tilbake
                                                    </button>
                                                    @if (r.DeliveredAt == null && active)
                                                    {
                                                        <div class="dropdown-divider"></div>
                                                        <button type="submit" class="dropdown-item text-danger"
                                                                formaction="@Url.Action("CancelRequest", "ResourceNeedHandler")"
                                                                name="cancel" value="@r.Id"
                                                                data-confirm="Avbryte bekreftelsen? @r.ResourceName blir ledig igjen, og behovet blir ikke dekket av den.">
                                                            Avbryt bekreftelsen
                                                        </button>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @* LEDIGE: free resources of the same type, nearest first. A row is a toggle «+ Spør» / «✓ Valgt» (a hidden checkbox) *@
                    @if (!line.IsCovered && active)
                    {
                        <div class="np-sub-row">
                            <h3 class="np-sub mb-0">Ledige · nærmest først</h3>
                            @if (line.Suggestions.Any(s => !s.InsideCircle))
                            {
                                <button type="button" class="np-chip ms-auto" data-inside-only aria-pressed="false">
                                    <i class="ti ti-circle-dashed" aria-hidden="true"></i> Bare innenfor sirkelen
                                </button>
                            }
                        </div>
                        @if (line.Suggestions.Count == 0)
                        {
                            <p class="text-body-secondary small mb-0">Ingen ledige ressurser av typen «@line.Type».</p>
                        }
                        else
                        {
                            <p class="small text-body-secondary mb-2">Spør gjerne flere enn @line.Quantity – de første som sier ja får oppdraget.</p>
                            <div class="np-list">
                                @foreach (var s in line.Suggestions)
                                {
                                    <label class="np-sug @(s.InsideCircle ? "" : "is-outside")">
                                        <input class="pick visually-hidden" type="checkbox" name="picks" value="@line.ItemId:@s.ResourceId"
                                               data-name="@s.Name" data-type="@line.Type" data-inside="@(s.InsideCircle ? "true" : "false")"
                                               data-lat="@(s.Latitude == null ? "" : Invariant(s.Latitude.Value))"
                                               data-lng="@(s.Longitude == null ? "" : Invariant(s.Longitude.Value))" />
                                        <span class="np-sug-main">
                                            <b>@s.Name</b>
                                            @if (openReports.ContainsKey(s.ResourceId))
                                            {
                                                @* Icon + text, not colour alone *@
                                                <span class="badge text-bg-warning ms-1" title="Admin er varslet om feil i denne ressursen">⚑ meldt som feil</span>
                                            }
                                            <span class="np-row-note">
                                                @s.OwnerName · @DistanceText(s)
                                                @if (!string.IsNullOrEmpty(s.OwnerPhone))
                                                {
                                                    <text>· ☎ @s.OwnerPhone</text>
                                                }
                                            </span>
                                        </span>
                                        <span class="np-ask" aria-hidden="true"><span class="np-ask-off">+ Spør</span><span class="np-ask-on">✓ Valgt</span></span>
                                    </label>
                                }
                            </div>
                        }
                    }
                    else if (line.IsCovered)
                    {
                        <p class="small text-success-emphasis mt-2 mb-0"><i class="ti ti-circle-check" aria-hidden="true"></i> Linjen er dekket.</p>
                    }
                </section>
            }

            @* One button for everything that is chosen, with one deadline. Shown in a line view, or when something is chosen *@
            @if (anySuggestions)
            {
                <div id="npSendBar" class="np-send np-noprint" hidden>
                    <button type="submit" id="sendButton" class="btn btn-primary" disabled>Velg ressurser</button>
                    <label class="small mb-0" for="answerMinutes">Svarfrist</label>
                    <select id="answerMinutes" name="answerMinutes" class="form-select form-select-sm w-auto">
                        <option value="30" selected="@(!planned)">30 min</option>
                        <option value="60">1 time</option>
                        <option value="180">3 timer</option>
                        <option value="1440" selected="@planned">1 døgn</option>
                        <option value="2880">2 døgn</option>
                    </select>
                </div>
            }
        </form>

        @if (active)
        {
            RenderLog(false);
        }
    </div>

    @* The map: the need, the circle, the ⚑ kontaktpunkt and the free resources - all lines that miss something,
       or only the open line (need-page.js) *@
    @if (showMap)
    {
        <div class="np-map-col">
            <div id="detailMap" class="np-map rounded"
                 data-lat="@Invariant(Model.Latitude!.Value)"
                 data-lng="@Invariant(Model.Longitude!.Value)"
                 data-radius="@Invariant(Model.RadiusKm)"
                 data-planned="@(planned ? "true" : "false")"
                 data-meeting-lat="@(hasMeeting ? Invariant(Model.MeetingLatitude!.Value) : "")"
                 data-meeting-lng="@(hasMeeting ? Invariant(Model.MeetingLongitude!.Value) : "")"
                 data-meeting-name="@Model.MeetingPointName"></div>
            @* Icon + text, not colour alone *@
            <div class="np-legend small">
                <span><i class="ti ti-map-pin-filled" aria-hidden="true"></i> Behovet</span>
                <span><span class="meeting-flag np-flag-sm"><i class="ti ti-flag" aria-hidden="true"></i></span> Kontaktpunkt</span>
                <span><span class="np-dot is-free"></span> Ledig</span>
                <span><span class="np-dot is-picked">✓</span> Valgt</span>
                <span><span class="np-dot is-outside"></span> Utenfor sirkelen</span>
            </div>
        </div>
    }
</div>

@* "Info til innbyggere" (help with AI): one short public message per need, shown on the front page and the map for everyone,
   without the resources. No message = the need is not public - Docs: Bootstrap Modal https://getbootstrap.com/docs/5.3/components/modal/ *@
<div class="modal fade" id="infoModal" tabindex="-1" aria-labelledby="infoModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="infoModalTitle"><i class="ti ti-world" aria-hidden="true"></i> Info til innbyggere</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Lukk"></button>
            </div>
            <div class="modal-body">
                <p class="small text-body-secondary">Vises på forsiden og kartet for alle, uten ressursene. En ny melding bytter ut den gamle.</p>

                @if (updates.Count > 0)
                {
                    <h3 class="h6">Publisert nå</h3>
                    <div class="d-flex gap-2 align-items-start border rounded p-2">
                        <div class="flex-grow-1">
                            <div>«@updates[0].Text»</div>
                            <div class="small text-body-secondary">@OsloShort(updates[0].At) · @updates[0].UserName</div>
                        </div>
                        @if (active)
                        {
                            <form asp-controller="ResourceNeedHandler" asp-action="RemoveUpdate" method="post">
                                <input type="hidden" name="needId" value="@Model.Id" />
                                @if (embed)
                                {
                                    <input type="hidden" name="embed" value="1" />
                                }
                                <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap"><i class="ti ti-trash" aria-hidden="true"></i> Fjern</button>
                            </form>
                        }
                    </div>
                }
                else
                {
                    <p class="small text-body-secondary mb-0"><i class="ti ti-info-circle" aria-hidden="true"></i> Ingenting er publisert ennå. Behovet vises ikke på forsiden før noe er publisert.</p>
                }

                @if (active)
                {
                    <form asp-controller="ResourceNeedHandler" asp-action="PublishUpdate" method="post">
                        <input type="hidden" name="needId" value="@Model.Id" />
                        @if (embed)
                        {
                            <input type="hidden" name="embed" value="1" />
                        }
                        <h3 class="h6 mt-3">@(updates.Count > 0 ? "Bytt melding" : "Ny melding")</h3>
                        @* Quick texts fill the field; the operator writes the rest *@
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var quick in new[] { ("Unngå området", "Unngå området rundt "), ("Veien er stengt", "Veien er stengt. Bruk omkjøring via "), ("Evakuering", "Evakuerte kan møte på "), ("Strømbrudd", "Strømbrudd i området. "), ("Øvelse", "Heimevernet øver i området. ") })
                            {
                                <button type="button" class="btn btn-sm rf-reset rounded-pill" data-quick="@quick.Item2">@quick.Item1</button>
                            }
                        </div>
                        <label for="updateText" class="visually-hidden">Kort melding</label>
                        <textarea id="updateText" name="updateText" class="form-control" rows="2" maxlength="300" required placeholder="Kort tekst alle kan se, f.eks. «Unngå området rundt Lund»"></textarea>
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <span id="updateCount" class="small text-body-secondary">0 / 300</span>
                            <button type="button" class="btn rf-reset ms-auto" data-bs-dismiss="modal">Avbryt</button>
                            <button type="submit" class="btn btn-success"><i class="ti ti-send" aria-hidden="true"></i> Publiser</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@if (active)
{
    // "Avslutt": the reason must be written. Warns when resources are still out
    var stillOut = Model.Lines.SelectMany(l => l.Requests).Count(r => r.Status == RequestStatus.Godtatt && r.ReturnedAt == null);
    <div class="modal fade" id="closeModal" tabindex="-1" aria-labelledby="closeModalTitle" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-controller="ResourceNeedHandler" asp-action="Close" method="post" class="modal-content">
                <input type="hidden" name="needId" value="@Model.Id" />
                @if (embed)
                {
                    <input type="hidden" name="embed" value="1" />
                }
                <div class="modal-header">
                    <h2 class="modal-title h5" id="closeModalTitle">Avslutt behov</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Lukk"></button>
                </div>
                <div class="modal-body">
                    @if (stillOut > 0)
                    {
                        <div class="alert alert-warning py-2 small" role="alert">
                            ⚠ @stillOut ressurs(er) er ikke markert som levert tilbake. Det kan gjøres etterpå også.
                        </div>
                    }
                    <label for="closeNote" class="form-label">Hvorfor avsluttes behovet? <span class="text-danger">*</span></label>
                    <textarea id="closeNote" name="closeNote" class="form-control" rows="3" maxlength="400" required
                              placeholder="F.eks. «Flommen er over, alle har fått hjelp»"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn rf-reset" data-bs-dismiss="modal">Avbryt</button>
                    <button type="submit" class="btn btn-danger">Avslutt behov</button>
                </div>
            </form>
        </div>
    </div>
}

@* Eksporter (help with AI): one row per request (a line without requests gets one row of its own).
   CSV gets the rows; JSON gets the need with the rows inside. Made in the browser by resource-export.js *@
@{
    string? Time(DateTime? utc) => utc == null ? null : OsloTime(utc.Value);
    var exportRows = Model.Lines.SelectMany(line =>
        (line.Requests.Count == 0 ? new RequestRowViewModel?[] { null } : line.Requests.Select(r => (RequestRowViewModel?)r))
        .Select(r => new Dictionary<string, object?>
        {
            ["Linje"] = line.Type,
            ["Antall"] = line.Quantity,
            ["Dekket"] = $"{Math.Min(line.Accepted, line.Quantity)} av {line.Quantity}",
            ["Ressurs"] = r?.ResourceName,
            ["Eier"] = r?.OwnerName,
            ["Telefon"] = r?.OwnerPhone,
            ["Status"] = r == null ? "Ikke spurt" : StatusBadge(r).Text,
            ["Sendt"] = Time(r?.SentAt),
            ["Levert"] = Time(r?.DeliveredAt),
            ["Levert tilbake"] = Time(r?.ReturnedAt)
        })).ToList();
    var exportData = new Dictionary<string, object?>
    {
        ["Behov"] = Model.Name,
        ["Id"] = Model.Id,
        ["Hastegrad"] = planned ? "Planlagt" : "Akutt",
        ["Status"] = Model.Status.ToString(),
        ["Adresse"] = string.Join(", ", new[] { Model.Address, Model.ZipCode, Model.City }.Where(s => !string.IsNullOrWhiteSpace(s))),
        ["Radius (km)"] = Model.RadiusKm,
        ["Kontaktpunkt"] = hasMeeting ? Model.MeetingPointName : "Samme sted som behovet",
        ["Meldt"] = Time(Model.CreatedAt),
        ["Trengs fra"] = Time(Model.NeededFrom),
        ["Trengs til"] = Time(Model.NeededTo),
        ["Avsluttet"] = Time(Model.ClosedAt),
        ["Linjer"] = exportRows
    };
}
<script type="application/json" id="needExport">@Json.Serialize(exportData)</script>

@* «Sist åpnet»: last-opened.js remembers this need for Oversikt and Behov *@
<div id="lastOpened" hidden data-kind="need" data-id="@Model.Id" data-name="@Model.Name" data-url="@Url.Action("Index", "ResourceNeed", new { id = Model.Id })"></div>

@* Data for need-page.js *@
<div id="needPage" hidden data-need-id="@Model.Id" data-need-name="@Model.Name"
     data-meeting-name="@Model.MeetingPointName"
     data-meeting-lat="@(hasMeeting ? Invariant(Model.MeetingLatitude!.Value) : "")"
     data-meeting-lng="@(hasMeeting ? Invariant(Model.MeetingLongitude!.Value) : "")"></div>

@section Scripts {
    <script src="~/js/need-page.js" asp-append-version="true"></script>
    <script src="~/js/resource-export.js" asp-append-version="true"></script>
    <script src="~/js/last-opened.js" asp-append-version="true"></script>
}
