@using Heimevernet_Prosjekt.Models.ViewModels.ResourceNeed
@model List<ResourceNeedViewModel>
@{
    ViewData["Title"] = "Behov";
}

<h1>@ViewData["Title"]</h1>

<a class="button" asp-controller="ResourceNeedHandler" asp-action="Create">+ Opprett nytt behov</a>

@if (!Model.Any())
{
    <p>Ingen behov funnet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Navn</th>
                    <th scope="col">Når</th>
                    <th scope="col">Hva trengs</th>
                    <th scope="col">Handlinger</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Index" asp-route-id="@r.Id">@r.Name</a>
                            @if (r.ClosedAt != null)
                            {
                                <span class="badge text-bg-secondary">Avsluttet</span>
                            }
                        </td>
                        <td>
                            @* Icon + text, not colour alone *@
                            @if (r.Urgency == Heimevernet_Prosjekt.Models.Entities.NeedUrgency.Planlagt)
                            {
                                <span class="badge text-bg-primary">📅 Planlagt</span>
                            }
                            else
                            {
                                <span class="badge text-bg-danger">⏰ Akutt</span>
                            }
                        </td>
                        <td>
                            @if (r.Items.Count == 0)
                            {
                                <span class="text-muted">@r.Type</span>
                            }
                            else
                            {
                                @string.Join(", ", r.Items.Select(i => $"{i.Quantity} × {i.Type}"))
                            }
                        </td>
                        <td>
                            <a class="btn btn-sm btn-secondary" asp-controller="ResourceNeedHandler" asp-action="Edit" asp-route-id="@r.Id">Rediger</a>

                            <form asp-controller="ResourceNeedHandler" asp-action="Delete" asp-route-id="@r.Id" method="post" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Er du sikker på at du vil slette dette behovet?');">
                                    Slett
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}