@using Heimevernet_Prosjekt.Models.ViewModels.Resource
@using Heimevernet_Prosjekt.Models.Entities
@model ResourceViewModel

@* "Ny ressurs" and "Endre ressurs" as a wizard in 3 easy steps (help with AI). Used by Create.cshtml and Edit.cshtml.
   resource-veiviser.js shows one step at a time; without JavaScript all steps are shown as one long form *@
@{
    var isEdit = Model.Id != null;
    var categories = (ViewData["Categories"] as IEnumerable<ResourceCategory> ?? [])
        .Where(category => category.Types.Count > 0) // a category without types is not shown (admin adds them later)
        .ToList();
    var allTypes = categories.SelectMany(category => category.Types).ToList();
    var currentType = Model.Type;
    var hasOldType = !string.IsNullOrEmpty(currentType) && !allTypes.Any(type => type.Name == currentType);
    var canSetStatus = isEdit && (User.IsInRole("Admin") || User.IsInRole("Operator"));
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var loginUrl = Url.Action("Register", "Account", new { returnUrl = Url.Action("Create", "ResourceHandler") }); // most guests are new: register first, "Logg inn" is right under
    string[] statuses = ["Ledig", "Opptatt", "Ugyldig", "Ikke tilgjengelig"];
    (int Step, string Label)[] stepLabels = [(0, "Type"), (1, "Om ressursen"), (2, "Hvor")];

    // The saved answer to a question, or "" (Edit, or the form coming back with an error)
    string Answer(int questionId) => Model.Answers.TryGetValue(questionId, out var value) ? value ?? "" : "";

    // The category's Tabler icon class ("car" or "ti-car" both work), with a default icon if it is empty
    string IconClass(string? icon) => string.IsNullOrEmpty(icon) ? "ti-category" : icon.StartsWith("ti-") ? icon : "ti-" + icon;
}

@* The step line: done = green ✓, the step you are on = blue "du er her", not started = grey *@
<ol class="wizard-steps" aria-label="Steg i skjemaet">
    @foreach (var (step, label) in stepLabels)
    {
        <li><span class="wizard-step-number">@(step + 1)</span><span class="wizard-step-label">@label</span></li>
    }
</ol>

<form asp-controller="ResourceHandler"
      asp-action="@(isEdit ? "Edit" : "Create")"
      asp-route-embed="@(Context.Request.Query["embed"] == "1" ? "1" : null)"
      method="post"
      enctype="multipart/form-data"
      id="resourceWizard"
      data-guest="@((!isLoggedIn).ToString().ToLower())"
      data-login-url="@loginUrl">

    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="alert alert-info" role="status" data-draft-note hidden></div>

    @* Two columns: the step on the left, "Din ressurs" on the right, the same on all 3 steps (on phones the summary comes first) *@
    <div class="wizard-layout">
        <div class="wizard-main">

            @* Step 1: the categories as cards. Pressing one opens its types right under the row, like a tab (only one open at a time).
               grid-auto-flow: dense in site.css keeps the other cards in their row *@
            <section class="wizard-step" aria-labelledby="stepTitle1">
                <div class="wizard-step-head">
                    <span class="wizard-step-icon"><i class="ti ti-category" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="stepTitle1" class="wizard-step-title" tabindex="-1">Hva vil du registrere?</h2>
                        <p class="wizard-help">Velg en kategori, og deretter typen.</p>
                    </div>
                </div>
                <span asp-validation-for="Type" class="text-danger d-block"></span>
                <p id="typeError" class="text-danger" role="alert" hidden>⚠️ Velg en type for å gå videre.</p>

                <div class="category-grid mb-3">
                    @foreach (var category in categories)
                    {
                        <button type="button" class="category-card" data-category="@category.Id"
                                aria-expanded="false" aria-controls="types@(category.Id)">
                            <i class="ti @IconClass(category.Icon) category-card-icon" aria-hidden="true"></i>
                            <span>
                                <span class="category-card-name">@category.Name</span>
                                <small class="category-card-types" data-count>@string.Join(", ", category.Types.Take(3).Select(type => type.Name))@(category.Types.Count > 3 ? $" + {category.Types.Count - 3} til" : "")</small>
                                <small class="category-card-picked" data-picked hidden>✓ <span data-picked-name></span> valgt</small>
                            </span>
                            <i class="ti @(category.Types.Count == 1 ? "ti-chevron-right" : "ti-chevron-down") category-card-arrow" aria-hidden="true"></i>
                        </button>

                        <fieldset class="category-panel" id="types@(category.Id)" data-types-for="@category.Id" hidden>
                            <legend class="visually-hidden">@category.Name</legend>
                            <div class="type-grid">
                                @foreach (var type in category.Types)
                                {
                                    <label class="type-card">
                                        <input type="radio" name="Type" value="@type.Name" checked="@(type.Name == currentType)"
                                               data-icon="@IconClass(type.Icon)" data-category-name="@category.Name" data-example="@type.Examples" />
                                        <i class="ti @IconClass(type.Icon) type-card-icon" aria-hidden="true"></i>
                                        <span class="type-card-name">@type.Name</span>
                                    </label>
                                }
                            </div>
                        </fieldset>
                    }
                </div>

                @if (hasOldType)
                {
                    <fieldset class="mb-3">
                        <legend class="h6 text-body-secondary">Gammel type</legend>
                        <div class="type-grid">
                            <label class="type-card">
                                <input type="radio" name="Type" value="@currentType" checked />
                                <span class="type-card-name">@currentType</span>
                                <small class="type-card-examples">Gammel type – velg gjerne en ny</small>
                            </label>
                        </div>
                    </fieldset>
                }
            </section>

            @* Step 2: "Om ressursen" - the name and picture at the top, the type's questions as cards in the middle,
               and "anything else" at the bottom. Only the chosen type's questions are shown and sent *@
            <section class="wizard-step" aria-labelledby="stepTitle2">
                <div class="wizard-step-head">
                    <span class="wizard-step-icon"><i class="ti ti-list-details" data-type-icon aria-hidden="true"></i></span>
                    <div>
                        <h2 id="stepTitle2" class="wizard-step-title" tabindex="-1">Om ressursen</h2>
                        <p class="wizard-help">Navnet er påkrevd. Resten er valgfritt, men det hjelper operatøren å velge riktig.</p>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-7">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="F.eks. Toyota RAV4" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-5">
                        <label asp-for="Image" class="form-label">Bilde (valgfritt)</label>
                        <input asp-for="Image"
                               type="file"
                               class="form-control"
                               accept="image/jpeg,image/png,image/webp"
                               aria-describedby="imageHelp" />
                        <small id="imageHelp" class="form-text d-block">
                            JPG, PNG eller WebP. Maksimalt 5 MB.
                            @(Model.HasImage ? "Velg et nytt bilde bare hvis du vil bytte." : "")
                        </small>
                        <span asp-validation-for="Image" class="text-danger"></span>
                        <input type="hidden" asp-for="HasImage" />
                    </div>
                </div>

                <h3 class="wizard-subtitle">Detaljer</h3>
                <p data-no-questions hidden>Ingen flere spørsmål for denne typen.</p>

                @foreach (var type in allTypes)
                {
                    <div class="wizard-questions" data-questions-for="@type.Name">
                        @if (type.Attributes.Count == 0)
                        {
                            <p>Ingen flere spørsmål for denne typen.</p>
                        }
                        @foreach (var question in type.Attributes)
                        {
                            var fieldId = $"answer{question.Id}";
                            var fieldName = $"Answers[{question.Id}]";
                            var value = Answer(question.Id);

                            <div class="wizard-question">
                                @if (question.Kind == AttributeKind.YesNo)
                                {
                                    <fieldset>
                                        <legend class="form-label">@question.Label</legend>
                                        <div class="btn-group" role="group">
                                            <input type="radio" class="btn-check" name="@fieldName" id="@(fieldId)yes" value="true" checked="@(value == "true")" />
                                            <label class="btn btn-outline-secondary" for="@(fieldId)yes">✓ Ja</label>
                                            <input type="radio" class="btn-check" name="@fieldName" id="@(fieldId)no" value="" checked="@(value != "true")" />
                                            <label class="btn btn-outline-secondary" for="@(fieldId)no">✕ Nei</label>
                                        </div>
                                    </fieldset>
                                }
                                else if (question.Kind == AttributeKind.Number)
                                {
                                    <label class="form-label" for="@fieldId">@question.Label</label>
                                    <div class="input-group wizard-number">
                                        <input type="number" class="form-control" id="@fieldId" name="@fieldName" value="@value"
                                               min="0" step="any" inputmode="decimal" />
                                        @if (!string.IsNullOrEmpty(question.Unit))
                                        {
                                            <span class="input-group-text">@question.Unit</span>
                                        }
                                    </div>
                                }
                                else if (question.Kind == AttributeKind.Choice)
                                {
                                    <label class="form-label" for="@fieldId">@question.Label</label>
                                    <select class="form-select" id="@fieldId" name="@fieldName">
                                        <option value="">Velg …</option>
                                        @foreach (var option in (question.Options ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                        {
                                            <option value="@option" selected="@(option == value)">@option</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <label class="form-label" for="@fieldId">@question.Label</label>
                                    <input type="text" class="form-control" id="@fieldId" name="@fieldName" value="@value" maxlength="200" />
                                }
                            </div>
                        }
                    </div>
                }

                <div class="mt-3">
                    <label asp-for="Notes" class="form-label">Noe annet vi bør vite? (valgfritt)</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"
                              placeholder="F.eks. hvor nøklene ligger"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                @* "Når er den tilgjengelig?": Hele tiden, Faste tider (from-to, may go over midnight, chosen weekdays) or En bestemt periode.
                   Only the chosen option's fields are shown (CSS :has in site.css) and saved (EfResourceRepository.CopyAvailability) *@
                @{
                    (int Bit, string Short, string Long)[] weekDays = [(1, "Man", "mandag"), (2, "Tir", "tirsdag"), (4, "Ons", "onsdag"), (8, "Tor", "torsdag"), (16, "Fre", "fredag"), (32, "Lør", "lørdag"), (64, "Søn", "søndag")];
                    var pickedDays = Model.AvailableDayBits.Count > 0 ? Model.AvailableDayBits : new List<int> { 1, 2, 4, 8, 16 }; // new resource: Mon-Fri ticked
                }
                <fieldset class="wizard-availability mt-3">
                    <legend class="wizard-subtitle"><i class="ti ti-clock" aria-hidden="true"></i> Når er den tilgjengelig?</legend>
                    <span asp-validation-for="AvailableFromTime" class="text-danger d-block"></span>
                    <span asp-validation-for="AvailableDayBits" class="text-danger d-block"></span>
                    <span asp-validation-for="AvailableFromDate" class="text-danger d-block"></span>
                    <span asp-validation-for="AvailableToDate" class="text-danger d-block"></span>

                    <label class="availability-option">
                        <input type="radio" class="form-check-input" name="AvailabilityKind" value="Always" checked="@(Model.AvailabilityKind == AvailabilityKind.Always)" />
                        Hele tiden
                    </label>

                    <label class="availability-option">
                        <input type="radio" class="form-check-input" name="AvailabilityKind" value="Weekly" checked="@(Model.AvailabilityKind == AvailabilityKind.Weekly)" />
                        Faste tider
                    </label>
                    <div class="availability-detail">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <label for="availableFrom">Fra</label>
                            <input type="time" id="availableFrom" name="AvailableFromTime" class="form-control availability-time" value="@(Model.AvailableFromTime?.ToString("hh\\:mm"))" />
                            <label for="availableTo">til</label>
                            <input type="time" id="availableTo" name="AvailableToTime" class="form-control availability-time" value="@(Model.AvailableToTime?.ToString("hh\\:mm"))" />
                        </div>
                        <p class="small text-body-secondary mb-2"><i class="ti ti-moon" aria-hidden="true"></i> Er til-tiden før fra-tiden, går den over midnatt: 16:00 til 08:00 betyr til neste morgen.</p>
                        <div class="d-flex flex-wrap gap-1" role="group" aria-label="Ukedager">
                            @foreach (var day in weekDays)
                            {
                                <input type="checkbox" class="btn-check" name="AvailableDayBits" value="@day.Bit" id="day@(day.Bit)" checked="@(pickedDays.Contains(day.Bit))" />
                                <label class="btn btn-sm btn-outline-success availability-day" for="day@(day.Bit)" title="@day.Long">@day.Short</label>
                            }
                        </div>
                    </div>

                    <label class="availability-option">
                        <input type="radio" class="form-check-input" name="AvailabilityKind" value="Period" checked="@(Model.AvailabilityKind == AvailabilityKind.Period)" />
                        En bestemt periode <small class="text-body-secondary fw-normal">(f.eks. 20.–24. nov.)</small>
                    </label>
                    <div class="availability-detail">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <label for="availableFromDate">Fra</label>
                            <input type="date" id="availableFromDate" name="AvailableFromDate" class="form-control availability-date" value="@(Model.AvailableFromDate?.ToString("yyyy-MM-dd"))" />
                            <label for="availableToDate">til</label>
                            <input type="date" id="availableToDate" name="AvailableToDate" class="form-control availability-date" value="@(Model.AvailableToDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                </fieldset>

                @if (canSetStatus)
                {
                    <div class="mt-3">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" class="form-select" style="max-width: 360px;">
                            @foreach (var status in statuses)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    @* Keeps the current status when the owner saves (otherwise it would go back to "Ledig") *@
                    <input type="hidden" asp-for="Status" />
                }

                @* The old description is no longer shown, but kept when saving *@
                <input type="hidden" asp-for="Description" />
            </section>

            @* Step 3: where the resource is (location-picker.js). The address on one line, and a big map under it *@
            <section class="wizard-step" aria-labelledby="stepTitle3">
                <div class="wizard-step-head">
                    <span class="wizard-step-icon"><i class="ti ti-map-pin" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="stepTitle3" class="wizard-step-title" tabindex="-1">Hvor er ressursen?</h2>
                        <p class="wizard-help">Skriv adressen, bruk posisjonen din, eller klikk på kartet.</p>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="col-5 col-md-2">
                        <label asp-for="ZipCode" class="form-label"></label>
                        <input asp-for="ZipCode" class="form-control" inputmode="numeric" />
                        <span asp-validation-for="ZipCode" class="text-danger"></span>
                    </div>
                    <div class="col-7 col-md-4">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                </div>

                <div class="wizard-place-tools">
                    <button type="button" id="findOnMap" class="btn btn-outline-secondary"><i class="ti ti-search" aria-hidden="true"></i> Finn på kartet</button>
                    <button type="button" id="useMyLocation" class="btn btn-outline-secondary"><i class="ti ti-current-location" aria-hidden="true"></i> Bruk min posisjon</button>
                    <span class="wizard-place" data-place hidden><i class="ti ti-circle-check" aria-hidden="true"></i> <span data-place-name></span></span>
                </div>
                <span id="geoStatus" class="d-block text-body-secondary small mb-2" role="status" aria-live="polite"></span>

                <div id="pickMap" class="wizard-map"></div>

                <input type="hidden" asp-for="Latitude" />
                <input type="hidden" asp-for="Longitude" />
                <input type="hidden" asp-for="Municipality" />
                <span asp-validation-for="Latitude" class="text-danger d-block"></span>
                <span asp-validation-for="Longitude" class="text-danger d-block"></span>
            </section>

            @if (isEdit)
            {
                <input type="hidden" asp-for="Id" />
            }

            @* The buttons stay at the bottom of the window while the page scrolls (position: sticky in site.css) *@
            <div class="wizard-nav">
                <button type="button" class="btn btn-outline-secondary" data-wizard-back hidden><i class="ti ti-chevron-left" aria-hidden="true"></i> Tilbake</button>
                <span class="wizard-nav-count" data-step-count></span>
                <button type="button" class="btn btn-link wizard-more" data-more-hint hidden><i class="ti ti-chevrons-down" aria-hidden="true"></i> Rull ned for mer</button>
                <button type="button" class="button" data-wizard-next hidden>Neste <i class="ti ti-chevron-right" aria-hidden="true"></i></button>
                @if (isLoggedIn)
                {
                    <button type="submit" class="button" data-wizard-submit><i class="ti @(isEdit ? "ti-device-floppy" : "ti-check")" aria-hidden="true"></i> @(isEdit ? "Lagre" : "Opprett ressurs")</button>
                }
                else
                {
                    @* Not logged in: resource-veiviser.js saves the draft in the browser and goes to login *@
                    <button type="submit" class="button" data-wizard-submit><i class="ti ti-user-plus" aria-hidden="true"></i> Registrer deg og opprett</button>
                }
            </div>
        </div>

        @* "Din ressurs": what is chosen so far, always in the same place, like the order summary in a checkout.
           resource-veiviser.js fills it in. On phones it is one line at the top that folds out *@
        <aside class="wizard-summary" aria-label="Din ressurs">
            <details class="wizard-summary-box" open data-summary>
                <summary class="wizard-summary-title">Din ressurs<span class="wizard-summary-short" data-summary-short></span></summary>
                <div class="wizard-summary-picture">
                    <img data-summary-img alt="Bildet av ressursen" hidden
                         src="@(Model.HasImage ? Url.Action("Image", "Resource", new { id = Model.Id }) : null)" />
                    <i class="ti ti-photo" data-summary-icon aria-hidden="true"></i>
                </div>
                <ol class="wizard-summary-list">
                    @foreach (var (step, label) in stepLabels)
                    {
                        <li data-summary-step="@step">
                            <i class="ti ti-circle-dashed" data-summary-mark aria-hidden="true"></i>
                            <span class="wizard-summary-text"><span class="visually-hidden">@label: </span><span data-summary-text>@label</span></span>
                            <button type="button" class="btn btn-link btn-sm p-0" data-goto="@step" hidden>Endre<span class="visually-hidden"> @label.ToLower()</span></button>
                        </li>
                    }
                </ol>
            </details>
        </aside>
    </div>
</form>