@using Heimevernet_Prosjekt.Models.ViewModels.Resource
@model ResourceViewModel

@{
    ViewData["Title"] = "Endre Ressurs";
}

<div class="wizard">
    <h1>@ViewData["Title"]</h1>

    @* The whole form is in _ResourceVeiviser.cshtml (shared with Create) *@
    <partial name="_ResourceVeiviser" model="Model" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/location-picker.js" asp-append-version="true"></script>
    <script src="~/js/resource-veiviser.js" asp-append-version="true"></script>
}