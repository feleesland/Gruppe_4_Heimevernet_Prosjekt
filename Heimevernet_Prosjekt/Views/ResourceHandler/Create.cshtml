@using Heimevernet_Prosjekt.Models.ViewModels.Resource
@using Heimevernet_Prosjekt.Models.Entities
@model ResourceViewModel
@{
    ViewData["Title"] = "Ny Ressurs";

    // Show the form when nothing is saved yet. From the map, the model only has a position (no name),
    // so it is still a new form - not "Gratulerer"
    var showForm = Model == null || !ViewData.ModelState.IsValid || string.IsNullOrEmpty(Model.Name);
}


@if (showForm)
{
    <h1>Ny Ressurs</h1>

    <form asp-controller="ResourceHandler" asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label asp-for="Name"></label>
            <input class="form-control" asp-for="Name" />
            <span asp-validation-for="Name"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description"></label>
            <input class="form-control" asp-for="Description" />
            <span asp-validation-for="Description"></span>
        </div>

        @* Type is chosen from a fixed list (admin can add more), so the filter can find every resource *@
        @{
            var resourceTypes = ViewData["ResourceTypes"] as IEnumerable<ResourceType> ?? [];
            var currentType = Model?.Type;
            var hasOldType = !string.IsNullOrEmpty(currentType) && !resourceTypes.Any(t => t.Name == currentType);
        }
        <div class="mb-3">
            <label asp-for="Type"></label>
            <select class="form-control" asp-for="Type" data-type-select>
                <option value="">Velg type …</option>
                @foreach (var t in resourceTypes)
                {
                    <option value="@t.Name" data-examples="@t.Examples">@t.Name</option>
                }
                @if (hasOldType)
                {
                    <option value="@currentType">@currentType (gammel type – velg en ny)</option>
                }
            </select>
            <small id="typeExamples"></small>
            <span asp-validation-for="Type"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Notes"></label>
            <textarea class="form-control" asp-for="Notes" placeholder="F.eks. hvor nøklene ligger"></textarea>
            <span asp-validation-for="Notes"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Image"></label>
            <input class="form-control" asp-for="Image" type="file" accept="image/*" capture="environment" />
            <span asp-validation-for="Image"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Address"></label>
            <input class="form-control" asp-for="Address" />
        </div>
        <div class="mb-3">
            <label asp-for="ZipCode"></label>
            <input class="form-control" asp-for="ZipCode" />
        </div>
        <div class="mb-3">
            <label asp-for="City"></label>
            <input class="form-control" asp-for="City" />
        </div>
        <button class="button" type="button" id="findOnMap">Finn på kartet</button>
        <button class="button" type="button" id="useMyLocation">Bruk min posisjon</button>
        <span id="geoStatus"></span>
        <p>Du kan også klikke på kartet eller dra markøren.</p>
        <div id="pickMap" style="height: 300px;"></div>
        <input type="hidden" asp-for="Latitude" />
        <input type="hidden" asp-for="Longitude" />

        <button class="button" type="submit">Opprett</button>
    </form>
}
else
{
    <div>
        Du har opprettet en ny ressurs!
        <h1>@Model.Name</h1>
        Gratulerer du har opprettet en ny ressurs!
        <h1>@Model!.Name</h1>
        <p>@Model.Description</p>
        <p>Type: @Model.Type</p>
    </div>
}

@section Scripts {
    @if (showForm)
    {
        <script src="~/js/location-picker.js" asp-append-version="true"></script>
    }
}