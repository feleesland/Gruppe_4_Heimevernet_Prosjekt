@using Heimevernet_Prosjekt.Models.ViewModels.Resource
@model ResourceViewModel

@{
    ViewData["Title"] = "Ny ressurs";
}

<div class="wizard">
    <h1>@ViewData["Title"]</h1>
    <p class="text-secondary">Én ting om gangen. Bare type og navn må fylles ut.</p>

    @* The whole form is in _ResourceVeiviser.cshtml (shared with Edit) *@
    <partial name="_ResourceVeiviser" model="Model" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/location-picker.js" asp-append-version="true"></script>
    <script src="~/js/resource-veiviser.js" asp-append-version="true"></script>
}