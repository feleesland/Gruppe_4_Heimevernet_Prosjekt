@using Heimevernet_Prosjekt.Models.ViewModels.Account
@using Heimevernet_Prosjekt.Security.Authorization
@model EditProfileViewModel
@{
    ViewData["Title"] = "Rediger opplysninger";
}
<style>
    .home-panel {
        max-width: 720px;
        margin: 3rem auto;
        padding: 2rem;
        border-radius: 12px;
        background: rgba(var(--bs-body-bg-rgb), 0.88);
        color: var(--bs-body-color);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    .home-card {
        padding: 1.5rem;
        border-radius: 12px;
        background: rgba(var(--bs-body-bg-rgb), 0.88);
        color: var(--bs-body-color);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }
</style>

<section class="home-panel">
    <h1 class="h3">Rediger opplysninger</h1>

    <form asp-action="EditProfile" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
@if (!User.IsInRole(RoleNames.Admin))
{
    var isOp = User.IsInRole(RoleNames.Operator);

    <fieldset class="mb-3">
        <legend class="form-label fs-6">@(isOp ? "Etat / organisasjon" : "Jeg er")</legend>
        @foreach (var kind in ActorTypes.KindsFor(isOp))
        {
            var id = "kind-" + kind.Replace(" ", "");
            <div class="form-check">
                <input class="form-check-input" type="radio" name="ActorKind"
                       value="@kind" id="@id" @(Model.ActorKind == kind ? "checked" : "") />
                <label class="form-check-label" for="@id">@kind</label>
            </div>
        }
    </fieldset>

    @if (!isOp)
    {
        <fieldset class="mb-3">
            <legend class="form-label fs-6">Jeg kan også bidra som</legend>
            @foreach (var skill in ActorTypes.Skills)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SelectedSkills"
                           value="@skill" id="skill-@skill" @(Model.SelectedSkills.Contains(skill) ? "checked" : "") />
                    <label class="form-check-label" for="skill-@skill">@skill</label>
                </div>
            }
        </fieldset>
    }
}

        <div class="mb-3">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-success">Lagre</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Avbryt</a>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}