@using Heimevernet_Prosjekt.Models.Entities
@model ApplicationUser
@{
    ViewData["Title"] = "Min side";
}

<style>
    .home-panel {
        max-width: 720px;
        margin: 3rem auto;
        padding: 2rem;
        border-radius: 12px;
        background: rgba(var(--bs-body-bg-rgb), 0.88);
        color: var(--bs-body-color);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    .home-card {
        padding: 1.5rem;
        border-radius: 12px;
        background: rgba(var(--bs-body-bg-rgb), 0.88);
        color: var(--bs-body-color);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }
</style>

<section class="home-panel">
    <h1 class="h3">Min side</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    <dl class="row mb-4">
        <dt class="col-sm-4">Navn</dt>
        <dd class="col-sm-8">@Model.FirstName @Model.LastName</dd>

        <dt class="col-sm-4">E-post</dt>
        <dd class="col-sm-8">@Model.Email</dd>

        <dt class="col-sm-4">Telefon</dt>
        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Ikke oppgitt" : Model.PhoneNumber)</dd>

        <dt class="col-sm-4">Rolle</dt>
        <dd class="col-sm-8">@ViewData["Roles"]</dd>
    </dl>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="EditProfile" class="btn btn-success">Rediger profil</a>
        <a asp-controller="Resource" asp-action="List" asp-route-mine="true" class="btn btn-outline-success">Mine ressurser</a>
    </div>

    <hr class="my-4" />

    <div class="d-flex justify-content-between align-items-center">
        <small class="text-body-secondary">Sletting av konto kan ikke angres.</small>
        <a asp-action="DeleteProfile" class="btn btn-sm btn-outline-danger">Slett konto …</a>
    </div>
</section>