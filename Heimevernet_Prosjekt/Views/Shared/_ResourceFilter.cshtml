@* The resource filter, used in the side panel on Kart and on Ressursoversikt (logic in wwwroot/js/resource-filter.js) *@
@* No "Bruk" button: the result updates as soon as you choose *@
@{
    var onMap = ViewData["FilterOnMap"] as bool? == true;
    var canNeeds = ViewData["FilterCanNeeds"] as bool? == true;
}
<div id="rfPanel" data-types-url="@Url.Action("Types", "Resource")" data-on-map="@(onMap ? "true" : "false")">
    @if (onMap)
    {
        @* Only on Kart: what is drawn on the map. The rest of the filter is used on Ressursoversikt too *@
        <fieldset class="rf-map-only mb-3">
            <legend class="h6 mb-0">🗺️ Vis på kartet</legend>
            <div class="small text-body-secondary mb-2">Gjelder bare kartet</div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="rfShowResources" checked />
                <label class="form-check-label d-flex w-100" for="rfShowResources">📦 Ressurser<span id="rfResourcesCount" class="ms-auto text-body-secondary"></span></label>
            </div>
            @if (canNeeds)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rfShowNeeds" checked />
                    <label class="form-check-label d-flex w-100" for="rfShowNeeds">🟥 Behov<span id="rfNeedsCount" class="ms-auto text-body-secondary"></span></label>
                </div>
            }
        </fieldset>
        <h2 class="h6 mb-0">Filtrer ressurser</h2>
        <div class="small text-body-secondary mb-3">Gjelder både kartet og Ressursoversikt</div>
    }
    <fieldset class="mb-4 rf-resource-only">
        <legend class="h6">Type ressurs</legend>
        <div id="rfTypes" class="small text-body-secondary">Henter typer …</div>
    </fieldset>

    <fieldset class="mb-4 rf-resource-only">
        <legend class="h6">Status</legend>
        <div id="rfStatus"></div>
    </fieldset>

    <fieldset class="mb-4">
        <legend class="h6">Avstand</legend>
        <label for="rfRadius" class="form-label small">Innen</label>
        <select id="rfRadius" class="form-select mb-2">
            <option value="0.5">500 m</option>
            <option value="1">1 km</option>
            <option value="2" selected>2 km</option>
            <option value="5">5 km</option>
            <option value="10">10 km</option>
        </select>
        <div id="rfPlace" class="small mb-2">Velg et sted i søket for å bruke avstand.</div>
        @if (onMap)
        {
            <button type="button" id="rfPick" class="btn btn-sm btn-outline-secondary w-100">📍 Velg punkt på kartet</button>
        }
    </fieldset>

    <div class="d-flex gap-2 border-top pt-3">
        <button type="button" id="rfReset" class="btn btn-outline-secondary">Nullstill alt</button>
        @if (onMap)
        {
            <button type="button" id="rfShow" class="btn btn-success ms-auto">Vis treff</button>
        }
    </div>
</div>