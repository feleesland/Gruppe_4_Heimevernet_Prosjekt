@using Microsoft.AspNetCore.Identity
@using Heimevernet_Prosjekt.Models.Authorization
@using Heimevernet_Prosjekt.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Heimevernet_Prosjekt</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Heimevernet_Prosjekt.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />   <!-- Her er linje 1 fra Leaflet_Lab.pdf hostet versjon limt inn -->
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Heimevernet_Prosjekt</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Hjem</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Map">Kart</a>    <!-- Map has been added to the navigationbar -->
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Resource" asp-action="List">Resources</a>
                        </li>
                        @if (User.IsInRole(RoleNames.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Index">Brukere</a>
                            </li>
                        }
                    </ul>
                    @* Search in the menu on every page. Logged in: Hva?, Hvor? and radius, goes to Ressurser or filters the map on Kart. *@
                    @* Not logged in: searches the information on the homepage. Logic for both is in wwwroot/js/site.js *@
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <form id="globalSearchForm" asp-controller="Resource" asp-action="List" method="get" class="d-flex flex-wrap align-items-center gap-2 mx-sm-3 my-2 my-sm-0">
                            <input id="globalSearchWhat" name="search" value="@Context.Request.Query["search"]" class="form-control form-control-sm" style="width: 170px;" placeholder="Hva? (navn, type ...)" />
                            <input id="globalSearchWhere" name="where" value="@Context.Request.Query["where"]" class="form-control form-control-sm" style="width: 170px;" placeholder="Hvor? (adresse, sted)" />
                            <select id="globalSearchRadius" name="radius" class="form-select form-select-sm" style="width: auto;" title="Radius rundt stedet">
                                @foreach (var km in new[] { 1, 5, 10, 25, 50 })
                                {
                                    var chosen = Context.Request.Query["radius"].ToString();
                                    <option value="@km" selected="@(chosen == km.ToString() || (chosen == "" && km == 5))">@km km</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm">Søk</button>
                            <button type="button" id="globalSearchReset" class="btn btn-secondary btn-sm">Nullstill</button>
                            <span id="globalSearchStatus" class="small"></span>
                        </form>
                    }
                    else
                    {
                        <form id="infoSearchForm" asp-controller="Home" asp-action="Index" method="get" class="d-flex flex-wrap align-items-center gap-2 mx-sm-3 my-2 my-sm-0">
                            <input id="infoSearchText" name="q" value="@Context.Request.Query["q"]" class="form-control form-control-sm" style="width: 220px;" placeholder="Søk i informasjon ..." />
                            <button type="submit" class="btn btn-primary btn-sm">Søk</button>
                            <span id="infoSearchStatus" class="small"></span>
                        </form>
                    }
                    <!-- Login/logout on the right side - Docs: Dependency injection into views (SignInManager) -->
                    <!-- https://learn.microsoft.com/aspnet/core/mvc/views/dependency-injection -->
                    <ul class="navbar-nav">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            // Show first and last name; fall back to email for users without a name
                            var currentUser = await UserManager.GetUserAsync(User);
                            var displayName = $"{currentUser?.FirstName} {currentUser?.LastName}".Trim();

                            <li class="nav-item">
                                <span class="nav-link text-dark text-end lh-sm">
                                    @(string.IsNullOrEmpty(displayName) ? User.Identity?.Name : displayName)<br />
                                    <small class="text-muted">
                                        @RoleNames.DisplayName(
                                            User.IsInRole(RoleNames.Admin) ? RoleNames.Admin
                                            : User.IsInRole(RoleNames.Operator) ? RoleNames.Operator
                                            : User.IsInRole(RoleNames.Partner) ? RoleNames.Partner
                                            : RoleNames.User)
                                    </small>
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link text-dark">Logg ut</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Logg inn</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Registrer</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Heimevernet_Prosjekt - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script> <!-- Her er linje 2 fra Leaflet_Lab.pdf hostet versjon limt inn -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>