@using Microsoft.AspNetCore.Identity
@using Heimevernet_Prosjekt.Security.Authorization
@using Heimevernet_Prosjekt.Models.Entities
@using Heimevernet_Prosjekt.DataAccess
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Heimevernet_Prosjekt.DataAccess.IResourceReportRepository ReportRepository
@inject Heimevernet_Prosjekt.DataAccess.IResourceRequestRepository RequestRepository

<!DOCTYPE html>
<html lang="en">
<head>
        <meta charset="utf-8" />
      
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Heimevernet</title>

  @* Tabler icons, used in the filter and in "Ny ressurs" - Docs: https://tabler.io/docs/icons/webfont *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@3/dist/tabler-icons.min.css" />

    @* Light or dark mode: set before the page is drawn, so it doesn't flash. The choice is remembered;
       the first time it follows the computer's setting - Docs: Bootstrap Color modes
       https://getbootstrap.com/docs/5.3/customize/color-modes/ *@
    @* The site has its own dark mode, so dark-mode extensions (e.g. Dark Reader) leave it alone *@
    <meta name="color-scheme" content="light dark" />
    <meta name="darkreader-lock" />
    <script>
        (function () {
            var theme = null;
            try { theme = localStorage.getItem('theme'); } catch (e) { }
            if (theme !== 'light' && theme !== 'dark') {
                theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Heimevernet_Prosjekt.styles.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xl navbar-toggleable-xl navbar-light border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img width="40.4" height="50" src="/logo.svg"></img>
                </a>
                <a class="navbar-brand text-white d-none d-md-inline"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">Ressurs Varden</a>

                <!-- Open or close the menu on small screens. -->
                <button class="navbar-toggler order-1 ms-2"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Åpne eller lukk meny">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavigation"
                     class="navbar-collapse collapse d-xl-inline-flex justify-content-between order-last order-xl-0">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">Hjem</a>
                        </li>
                        @* The operator's main page - only operator and admin *@
                        @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Operator))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-area=""
                                   asp-controller="ResourceNeed"
                                   asp-action="Overview">Oversikt</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Map">Kart</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                         {
                        <li class="nav-item">
                            @* The controller checks which resources the user can see. *@
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-controller="Resource"
                               asp-action="List">Ressursoversikt</a>
                        </li>
                         }
                @if (User.Identity?.IsAuthenticated != true)
                {
                    @* Not logged in: register a resource straight away, and log in at the end (the draft is kept) *@
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="ResourceHandler" asp-action="Create">Opprett ressurs</a>
                    </li>
                }

                    @* Behov is only for admin and operator (public actors), like in the case *@
                        @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Operator))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="ResourceNeed" asp-action="List">Behov</a>
                            </li>
                        }
                    </ul>
                                    </div>

                    @* Search in the menu on every page, like YouTube: one field with 🔍 and ✕, suggestions while typing (logic in wwwroot/js/site.js). *@
                    @* Logged in: resources + places from Kartverket. Not logged in: the information on the homepage. Icons from Bootstrap Icons (MIT) *@
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <form id="globalSearchForm" asp-controller="Resource" asp-action="List" method="get" role="search" autocomplete="off"
                              data-suggest-url="@Url.Action("Index", "Suggestions")" data-map-url="@Url.Action("Map", "Home")" data-detail-url="@Url.Content("~/Resource/Index/")"
                              class="nav-search d-flex flex-grow-1 justify-content-center align-items-center gap-2 mx-2 mx-xl-3">
                            <div class="search-box">
                                <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" /></svg>
                                <input id="globalSearchWhat" name="search" value="@Context.Request.Query["search"]" class="form-control rounded-pill" placeholder="Søk etter ressurs eller sted ..." aria-label="Søk etter ressurs eller sted" />
                                <button type="button" id="globalSearchClear" class="search-clear d-none" aria-label="Tøm søket">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z" /></svg>
                                </button>
                                <div id="globalSearchSuggestions" class="search-suggestions d-none"></div>
                            </div>

                            <span id="globalSearchStatus" class="small text-nowrap text-white d-none d-xl-inline"></span>
                        </form>
                    }
                    else
                    {
                        <form id="infoSearchForm" asp-controller="Home" asp-action="Index" method="get" role="search" autocomplete="off"
                              class="nav-search d-flex flex-grow-1 justify-content-center align-items-center gap-2 mx-2 mx-xl-3">
                            <div class="search-box">
                                <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" /></svg>
                                <input id="infoSearchText" name="q" value="@Context.Request.Query["q"]" class="form-control rounded-pill" placeholder="Søk i informasjon ..." aria-label="Søk i informasjon" />
                                <button type="button" id="infoSearchClear" class="search-clear d-none" aria-label="Tøm søket">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z" /></svg>
                                </button>
                            </div>
                            <span id="infoSearchStatus" class="small text-nowrap text-white d-none d-xl-inline"></span>
                        </form>
                    }

                    @* Show account controls based on login status. *@
                    <ul class="navbar-nav account-nav flex-row align-items-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            // Show first and last name; fall back to email for users without a name
                            var currentUser = await UserManager.GetUserAsync(User);
                            var displayName = $"{currentUser?.FirstName} {currentUser?.LastName}".Trim();

                            // bell for everyone: requests waiting for my answer, and (admin) open messages from operators
                            var nowUtc = DateTime.UtcNow;
                            var myRequests = currentUser == null
                                ? new List<OwnerRequest>()
                                : RequestRepository.GetForOwner(currentUser.Id).Where(r => r.IsOpen(nowUtc)).ToList();
                            var isAdmin = User.IsInRole(RoleNames.Admin);
                            var openCount = myRequests.Count + (isAdmin ? ReportRepository.CountOpen() : 0);
                            var oslo = TimeZoneInfo.FindSystemTimeZoneById("Europe/Oslo");

                            @* The bell and its list - Docs: Bootstrap Dropdowns. Number + text, not only color *@
                            <li class="nav-item dropdown">
                                <button type="button" class="nav-link text-white btn btn-link position-relative"
                                        data-bs-toggle="dropdown" aria-expanded="false"
                                        aria-label="@(openCount == 0 ? "Ingen nye varsler" : openCount + (openCount == 1 ? " nytt varsel" : " nye varsler"))">
                                    <img width="25px" src="/bell.svg" />
                                    @if (openCount > 0)
                                    {
                                        <span class="badge rounded-pill bg-danger">@openCount</span>
                                    }
                                </button>
                                <div class="dropdown-menu dropdown-menu-end notification-panel p-0">
                                    <div class="px-3 py-2 border-bottom fw-semibold">Varsler</div>
                                    @if (openCount == 0)
                                    {
                                        <div class="px-3 py-2 small">Ingen nye varsler.</div>
                                    }

                                    @* Requests for my resources *@
                                    @foreach (var r in myRequests.Take(5))
                                    {
                                        <a class="dropdown-item notification-item border-bottom py-2"
                                           asp-controller="ResourceRequest" asp-action="Mine">
                                            <div class="fw-semibold">@(r.Urgency == NeedUrgency.Akutt ? "⏰" : "📅") @r.ResourceName trengs</div>
                                            <div class="small">@r.NeedName</div>
                                            <div class="small opacity-75">Svar innen @TimeZoneInfo.ConvertTimeFromUtc(r.AnswerBy, oslo).ToString("dd.MM HH:mm")</div>
                                        </a>
                                    }

                                    @* Admin: open messages from operators (as before) *@
                                    @if (isAdmin)
                                    {
                                        foreach (var n in ReportRepository.GetOpenNotifications())
                                        {
                                            var minutes = (nowUtc - n.CreatedAt).TotalMinutes;
                                            var ago = minutes < 1 ? "nå nettopp"
                                                : minutes < 60 ? $"{(int)minutes} min siden"
                                                : minutes < 1440 ? $"{(int)(minutes / 60)} t siden"
                                                : TimeZoneInfo.ConvertTimeFromUtc(n.CreatedAt, oslo).ToString("dd.MM.yyyy");

                                            <a class="dropdown-item notification-item border-bottom py-2"
                                               asp-controller="Resource" asp-action="Index" asp-route-id="@n.ResourceId">
                                                <div class="fw-semibold">⚑ Nytt varsel · @n.ReporterEmail</div>
                                                <div class="small">«@n.Message» – @n.ResourceName</div>
                                                <div class="small opacity-75">@ago</div>
                                            </a>
                                        }
                                    }

                                    <a class="dropdown-item small py-2" asp-controller="ResourceRequest" asp-action="Mine">Alle mine forespørsler</a>
                                                                @if (User.IsInRole(RoleNames.Admin))
                            {
                                <a class="dropdown-item" asp-controller="ResourceReport" asp-action="Index">⚑ Alle varsler</a>
                            }
                                </div>
                            </li>

                            @* Account menu like YouTube: initials, then settings and Logg ut - Docs: Bootstrap Dropdowns *@
                            var shownName = string.IsNullOrEmpty(displayName) ? User.Identity?.Name ?? "" : displayName;
                            var initials = string.Concat(shownName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
                            var roleName = RoleNames.DisplayName(
                                User.IsInRole(RoleNames.Admin) ? RoleNames.Admin
                                : User.IsInRole(RoleNames.Operator) ? RoleNames.Operator
                                : User.IsInRole(RoleNames.Partner) ? RoleNames.Partner
                                : RoleNames.User);
                            <li class="nav-item dropdown ms-2">
                                <button type="button" class="btn btn-link nav-link p-0" data-bs-toggle="dropdown" aria-expanded="false"
                                        aria-label="Kontomeny for @shownName">
                                    <span class="account-avatar">@(initials.Length > 0 ? initials : "?")</span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end account-menu">
                                    <div class="px-3 py-2">
                                        <div class="fw-semibold">@shownName</div>
                                        <div class="small text-body-secondary">@currentUser?.Email · @roleName</div>
                                    </div>
                                    <div class="dropdown-divider"></div>
                                                                <a class="dropdown-item" asp-controller="MinSide" asp-action="Index">👤 Min side</a>
                                    <a class="dropdown-item" asp-controller="Resource" asp-action="List" asp-route-mine="true">📦 Mine ressurser</a>
                                    <a class="dropdown-item" asp-controller="ResourceRequest" asp-action="Mine">🔔 Mine forespørsler</a>
                                     @if (isAdmin)
                                     {
                                         <a class="dropdown-item" asp-controller="ResourceReport" asp-action="Index">⚑ Alle varsler</a>
                                     }
                                                                        @* Innstillinger: only for the look for now, the page isn't made yet *@
                                    <button type="button" class="dropdown-item">⚙️ Innstillinger</button>
                                    <partial name="_DisplaySettings" />
                                    <div class="dropdown-divider"></div>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item">↪ Logg ut</button>
                                    </form>
                                </div>
                            </li>
                        }
                        else
                        {
                            @* Not signed in: appearance and map in a small ⚙ menu *@
                            <li class="nav-item dropdown">
                                <button type="button" class="nav-link text-white btn btn-link" data-bs-toggle="dropdown"
                                        aria-expanded="false" aria-label="Innstillinger for visning">⚙</button>
                                <div class="dropdown-menu dropdown-menu-end account-menu">
                                    <partial name="_DisplaySettings" />
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Account"
                                   asp-action="Login">Logg inn</a>
                            </li>
                            <li class="nav-item d-none d-md-block">
                                <a class="nav-link text-white"
                                   asp-controller="Account"
                                   asp-action="Register">Registrer</a>
                            </li>
                        }
                    </ul>
            </div>
        </nav>
    </header>

        <div class="page-width">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 UiA Gruppe 4 - Heimevernet_Prosjekt -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">Personvern</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
                <script src="~/js/map-style.js" asp-append-version="true"></script>

    <script>
        // Appearance and map choice in the account menu; saved in the browser (help with AI)
        // Docs: Bootstrap Color modes - https://getbootstrap.com/docs/5.3/customize/color-modes/
        (function () {
            var root = document.documentElement;
            function get(key, fallback) { try { return localStorage.getItem(key) || fallback; } catch (e) { return fallback; } }
            function set(key, value) { try { localStorage.setItem(key, value); } catch (e) { } }

            function applyTheme(choice) {
                var theme = choice === 'auto'
                    ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                    : choice;
                root.setAttribute('data-bs-theme', theme);
            }

            // ✓ on the chosen ones
            function mark() {
                document.querySelectorAll('[data-theme-choice]').forEach(function (b) {
                    b.classList.toggle('active', b.dataset.themeChoice === get('theme', 'auto'));
                });
                document.querySelectorAll('[data-map-choice]').forEach(function (b) {
                    b.classList.toggle('active', b.dataset.mapChoice === get('mapStyle', 'topo'));
                });
            }

            document.querySelectorAll('[data-theme-choice]').forEach(function (b) {
                b.addEventListener('click', function () {
                    set('theme', b.dataset.themeChoice);
                    applyTheme(b.dataset.themeChoice);
                    mark();
                });
            });

            // The map page listens for this and changes its pictures right away
            document.querySelectorAll('[data-map-choice]').forEach(function (b) {
                b.addEventListener('click', function () {
                    set('mapStyle', b.dataset.mapChoice);
                    window.dispatchEvent(new CustomEvent('mapstylechange', { detail: b.dataset.mapChoice }));
                    mark();
                });
            });

            mark();
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>