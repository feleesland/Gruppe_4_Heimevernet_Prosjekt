@using Microsoft.AspNetCore.Identity
@using Heimevernet_Prosjekt.Models.Authorization
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Heimevernet_Prosjekt</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Heimevernet_Prosjekt.styles.css" asp-append-version="true" />

    <!-- Load the map stylesheet. -->
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">Heimevernet_Prosjekt</a>

                <!-- Open or close the menu on small screens. -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Åpne eller lukk meny">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- This ID connects the menu to the button above. -->
                <div id="mainNavigation"
                     class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">Hjem</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Map">Kart</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            @* The controller checks which resources the user can see. *@
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Resource"
                               asp-action="List">Ressursoversikt</a>
                        </li>

                        @* Show the user management link to administrators. *@
                        @if (User.IsInRole(RoleNames.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Admin"
                                   asp-action="Index">Brukere</a>
                            </li>
                        }
                    </ul>

                    @* Show account controls based on login status. *@
                    <ul class="navbar-nav">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                @* Display the user's name and role. *@
                                <span class="nav-link text-dark text-end lh-sm">
                                    @User.Identity?.Name<br />
                                    <small class="text-muted">
                                        @RoleNames.DisplayName(
                                            User.IsInRole(RoleNames.Admin) ? RoleNames.Admin
                                            : User.IsInRole(RoleNames.Operator) ? RoleNames.Operator
                                            : User.IsInRole(RoleNames.Partner) ? RoleNames.Partner
                                            : RoleNames.User)
                                    </small>
                                </span>
                            </li>
                            <li class="nav-item">
                                @* Submit logout as a POST request. *@
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">
                                    <button type="submit"
                                            class="nav-link btn btn-link text-dark">
                                        Logg ut
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Login">Logg inn</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Register">Registrer</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Display the content of the current page. -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Heimevernet_Prosjekt -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Load the map library. -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>