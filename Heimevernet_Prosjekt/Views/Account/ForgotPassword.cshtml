@model Heimevernet_Prosjekt.Models.ViewModels.Account.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Glemt passord";
}

<h1>@ViewData["Title"]</h1>
<p>Skriv inn din email og hvis kontoen eksisterer, vil du få en email med reset lenke.</p>
<form asp-action="ForgotPassword" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <button type="submit" class="button">Send reset lenke</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}