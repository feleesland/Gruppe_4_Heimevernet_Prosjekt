@model Heimevernet_Prosjekt.Models.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Logg inn";
}

@* A card in the middle of the screen (.auth-box in site.css). returnUrl follows along, so the user comes back to "Ny ressurs" *@
<div class="auth-box">
    <h1>@ViewData["Title"]</h1>
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">@TempData["Message"]</div>
    }
    else if (Model.ReturnUrl?.Contains("ResourceHandler/Create", StringComparison.OrdinalIgnoreCase) == true)
    {
        <div class="alert alert-info">Logg inn for å opprette ressursen. Det du har fylt inn er tatt vare på.</div>
    }
    <form asp-action="Login" method="post">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>
        <button type="submit" class="button">Logg inn</button>
    </form>

    <p class="mt-3"><a asp-action="ForgotPassword">Glemt passord?</a></p>
    <p class="text-center mb-2">Ny bruker?</p>
    <a class="btn btn-outline-secondary w-100" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Registrer deg</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}