@{
    ViewData["Title"] = "Sjekk e-posten din";
}

<!-- "Check your email" after registering - Docs: Account confirmation and password recovery -->
<!-- https://learn.microsoft.com/aspnet/core/security/authentication/accconfirm -->
<h1>@ViewData["Title"]</h1>
<p>
    Vi har sendt deg en e-post. Klikk på lenken i e-posten for å bekrefte kontoen din, og logg så inn.
</p>
<a asp-action="Login" class="button">Til innlogging</a>