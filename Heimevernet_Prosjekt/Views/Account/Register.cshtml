@model Heimevernet_Prosjekt.Models.ViewModels.Account.RegisterViewModel

@{
    ViewData["Title"] = "Registrer deg";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

@* A card in the middle of the screen (.auth-box in site.css). returnUrl follows along through the email link, so the user comes back to "Ny ressurs" *@
<div class="auth-box">
    <h1>@ViewData["Title"]</h1>
    @if (returnUrl?.Contains("ResourceHandler/Create", StringComparison.OrdinalIgnoreCase) == true)
    {
        <div class="alert alert-info">Lag en konto for å opprette ressursen. Det du har fylt inn er tatt vare på.</div>
    }
    <form asp-action="Register" method="post">
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        @* Phone number on the account, shown on every resource the user registers *@
        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control" type="tel" autocomplete="tel" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="button">Registrer deg</button>
    </form>

    <p class="text-center mt-3 mb-2">Har du allerede en konto?</p>
    <a class="btn btn-outline-secondary w-100" asp-action="Login" asp-route-returnUrl="@returnUrl">Logg inn</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}